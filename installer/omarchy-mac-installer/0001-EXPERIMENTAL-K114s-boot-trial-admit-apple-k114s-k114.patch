+@contextlib.contextmanager
+def _oled_multitouch_machines():
+    """Also collect multitouch firmware from FUD machines named k* (K114/K116).
+
+    asahi_firmware v0.9.2's MultitouchFWCollection.load reads only machine
+    directories starting with "j", so an OLED MacBook Pro got no
+    apple/tpmtfw-k1xxx.bin. aurora-silicon/aurora-installer's
+    asahi_firmware/multitouch.py takes ("j", "k"); this does the same for the
+    k* directories after the original pass, converting them unchanged.
+    """
+    multitouch = getattr(asahi_firmware, "multitouch", None)
+    collection = getattr(multitouch, "MultitouchFWCollection", None)
+    if collection is None:
+        yield
+        return
+    original = collection.load
+
+    def load(self, source_path):
+        original(self, source_path)
+        if not os.path.exists(source_path):
+            return
+        for fname in sorted(os.listdir(source_path)):
+            if fname.startswith("k"):
+                self.do_machine(fname, os.path.join(source_path, fname))
+
+    collection.load = load
+    try:
+        yield
+    finally:
+        collection.load = original
+
+
 def _is_encrypted(path):
     with open(path, "rb") as fd:
         return fd.read(len(AEA_MAGIC)) == AEA_MAGIC
