+# A subscription is the login plus, for Claude, the organization it belongs
+# to: one claude.ai user can hold several organizations, each with its own
+# limits and billing. Registries written before the organization was recorded
+# have no orgId, and those keep matching on the user alone so an existing
+# login is never orphaned.
+def same_account(left: dict[str, Any], right: dict[str, Any]) -> bool:
+  if str(left.get("accountId") or "") != str(right.get("accountId") or ""):
+    return False
+  left_org = str(left.get("orgId") or "")
+  right_org = str(right.get("orgId") or "")
+  return not left_org or not right_org or left_org == right_org
+
+
