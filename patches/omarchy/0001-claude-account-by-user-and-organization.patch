+# An export written before organizations were recorded has no top-level
+# orgId, but its Claude .claude.json still carries the organizationUuid. Read
+# it from there so an older bundle is compared by subscription too. A bundle
+# that names two different organizations is refused before any file is
+# written.
+def entry_org(provider: str, entry: dict[str, Any]) -> str:
+  org = str(entry.get("orgId") or "")
+  if provider != "claude":
+    return org
+  files = entry.get("files")
+  account = files.get(".claude.json") if isinstance(files, dict) else None
+  oauth = account.get("oauthAccount") if isinstance(account, dict) else None
+  embedded = str(oauth.get("organizationUuid") or "") if isinstance(oauth, dict) else ""
+  if org and embedded and org != embedded:
+    raise accounts.AccountError("Conflicting account transfer organization")
+  return org or embedded
+
+
+def entry_identity(provider: str, entry: dict[str, Any]) -> dict[str, str]:
+  return {"accountId": str(entry.get("accountId") or ""), "orgId": entry_org(provider, entry)}
+
+
+# The receiver may run against the destination's older account backend, which
+# has no same_account(). Keep the comparison here so a copy does not depend on
+# the backend version.
+def same_identity(left: dict[str, Any], right: dict[str, Any]) -> bool:
+  if str(left.get("accountId") or "") != str(right.get("accountId") or ""):
+    return False
+  left_org = str(left.get("orgId") or "")
+  right_org = str(right.get("orgId") or "")
+  return not left_org or not right_org or left_org == right_org
+
