# K114s r3 configuration delta: what the next kernel turns on that the running one lacks.
#
# Base: the configuration of the running kernel 7.3.0-17.v272-4-ARCH (K114S-R1), which is
# betizzel/omarchy-m5's linux-aurora-j714s "config" (v272-4) after olddefconfig. That
# base is an arm64 defconfig with the Apple drivers added, not a distribution
# configuration, so much of what Arch Linux ARM builds as modules is absent.
#
# Use (details in docs/r3-config.md):
#   scripts/kconfig/merge_config.sh -m -O "$O" "$O/.config" k114s-r3.config
#   make O="$O" olddefconfig          (with the pinned toolchain: LLVM=1, Rust, bindgen)
#   build/validate-config.py "$O/.config" k114s-required.config k114s-r3.config
#
# Rules this file keeps:
#   - Additions are modules wherever Kconfig allows it. The kernel image sits on the EFI
#     partition, which is nearly full; modules live on the root file system.
#   - No option here changes scheduling, preemption, timer frequency, page size, security
#     policy or what is built in for boot.
#   - Every symbol exists in aurora-silicon/linux at a34d26c2 (the base), with the J714s
#     series applied (the running source), and at b9ac02af (upstream, 2026-11-14): the three
#     trees define the same 22,098 symbols.
#   - Each option, or each run of options under one comment, says why it is here.
#
# Evidence labels:
#   [observed]   the running kernel logged this failure on this K114s on 2026-11-14
#                (agent-run: journalctl, systemctl, sysctl, /proc)
#   [installed]  a package installed on this machine uses it, but no failure was logged
#   [peripheral] hardware commonly plugged into a laptop; not tested here
#   [common]     needed by software commonly added to an Omarchy install; not tested here
# Nothing in this file has run on the Mac. It was resolved with the kernel's own Kconfig
# (agent-run, see the document); it has not been built or booted.

# ============================================================================================
# 1. Bluetooth profiles
# ============================================================================================
# [observed] bluetoothd: "RFCOMM server failed for Hands-Free Voice gateway: socket(STREAM,
# RFCOMM): Protocol not supported". RFCOMM carries the hands-free and headset control
# channel, serial port profile and OBEX file transfer.
CONFIG_BT_RFCOMM=m
# [observed] /dev/rfcomm* devices on top of it (serial adapters, GPS receivers, modems).
CONFIG_BT_RFCOMM_TTY=y
# [observed] bluetoothd: "bnep_init() kernel lacks bnep-protocol support". BNEP is
# Bluetooth network access (phone tethering over Bluetooth).
CONFIG_BT_BNEP=m
# [observed] Multicast and protocol filtering inside the bnep module, as Arch builds it.
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# ============================================================================================
# 2. Firewall: ufw's IPv6 rules
# ============================================================================================
# [observed] ufw.service fails: "Extension hl revision 0 not supported, missing kernel
# module?". /etc/ufw/before6.rules matches the hop limit 22 times (neighbour discovery).
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_IP6_NF_MATCH_HL=m
# [observed] Same failure for "rt": before6.rules drops type 0 routing headers 3 times.
CONFIG_IP6_NF_MATCH_RT=m
# [installed] The remaining IPv6 header matches ufw and hand-written ip6tables rules can
# name: fragment, extension header list, hop-by-hop and destination options, AH, mobility
# header, EUI-64 address check, reverse path filter.
CONFIG_IP6_NF_MATCH_FRAG=m
CONFIG_IP6_NF_MATCH_IPV6HEADER=m
CONFIG_IP6_NF_MATCH_OPTS=m
CONFIG_IP6_NF_MATCH_AH=m
CONFIG_IP6_NF_MATCH_MH=m
CONFIG_IP6_NF_MATCH_EUI64=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
# [installed] Their IPv4 counterparts: TTL, AH, ECN, reverse path filter.
CONFIG_IP_NF_MATCH_TTL=m
CONFIG_IP_NF_MATCH_AH=m
CONFIG_IP_NF_MATCH_ECN=m
CONFIG_NETFILTER_XT_MATCH_ECN=m
CONFIG_IP_NF_MATCH_RPFILTER=m

# ============================================================================================
# 3. Policy routing and packet marks: Tailscale
# ============================================================================================
# [observed] tailscaled: "error querying IP rules (does kernel have IP_MULTIPLE_TABLES?):
# operation not supported". Policy routing ("ip rule") for IPv4.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
# [observed] tailscaled: "disabling tunneled IPv6 ... kernel doesn't support IPv6 policy
# routing". The same for IPv6.
CONFIG_IPV6_MULTIPLE_TABLES=y
# [common] Source-address routing tables, used with the rules above on multi-homed hosts.
CONFIG_IPV6_SUBTREES=y
# [observed] tailscaled: "failed to add connmark rules ... Extension CONNMARK revision 0
# not supported" and "unknown option --nfmask". Connection marks.
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
# [observed] Packet marks: the base builds xt_mark but leaves both of its front ends off.
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
# [observed] tailscaled: "-m mark --mark 0x40000/0xff0000 -j MASQUERADE ... RULE_APPEND
# failed". Also what Docker's default bridge network and connection sharing use.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
# [installed] SNAT and DNAT (Docker published ports), port redirect.
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
# [installed] Clamp the TCP MSS to the path MTU on tunnels (Tailscale subnet routes, VPNs).
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_TCPMSS=m

# ============================================================================================
# 4. Network defaults Omarchy sets
# ============================================================================================
# [observed] systemd-sysctl: "Couldn't write 'bbr' to 'net/ipv4/tcp_congestion_control'":
# /etc/sysctl.d/99-omarchy-sysctl.conf asks for BBR and gets cubic.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
# [observed] Opening that menu would also build BIC, H-TCP and Westwood by default and
# offer a new compiled-in default. Keep it to BBR, and keep cubic as the default: Omarchy
# switches to BBR at run time.
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
CONFIG_DEFAULT_CUBIC=y
# [observed] systemd-sysctl: "Couldn't write 'fq' to 'net/core/default_qdisc'": the same
# file asks for fq and gets pfifo_fast.
CONFIG_NET_SCH_FQ=m
# [observed] systemd's own default (fq_codel in 50-default.conf) is missing as well.
CONFIG_NET_SCH_FQ_CODEL=m
# [common] CAKE, the shaper used for smart queue management on slow uplinks.
CONFIG_NET_SCH_CAKE=m

# ============================================================================================
# 5. Docker and containers
# ============================================================================================
# docker, docker-buildx, docker-compose and ufw-docker are installed and docker.socket is
# enabled. /usr/bin/iptables is iptables-nft, so Docker needs the xt extensions of section
# 3 and the items below; the legacy ip_tables tables are deliberately left out.
# [installed] Docker deletes stale connection tracking entries through netlink.
CONFIG_NF_CT_NETLINK=m
# [installed] Docker's nftables backend and its checker (moby contrib/check-config.sh).
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_FWD_NETDEV=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_REDIR=m
# [installed] Sets with hashed keys, connection limits, quotas, socket and transparent
# proxy matching, userspace queue: the nftables expressions firewalls reach for next.
CONFIG_NFT_HASH=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_QUEUE=m
# [installed] FTP and TFTP through NAT (moby check-config, optional list); NetBIOS name
# replies so Samba browsing works through the firewall.
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_CONNTRACK_NETBIOS_NS=m
# [installed] The base builds ip_vs with no protocol and no scheduler. These make it
# usable for Docker swarm services (moby check-config, optional list).
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=m
# [installed] Docker network drivers: overlay (VXLAN), and dummy for macvlan tests.
# ipvlan is left out: it cannot be built without its "l3s" mode, which builds the L3
# master device hooks (NET_L3_MASTER_DEV) into the core IP paths. macvlan is in the base.
CONFIG_VXLAN=m
CONFIG_DUMMY=m
# [installed] CPU limits: "docker run --cpus" and systemd's CPUQuota= need CFS bandwidth.
CONFIG_CFS_BANDWIDTH=y
# [installed] I/O limits: "docker run --device-read-bps" and systemd's IOReadBandwidthMax=.
CONFIG_BLK_DEV_THROTTLING=y
# [observed] systemd-binfmt and proc-sys-fs-binfmt_misc.automount are skipped ("unmet
# condition ConditionPathExists=/proc/sys/fs/binfmt_misc"). qemu-user-static-binfmt is
# installed: without this, x86-64 containers and binaries cannot start. Built in, as on
# Arch, because the automount unit's condition needs the directory before any module
# would load.
CONFIG_BINFMT_MISC=y

# ============================================================================================
# 6. Standard iptables extensions
# ============================================================================================
# [common] Each of these is a small module loaded only when a rule names it. Without the
# module the whole rule set fails to load, which is exactly how ufw and Tailscale failed
# above. This is the set VPN clients, libvirt, connection sharing and firewall scripts use.
# Matches: BPF program, cgroup, connection bytes and count, DSCP, IPsec ESP, hash limit,
# conntrack helper, address range, packet length, MAC address, socket owner, bridge port,
# packet type, quota, socket, nth/random, string, time of day, raw bytes.
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_CGROUP=m
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_DSCP=m
CONFIG_NETFILTER_XT_MATCH_ESP=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HELPER=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_STRING=m
CONFIG_NETFILTER_XT_MATCH_TIME=m
CONFIG_NETFILTER_XT_MATCH_U32=m
# [common] Targets: fill in checksums (libvirt DHCP), traffic class, conntrack zone and
# NOTRACK, DSCP, hop limit, 1:1 network map, log and queue to userspace, duplicate,
# transparent proxy.
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_DSCP=m
CONFIG_NETFILTER_XT_TARGET_HL=m
CONFIG_NETFILTER_XT_TARGET_NETMAP=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_NETFILTER_XT_TARGET_TEE=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
# [common] The netlink channels NFLOG and NFQUEUE deliver to.
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_NETLINK_QUEUE=m

# ============================================================================================
# 7. VPN and tunnels
# ============================================================================================
# [common] WireGuard in the kernel (wg-quick, NetworkManager, Mullvad, Proton). Tailscale
# brings its own userspace WireGuard and does not need it.
CONFIG_WIREGUARD=m
# IPsec (strongSwan, libreswan) is not in this file: it cannot be added as modules only,
# because it builds the XFRM core into the kernel image. The document has the five
# lines to add when an IKEv2 VPN is needed.
# [common] PPP for L2TP, SSTP and Fortinet VPN clients, PPPoE and USB modems. PPTP is
# left out: it is obsolete and would pull in GRE demultiplexing only for itself.
CONFIG_PPP=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_MPPE=m
CONFIG_PPPOE=m
CONFIG_L2TP=m
CONFIG_PPPOL2TP=m

# ============================================================================================
# 8. System services
# ============================================================================================
# [observed] systemd-oomd is enabled and never starts: "unmet condition
# ConditionPathExists=/proc/pressure/memory". Pressure stall information.
CONFIG_PSI=y
# [observed] systemd-modules-load: "Failed to find module 'pkcs8_key_parser'". iwd asks
# for it (modules-load.d/pkcs8.conf) to read private keys for WPA-Enterprise (EAP-TLS).
CONFIG_PKCS8_PRIVATE_KEY_PARSER=m
# [common] Arch's linux-firmware ships every file compressed (.zst). The Apple firmware
# on this install is uncompressed, so nothing fails today, but a USB Wi-Fi, Bluetooth or
# capture device that needs linux-firmware cannot load its firmware without this.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# ============================================================================================
# 9. Input devices
# ============================================================================================
# [installed] /dev/uinput: bluetoothd uses it for headset media keys (AVRCP); so do key
# remappers and input injectors (kanata, keyd, ydotool) and game controller mapping.
CONFIG_INPUT_UINPUT=m
# [installed] /dev/usb/hiddev*: asdcontrol (installed) sets Apple display brightness
# through it; UPS and other HID power devices use it too.
CONFIG_USB_HIDDEV=y
# [peripheral] Battery level of wireless mice, keyboards and controllers in UPower.
CONFIG_HID_BATTERY_STRENGTH=y
# [peripheral] Logitech receivers (Unifying, Bolt, Lightspeed) and HID++: per-device
# battery, high-resolution wheel, pairing. Without it they work as plain HID only.
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
# [peripheral] Keyboards and mice that need a quirk driver for extra keys, wheels or
# reports: Microsoft, Lenovo (ThinkPad keyboards), Razer, Kensington, Cherry, Chicony,
# A4Tech, Belkin, Cypress, Ezkey, ITE, KYE/Genius, Monterey, Sunplus, Primax, Samsung,
# Semitek, Redragon, Glorious, Holtek, Elecom trackballs, Corsair, SteelSeries, Roccat,
# Cougar, Xiaomi, Speedlink, Saitek, Macally, Maltron, Keytouch, LC-Power, Ortek, NTI.
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LENOVO=m
CONFIG_HID_RAZER=m
CONFIG_HID_KENSINGTON=m
CONFIG_HID_CHERRY=m
CONFIG_HID_CHICONY=m
CONFIG_HID_A4TECH=m
CONFIG_HID_BELKIN=m
CONFIG_HID_CYPRESS=m
CONFIG_HID_EZKEY=m
CONFIG_HID_ITE=m
CONFIG_HID_KYE=m
CONFIG_HID_MONTEREY=m
CONFIG_HID_SUNPLUS=m
CONFIG_HID_PRIMAX=m
CONFIG_HID_SAMSUNG=m
CONFIG_HID_SEMITEK=m
CONFIG_HID_REDRAGON=m
CONFIG_HID_GLORIOUS=m
CONFIG_HID_HOLTEK=m
CONFIG_HID_ELECOM=m
CONFIG_HID_CORSAIR=m
CONFIG_HID_STEELSERIES=m
CONFIG_HID_ROCCAT=m
CONFIG_HID_COUGAR=m
CONFIG_HID_XIAOMI=m
CONFIG_HID_SPEEDLINK=m
CONFIG_HID_SAITEK=m
CONFIG_HID_MACALLY=m
CONFIG_HID_MALTRON=m
CONFIG_HID_KEYTOUCH=m
CONFIG_HID_LCPOWER=m
CONFIG_HID_ORTEK=m
CONFIG_HID_NTI=m
# [peripheral] Headsets and speakerphones whose buttons need a driver: Jabra, Plantronics
# (Poly), C-Media based USB audio adapters.
CONFIG_HID_JABRA=m
CONFIG_HID_PLANTRONICS=m
CONFIG_HID_CMEDIA=m
# [peripheral] Drawing tablets: Wacom, UC-Logic (Huion, XP-Pen, Ugee), Waltop, Letsketch,
# ViewSonic/Signotec.
CONFIG_HID_WACOM=m
CONFIG_HID_UCLOGIC=m
CONFIG_HID_WALTOP=m
CONFIG_HID_LETSKETCH=m
CONFIG_HID_VIEWSONIC=m
# [peripheral] Game controllers: joystick device nodes, Xbox pads (USB and adapter),
# PlayStation 3/4/5, Nintendo Switch, Steam Controller and Deck, Wii, and the generic pads
# and adapters with their own HID drivers.
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_HID_STEAM=m
CONFIG_HID_WIIMOTE=m
CONFIG_HID_THRUSTMASTER=m
CONFIG_HID_DRAGONRISE=m
CONFIG_HID_GREENASIA=m
CONFIG_HID_PANTHERLORD=m
CONFIG_HID_SMARTJOYPLUS=m
CONFIG_HID_ZEROPLUS=m
CONFIG_HID_ACRUX=m
CONFIG_HID_GEMBIRD=m
CONFIG_HID_MAYFLASH=m
CONFIG_HID_BETOP_FF=m
CONFIG_HID_EMS_FF=m
CONFIG_HID_XINMO=m
CONFIG_HID_ICADE=m
# [peripheral] Remote controls and presenters: Gyration, Twinhan, TopSeed, Petalynx,
# Zydacron, TiVo, Aureal.
CONFIG_HID_GYRATION=m
CONFIG_HID_TWINHAN=m
CONFIG_HID_TOPSEED=m
CONFIG_HID_PETALYNX=m
CONFIG_HID_ZYDACRON=m
CONFIG_HID_TIVO=m
CONFIG_HID_AUREAL=m

# ============================================================================================
# 10. USB storage, card readers, optical drives
# ============================================================================================
# [peripheral] USB Attached SCSI: what nearly every USB 3 SSD enclosure speaks. Without it
# such drives fall back to the slower bulk-only protocol or do not appear.
CONFIG_USB_UAS=m
# [peripheral] Realtek-based USB card readers (ums-realtek): the mass-storage driver
# with their power management and media change handling.
CONFIG_USB_STORAGE_REALTEK=m
# [peripheral] USB optical drives and SCSI generic access (disc ripping and burning,
# scanners, sg_utils).
CONFIG_BLK_DEV_SR=m
CONFIG_CHR_DEV_SG=m

# ============================================================================================
# 11. File systems on removable media and the network
# ============================================================================================
# [installed] exFAT: SD cards and USB sticks above 32 GB (exfatprogs is installed).
CONFIG_EXFAT_FS=m
# [peripheral] NTFS read and write for Windows-formatted drives, with compressed files
# and ACLs as Arch builds it.
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
# [peripheral] HFS+: Mac-formatted external drives and Time Machine disks (read; write
# only when unjournaled).
CONFIG_HFSPLUS_FS=m
# [peripheral] ISO 9660 with Joliet names and compressed files, and UDF: disc images,
# installer media, DVDs and Blu-rays.
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
# [peripheral] Plain FAT without long names (firmware update sticks, old devices).
CONFIG_MSDOS_FS=m
# [peripheral] XFS and F2FS: disks from other Linux machines, Android SD cards.
CONFIG_XFS_FS=m
CONFIG_XFS_POSIX_ACL=y
CONFIG_F2FS_FS=m
# [installed] SMB shares in the kernel (cifs-utils and gvfs-smb are installed): mount.cifs
# for a NAS, with extended attributes, Kerberos/DNS upcalls and DFS. SMB1 and NTLMv1
# default to on with CIFS; they are pinned off here (the document says how to reverse
# that for a very old NAS).
CONFIG_CIFS=m
# CONFIG_CIFS_ALLOW_INSECURE_LEGACY is not set
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_DFS_UPCALL=y
# [peripheral] UTF-8 name translation for the "iocharset=utf8" mount option that cifs,
# hfsplus, iso9660 and udf mounts are commonly given.
CONFIG_NLS_UTF8=m
# [peripheral] squashfs images compressed with xz or zstd (live ISO root images,
# appliance and snap images) and their extended attributes. The base reads only zlib.
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
# [peripheral] Apple partition maps (old Mac disks, hybrid installer images). Turning on
# the advanced menu makes the two tables the system itself uses explicit choices, so
# they are pinned here.
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_MAC_PARTITION=y

# ============================================================================================
# 12. USB network adapters, phones, serial adapters
# ============================================================================================
# [peripheral] Android USB tethering (RNDIS).
CONFIG_USB_NET_RNDIS_HOST=m
# [peripheral] iPhone USB tethering.
CONFIG_USB_IPHETH=m
# [peripheral] LTE and 5G modems and hotspots: MBIM, Qualcomm QMI, Huawei NCM, and the
# control channel they share.
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_HUAWEI_CDC_NCM=m
CONFIG_USB_WDM=m
# [peripheral] Aquantia AQC111 5 Gbit and 2.5 Gbit USB Ethernet adapters; CDC EEM gadgets.
CONFIG_USB_NET_AQC111=m
CONFIG_USB_NET_CDC_EEM=m
# [peripheral] USB serial adapters beyond the FTDI and CP210x the base has: CH340/CH341
# (most Arduino clones and ESP boards), Prolific PL2303, the simple single-port family,
# and the generic driver for devices given by ID at run time.
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_SIMPLE=m
CONFIG_USB_SERIAL_GENERIC=y
# [peripheral] iPhones and iPads charge at full current from the laptop's ports.
CONFIG_APPLE_MFI_FASTCHARGE=m
# [common] USB traffic capture for Wireshark and usbmon, the first tool for a USB device
# that misbehaves.
CONFIG_USB_MON=m
# [common] One kernel log line per device that enumerates (vendor, product, strings), as
# Arch builds it. The USB-C ports of this machine are still being brought up: this makes
# "did the device enumerate" answerable from the log alone.
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
# [peripheral] DisplayLink USB 2.0 display adapters (udl). USB 3 DisplayLink docks need
# the out-of-tree evdi driver instead.
CONFIG_DRM_UDL=m

# ============================================================================================
# 13. MIDI
# ============================================================================================
# [common] The ALSA sequencer: PipeWire's MIDI bridge, aconnect, and every MIDI program
# use it; without it USB MIDI keyboards appear as raw devices only. With the dummy client,
# a high-resolution timer as its default clock, and virtual MIDI ports.
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_HRTIMER=m
CONFIG_SND_SEQ_HRTIMER_DEFAULT=y
CONFIG_SND_VIRMIDI=m

# ============================================================================================
# 14. Virtual machines
# ============================================================================================
# [common] KVM is built in. These are the host-side accelerators QEMU and libvirt expect:
# in-kernel virtio-net, and sockets between host and guest (vsock).
CONFIG_VHOST_NET=m
CONFIG_VSOCKETS=m
CONFIG_VHOST_VSOCK=m
