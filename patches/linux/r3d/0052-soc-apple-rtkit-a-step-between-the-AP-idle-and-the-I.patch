From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Axboe <axboe@kernel.dk>
Date: Wed, 18 Nov 2026 06:39:39 -0700
Subject: [PATCH 52/93] soc: apple: rtkit: a step between the AP idle and the
 IOP idle

A coprocessor with a second (secure) mailbox port takes its IOP idle
only after that port's AP idle, sent between the main mailbox's AP idle
and its IOP idle. The display coprocessor of T6050 firmware 27.2 is one:
without it the IOP idle is never acknowledged.

- apple_rtkit_v27_set_after_ap(): a callback the atomic idle runs once
  the AP state is acknowledged, before the IOP request. An error from
  it fails the idle.
- apple_rtkit_v27_port_ap_idle_atomic(): a port's AP idle, sent and
  awaited by polling, for that callback.
- apple_rtkit_idle_strict_with(): the same step for the sleeping idle,
  failing it the same way.

No caller yet.

Signed-off-by: Jens Axboe <axboe@kernel.dk>

[re-cut onto the K114s r3d tree]
---
 drivers/soc/apple/rtkit-v27-late.inc    | 57 +++++++++++++++++++++++++
 drivers/soc/apple/rtkit.c               | 14 +++++-
 include/linux/soc/apple/dcp-v27-sleep.h |  2 +
 include/linux/soc/apple/rtkit.h         |  1 +
 4 files changed, 73 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/rtkit-v27-late.inc b/drivers/soc/apple/rtkit-v27-late.inc
index 6f3bfd84ab0..44d3b92cb27 100644
--- a/drivers/soc/apple/rtkit-v27-late.inc
+++ b/drivers/soc/apple/rtkit-v27-late.inc
@@ -7,8 +7,23 @@ struct apple_rtkit_v27_scope {
 	DECLARE_KFIFO(deferred, struct apple_mbox_msg, 64);
 	bool held, stopped, failed;
 	int error;
+	/*
+	 * Run once between the AP state's acknowledgment and the IOP request, interrupts off.
+	 * An error fails the idle.
+	 */
+	int (*after_ap)(void *data);
+	void *after_ap_data;
 };
 
+void apple_rtkit_v27_set_after_ap(struct apple_rtkit_v27_scope *s, int (*fn)(void *), void *data)
+{
+	if (s) {
+		s->after_ap = fn;
+		s->after_ap_data = data;
+	}
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_v27_set_after_ap);
+
 bool apple_rtkit_v27_live(struct apple_rtkit *rtk)
 {
 	return !rtk->crashed && !rtk->shutting_down &&
@@ -118,6 +133,43 @@ int apple_rtkit_v27_check(struct apple_rtkit_v27_scope *s)
 }
 EXPORT_SYMBOL_GPL(apple_rtkit_v27_check);
 
+/*
+ * A second port's AP idle with interrupts off: sent, and its acknowledgment awaited by polling
+ * the port's mailbox, for at most @us. The port's tracked state is not updated.
+ */
+int apple_rtkit_v27_port_ap_idle_atomic(struct apple_rtkit *rtk, unsigned int us)
+{
+	struct apple_mbox_msg msg = {
+		.msg0 = FIELD_PREP(APPLE_RTKIT_MGMT_TYPE, APPLE_RTKIT_MGMT_SET_AP_PWR_STATE) |
+			FIELD_PREP(APPLE_RTKIT_MGMT_PWR_STATE, APPLE_RTKIT_PWR_STATE_IDLE),
+		.msg1 = APPLE_RTKIT_EP_MGMT,
+	};
+	unsigned int i, n = us / 10;
+	int ret = -ETIMEDOUT;
+
+	for (i = 0; i < n; i++) {
+		ret = apple_mbox_send_nowait(rtk->mbox, msg);
+		if (ret != -EAGAIN && ret != -EBUSY)
+			break;
+		udelay(10);
+	}
+	if (ret)
+		return ret;
+	for (; i < n; i++) {
+		struct apple_mbox_msg in;
+
+		ret = apple_mbox_recv_nowait(rtk->mbox, &in);
+		if (ret < 0 && ret != -EBUSY)
+			return ret;
+		if (ret > 0 && in.msg1 == APPLE_RTKIT_EP_MGMT &&
+		    FIELD_GET(APPLE_RTKIT_MGMT_TYPE, in.msg0) == APPLE_RTKIT_MGMT_SET_AP_PWR_STATE_ACK)
+			return 0;
+		udelay(10);
+	}
+	return -ETIMEDOUT;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_v27_port_ap_idle_atomic);
+
 int apple_rtkit_v27_idle_atomic(struct apple_rtkit_v27_scope *s)
 {
 	struct apple_rtkit *rtk;
@@ -180,6 +232,11 @@ int apple_rtkit_v27_idle_atomic(struct apple_rtkit_v27_scope *s)
 				    type == APPLE_RTKIT_MGMT_SET_AP_PWR_STATE_ACK &&
 				    arg == APPLE_RTKIT_PWR_STATE_IDLE) {
 					ap_ack = true;
+					if (s->after_ap) {
+						ret = s->after_ap(s->after_ap_data);
+						if (ret)
+							goto poison;
+					}
 				} else if (msg.msg1 == APPLE_RTKIT_EP_MGMT && iop_sent && !iop_ack &&
 					   type == APPLE_RTKIT_MGMT_SET_IOP_PWR_STATE_ACK &&
 					   arg == APPLE_RTKIT_PWR_STATE_IDLE) {
diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index 47440572e9d..5080c43e2b6 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -2867,6 +2867,16 @@ static int apple_rtkit_strict_idle_state(struct apple_rtkit *rtk, bool ap)
 }
 
 int apple_rtkit_idle_strict(struct apple_rtkit *rtk)
+{
+	return apple_rtkit_idle_strict_with(rtk, NULL, NULL);
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_idle_strict);
+
+/*
+ * As apple_rtkit_idle_strict(), with a step between the AP state's and the IOP state's.
+ * A failed step fails the idle: the IOP state is not sent.
+ */
+int apple_rtkit_idle_strict_with(struct apple_rtkit *rtk, int (*after_ap)(void *data), void *data)
 {
 	int ret;
 
@@ -2877,6 +2887,8 @@ int apple_rtkit_idle_strict(struct apple_rtkit *rtk)
 	reinit_completion(&rtk->strict_idle_done);
 	WRITE_ONCE(rtk->strict_idle_waiting, true);
 	ret = apple_rtkit_strict_idle_state(rtk, true);
+	if (!ret && after_ap)
+		ret = after_ap(data);
 	if (!ret)
 		ret = apple_rtkit_strict_idle_state(rtk, false);
 	if (!ret && !wait_for_completion_timeout(&rtk->strict_idle_done,
@@ -2889,7 +2901,7 @@ int apple_rtkit_idle_strict(struct apple_rtkit *rtk)
 		rtk->strict_idle_poisoned = true;
 	return ret;
 }
-EXPORT_SYMBOL_GPL(apple_rtkit_idle_strict);
+EXPORT_SYMBOL_GPL(apple_rtkit_idle_strict_with);
 
 int apple_rtkit_warm_restart_strict(struct apple_rtkit *rtk)
 {
diff --git a/include/linux/soc/apple/dcp-v27-sleep.h b/include/linux/soc/apple/dcp-v27-sleep.h
index 5e56c401419..3484c04a98c 100644
--- a/include/linux/soc/apple/dcp-v27-sleep.h
+++ b/include/linux/soc/apple/dcp-v27-sleep.h
@@ -39,6 +39,8 @@ int apple_rtkit_v27_arm(struct apple_rtkit *, struct apple_rtkit_v27_scope **);
 bool apple_rtkit_v27_live(struct apple_rtkit *);
 int apple_rtkit_v27_check(struct apple_rtkit_v27_scope *);
 int apple_rtkit_v27_idle_atomic(struct apple_rtkit_v27_scope *);
+int apple_rtkit_v27_port_ap_idle_atomic(struct apple_rtkit *rtk, unsigned int us);
+void apple_rtkit_v27_set_after_ap(struct apple_rtkit_v27_scope *s, int (*fn)(void *), void *data);
 int apple_rtkit_v27_disarm(struct apple_rtkit_v27_scope *, bool stopped);
 
 int apple_dart_v27_claim(struct device *provider, struct device *firmware,
diff --git a/include/linux/soc/apple/rtkit.h b/include/linux/soc/apple/rtkit.h
index c5cdecc34cb..055e1424d94 100644
--- a/include/linux/soc/apple/rtkit.h
+++ b/include/linux/soc/apple/rtkit.h
@@ -290,6 +290,7 @@ int apple_rtkit_idle(struct apple_rtkit *rtk);
 /* The mailbox's receive-enable bit (I2A_CONTROL bit 0): off once a slept firmware has answered its idle. */
 void apple_rtkit_set_recv_enabled(struct apple_rtkit *rtk, bool enabled);
 int apple_rtkit_idle_strict(struct apple_rtkit *rtk);
+int apple_rtkit_idle_strict_with(struct apple_rtkit *rtk, int (*after_ap)(void *data), void *data);
 int apple_rtkit_warm_restart_strict(struct apple_rtkit *rtk);
 int apple_rtkit_warm_restart_stopped(struct apple_rtkit *rtk);
 
