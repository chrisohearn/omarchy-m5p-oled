#!/bin/bash
# K114s (omarchy-m5p-oled) r3: rebuild an installed package into a pacman archive, from the files
# on disk and pacman's local database. Read-only apart from the archive it writes.
#
#     sudo k114s-repackage [--out DIR] [--allow-missing] PACKAGE
#
# Why: the image's own package builds are in no repository and not in the package cache, so
# after a bad update there is nothing to "pacman -U" back. On 2026-11-14 six packages were put
# back by copying files around pacman, and a file list with directory names in it copied far too
# much. This writes a real package instead, so the way back is one pacman transaction:
#     sudo pacman -U DIR/PACKAGE-VERSION-ARCH.pkg.tar.zst
#
# What goes in: exactly the paths the local database lists for the package, each archived as
# itself (a directory is one entry, never its contents), plus .PKGINFO rebuilt from the database
# entry, the install scriptlet, and a fresh .MTREE of what was archived. The files are taken AS
# THEY ARE NOW: a file that was changed after installation (the repair kernel placed over the
# packaged one, an edited /etc file) is archived changed, and listed in the report beside the
# archive. That is the point of a rollback copy: the state that was working.
#
# Not root: files only root can read stop it, and ownership is recorded as root:root.
#   exit 0 archive written and re-read; 1 refused, nothing written; 2 usage
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=k114s-lib.sh
. "${K114S_LIB_SH:-$HERE/k114s-lib.sh}"

out=$PWD allow_missing=0 package=
while (($#)); do
  case $1 in
    --out) out=${2:?--out needs a folder}; shift 2 ;;
    --allow-missing) allow_missing=1; shift ;;
    -*) warn "unknown option $1"; exit 2 ;;
    *) [[ -z $package ]] || { warn "one package at a time"; exit 2; }; package=$1; shift ;;
  esac
done
[[ -n $package ]] && valid_name "$package" || { warn "usage: k114s-repackage [--out DIR] [--allow-missing] PACKAGE"; exit 2; }
db=$(local_db_dir "$package") || die "$package is not installed"
[[ -f $db/desc && -f $db/files ]] || die "$db is incomplete"
base=${ROOT:-/}

field() { awk -v key="%$1%" '$0 == key { on = 1; next } on && $0 == "" { exit } on { print }' "$2"; }
version=$(field VERSION "$db/desc" | head -n 1)
arch=$(field ARCH "$db/desc" | head -n 1)
[[ -n $version && -n $arch ]] || die "$db/desc has no version or architecture"

work=$(mktemp -d "${TMPDIR:-/tmp}/k114s-repackage.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir "$work/meta"

# The file list, NUL-separated and exactly as recorded. Each path is checked before anything is written.
field FILES "$db/files" > "$work/files.txt"
: > "$work/present.list"; : > "$work/missing.txt"; : > "$work/unreadable.txt"
while IFS= read -r path; do
  [[ -n $path ]] || continue
  [[ $path != /* && $path != *..* ]] || die "unsafe path in the file list: $path"
  full=$base/$path
  if [[ $path == */ ]]; then
    if [[ -d $full && ! -L ${full%/} ]]; then printf '%s\0' "$path" >> "$work/present.list"; else echo "$path" >> "$work/missing.txt"; fi
  elif [[ -L $full ]]; then
    printf '%s\0' "$path" >> "$work/present.list"
  elif [[ -e $full ]]; then
    if [[ -r $full ]]; then printf '%s\0' "$path" >> "$work/present.list"; else echo "$path" >> "$work/unreadable.txt"; fi
  else
    echo "$path" >> "$work/missing.txt"
  fi
done < "$work/files.txt"
if [[ -s $work/unreadable.txt ]]; then
  warn "cannot read $(wc -l < "$work/unreadable.txt") file(s) of $package (first: $(head -n 1 "$work/unreadable.txt")); run with sudo. Nothing written."
  exit 1
fi
if [[ -s $work/missing.txt ]] && ((!allow_missing)); then
  warn "$(wc -l < "$work/missing.txt") path(s) of $package are not on disk (first: $(head -n 1 "$work/missing.txt"))."
  warn "With --allow-missing the archive is written without them and the report names them. Nothing written."
  exit 1
fi

# .PKGINFO from the database entry
{
  echo "# Generated by k114s-repackage (omarchy-m5p-oled) from the installed package and its files on disk"
  echo "pkgname = $package"
  pkgbase=$(field BASE "$db/desc" | head -n 1); echo "pkgbase = ${pkgbase:-$package}"
  field XDATA "$db/desc" | sed 's/^/xdata = /'
  echo "pkgver = $version"
  field DESC "$db/desc" | head -n 1 | sed 's/^/pkgdesc = /'
  field URL "$db/desc" | head -n 1 | sed 's/^/url = /'
  field BUILDDATE "$db/desc" | head -n 1 | sed 's/^/builddate = /'
  field PACKAGER "$db/desc" | head -n 1 | sed 's/^/packager = /'
  field SIZE "$db/desc" | head -n 1 | sed 's/^/size = /'
  echo "arch = $arch"
  field LICENSE "$db/desc" | sed 's/^/license = /'
  field REPLACES "$db/desc" | sed 's/^/replaces = /'
  field GROUPS "$db/desc" | sed 's/^/group = /'
  field CONFLICTS "$db/desc" | sed 's/^/conflict = /'
  field PROVIDES "$db/desc" | sed 's/^/provides = /'
  field BACKUP "$db/files" | cut -f1 | sed 's/^/backup = /'
  field DEPENDS "$db/desc" | sed 's/^/depend = /'
  field OPTDEPENDS "$db/desc" | sed 's/^/optdepend = /'
} > "$work/meta/.PKGINFO"
meta=(.PKGINFO)
if [[ -f $db/install ]]; then cp "$db/install" "$work/meta/.INSTALL"; meta+=(.INSTALL); fi

# Without root the archive cannot carry ownership it cannot read back as itself: record root.
owner=()
if [[ $(id -u) != 0 ]]; then owner=(--uid 0 --gid 0 --uname root --gname root); fi
mtree_options='!all,use-set,type,uid,gid,mode,time,size,md5,sha256,link'
{
  (cd "$work/meta" && LANG=C bsdtar "${owner[@]}" -cf - --format=mtree --options="$mtree_options" "${meta[@]}")
  if [[ -s $work/present.list ]]; then
    (cd "$base" && LANG=C bsdtar "${owner[@]}" -cnf - --format=mtree --options="$mtree_options" --null --files-from "$work/present.list") | sed '1{/^#mtree/d}'
  fi
} | gzip -c -f -n > "$work/meta/.MTREE"
meta+=(.MTREE)

# The archive: metadata first, then every listed path as one entry (-n: a directory is not descended into).
(cd "$work/meta" && LANG=C bsdtar "${owner[@]}" --no-fflags -cf "$work/pkg.tar" "${meta[@]}")
if [[ -s $work/present.list ]]; then
  (cd "$base" && LANG=C bsdtar "${owner[@]}" --no-fflags -rnf "$work/pkg.tar" --null --files-from "$work/present.list")
fi

# Re-read it: the entries must be exactly the metadata plus the listed paths, nothing more.
tr '\0' '\n' < "$work/present.list" | sed 's#/$##' | LC_ALL=C sort > "$work/want.txt"
bsdtar -tf "$work/pkg.tar" | sed 's#/$##' | grep -v -E '^\.(PKGINFO|MTREE|INSTALL)$' | LC_ALL=C sort > "$work/have.txt" || true
cmp -s "$work/want.txt" "$work/have.txt" || die "the archive's entries are not the package's file list; nothing written"

mkdir -p "$out"
archive=$out/$package-$version-$arch.pkg.tar.zst
zstd -q -T0 -f "$work/pkg.tar" -o "$archive.partial"
mv -f "$archive.partial" "$archive"

# The report: what differs from the package as it was installed (its own .MTREE in the database).
report=$archive.repackage.txt
{
  echo "package   $package $version ($arch)"
  echo "archive   ${archive##*/}"
  echo "sha256    $(sum "$archive")"
  echo "bytes     $(size "$archive")"
  echo "made      $(now) from the files on disk and $(basename "$db") in pacman's local database"
  echo "entries   $(wc -l < "$work/want.txt")"
  if [[ $(id -u) != 0 ]]; then echo "ownership recorded as root:root (not run as root)"; fi
  if [[ -s $work/missing.txt ]]; then echo "missing on disk, NOT in the archive:"; sed 's/^/  /' "$work/missing.txt"; fi
  if [[ -f $db/mtree ]]; then
    # regular files whose content is no longer what the package installed
    gzip -dc "$db/mtree" 2>/dev/null | awk '
      { path = $1; digest = ""
        for (i = 2; i <= NF; i++) if ($i ~ /^sha256digest=/) digest = substr($i, 14)
        if (digest != "" && path ~ /^\.\// && path !~ /^\.\/\./ && path !~ /\\/) print digest "  " substr(path, 3) }' > "$work/original.sha256" || true
    if [[ -s $work/original.sha256 ]]; then
      changed=$( (cd "$base" && sha256sum --quiet -c "$work/original.sha256" 2>/dev/null) | sed -n 's/: FAILED$//p' || true)
      if [[ -n $changed ]]; then echo "changed since installation (archived as they are now):"; printf '%s\n' "$changed" | sed 's/^/  /'
      else echo "every file is as the package installed it"; fi
    fi
  else
    echo "the database entry has no mtree: could not compare with the package as installed"
  fi
  echo "restore   sudo pacman -U ${archive##*/}"
} > "$report"
say "wrote $archive ($(( $(size "$archive") / 1000000 )) MB, $(wc -l < "$work/want.txt") entries)"
grep -E '^(missing|changed)' "$report" | sed "s/^/$k114s_name:   /" || true
