 drivers/gpu/drm/apple/dcp.c                | 23 +++++++++
 drivers/gpu/drm/apple/dcp_backlight.c      | 11 ++++
 drivers/gpu/drm/apple/dcp_backlight.h      | 26 ++++++++++
 drivers/gpu/drm/apple/dcp_backlight_test.c | 60 ++++++++++++++++++++++
 5 files changed, 122 insertions(+)

diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index e0c4ae06065d..46b877d51bf2 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -194,6 +194,8 @@ struct dcp_fb_reference {
 struct dcp_brightness {
 	struct backlight_device *bl_dev;
 	u32 maximum;
+	/* apple,min-brightness: lowest level a request reaches, 0 for none. */
+	u32 minimum;
 	u32 dac;
 	int nits;
 	int scale;
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index e139b5e48c00..c0f750a08834 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1432,6 +1432,28 @@ void dcp_panel_read_dimensions(struct apple_dcp *dcp, struct device_node *panel_
 		of_property_read_u32(panel_np, "adj-height-mm", &dcp->panel.height_mm);
 }
 
+/*
+ * Optional floor for brightness requests, in the nits of apple,max-brightness
+ * (read first).  Only a floor below the ceiling is one.
+ */
+static void dcp_panel_read_min_brightness(struct apple_dcp *dcp,
+					  struct device_node *panel_np)
+{
+	u32 minimum;
+
+	if (of_property_read_u32(panel_np, "apple,min-brightness", &minimum) || !minimum)
+		return;
+	if (minimum >= dcp->brightness.maximum) {
+		dev_warn(dcp->dev,
+			 "ignoring 'apple,min-brightness' %u: not below the maximum %u\n",
+			 minimum, dcp->brightness.maximum);
+		return;
+	}
+	dcp->brightness.minimum = minimum;
+	dev_info(dcp->dev, "brightness requests below %u nits are raised to %u nits\n",
+		 minimum, minimum);
+}
+
 /*
  * Every internal panel gets an identity, so userspace can tell it apart and
  * keep per-display settings such as its brightness.  The identity state is
@@ -7409,6 +7431,7 @@ static int dcp_comp_bind_pipe(struct device *dev, struct device *main, void *dat
 						   &dcp->brightness.maximum);
 			if (ret)
 				dev_err(dev, "Missing property 'apple,max-brightness'\n");
+			dcp_panel_read_min_brightness(dcp, panel_np);
 		}
 
 		dcp_panel_read_dimensions(dcp, panel_np);
