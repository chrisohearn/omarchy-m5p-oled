+  // K114s local change: limit meters read as room left, as T3 Code's do, so
+  // every provider's bar drains the same way. Records keep the share used.
+  function leftShare(w) {
+    return w ? 1 - root.clamp(Number(w.percent), 0, 1) : -1
+  }
+
+  // Even pace on a room-left meter is the share of the window's time left.
+  function paceLeftShare(w) {
+    if (!w || !(Number(w.span) > 0)) return -1
+    var ms = resetMsFor(w)
+    if (!(ms > 0)) return -1
+    return root.clamp(ms / Number(w.span), 0, 1)
+  }
+
+  // Ahead of pace: more used than the time gone (T3 Code's 5-point margin).
+  function paceText(w) {
+    var pace = paceLeftShare(w)
+    if (pace < 0) return ""
+    var gap = Number(w.percent) - (1 - pace)
+    if (gap > 0.05) return Commons.I18n.t("agents.paceAhead", "Ahead of pace")
+    if (gap < -0.05) return Commons.I18n.t("agents.paceUnder", "Under pace")
+    return Commons.I18n.t("agents.paceOn", "On pace")
+  }
