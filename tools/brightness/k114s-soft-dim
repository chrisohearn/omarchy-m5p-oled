#!/bin/bash
# K114s (omarchy-m5p-oled): interim, software-only dimming while the panel is the boot framebuffer.
#
# NOT a brightness control. It asks Hyprland to scale every pixel down in its final render pass
# (decoration:screen_shader). 100% is whatever level the boot stage left the panel at; this tool
# can only go below that. It cannot make the panel brighter. Remove it once the display
# coprocessor port gives the panel a real backlight device.
#
#     k114s-soft-dim            print the current software level (percent of the boot level)
#     k114s-soft-dim 60         set 60 %
#     k114s-soft-dim +10 | -10  step
#     k114s-soft-dim off        back to 100 % (no shader)
#
# The percentage is approximate luminance: pixel values are multiplied by (level/100)^(1/2.2).
# Limits: 8-bit output, so low levels band; screenshots may or may not include the dimming;
# a Hyprland config reload drops it (run the tool again). Floor: 10 %.
#
# Status: written from Hyprland 0.57.2 source (applyScreenShader); the shader compiles with
# glslangValidator. Not yet run against the compositor on the K114s (K114S_DIM_DRY_RUN=1 prints
# the command instead of running it).
set -euo pipefail

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/k114s-soft-dim
run_dir=${XDG_RUNTIME_DIR:-/tmp}/k114s-soft-dim
floor=10

current() {
  local v=100
  [[ -r $state_dir/level ]] && read -r v <"$state_dir/level"
  [[ $v =~ ^[0-9]+$ ]] && (( v >= floor && v <= 100 )) || v=100
  echo "$v"
}

apply() {
  local level=$1 shader arg
  if (( level >= 100 )); then
    arg='[[EMPTY]]'
  else
    mkdir -p "$run_dir"
    # One file per level: a new path makes Hyprland load the new shader.
    shader=$run_dir/dim-$level.frag
    awk -v l="$level" 'BEGIN {
      f = exp(log(l / 100) / 2.2)
      print "#version 300 es"
      print "precision mediump float;"
      print "in vec2 v_texcoord;"
      print "layout(location = 0) out vec4 fragColor;"
      print "uniform sampler2D tex;"
      print "void main() {"
      print "    vec4 c = texture(tex, v_texcoord);"
      printf "    fragColor = vec4(c.rgb * %.4f, c.a);\n", f
      print "}"
    }' >"$shader"
    arg=$shader
  fi
  if [[ -n ${K114S_DIM_DRY_RUN:-} ]]; then
    echo "hyprctl keyword decoration:screen_shader $arg"
  else
    hyprctl keyword decoration:screen_shader "$arg" >/dev/null
  fi
  mkdir -p "$state_dir"
  echo "$level" >"$state_dir/level"
  if [[ -z ${K114S_DIM_DRY_RUN:-} ]] && command -v omarchy-osd >/dev/null; then
    omarchy-osd -i brightness -p "$level" || true
  fi
}

case ${1:-} in
"") current ;;
off) apply 100 ;;
[+-][0-9]*|[0-9]*)
  [[ $1 =~ ^([+-]?)([0-9]{1,3})%?$ ]] || { echo "k114s-soft-dim: bad level: $1" >&2; exit 2; }
  n=${BASH_REMATCH[2]}
  case ${BASH_REMATCH[1]} in
  +) level=$(( $(current) + 10#$n )) ;;
  -) level=$(( $(current) - 10#$n )) ;;
  *) level=$(( 10#$n )) ;;
  esac
  (( level > 100 )) && level=100
  (( level < floor )) && level=$floor
  apply "$level"
  ;;
*) echo "usage: k114s-soft-dim [N | +N | -N | off]" >&2; exit 2 ;;
esac
