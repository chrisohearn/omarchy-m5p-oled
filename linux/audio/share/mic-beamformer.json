{
  "_comment": [
    "OPTIONAL, NOT INSTALLED BY DEFAULT (install-audio.sh --with-beamformer). The K114s microphone graph with the",
    "triforce delay-and-sum beamformer, in the structure of asahi-audio's firs/j314/mic.json (Copyright The Asahi",
    "Linux Contributors, MIT; triforce is https://chadmed.au/triforce, packaged as triforce-lv2).",
    "UNVERIFIED FOR THIS MAC: mic2_x/mic2_y/mic3_x/mic3_y are the J314's array geometry in metres (a 2 cm",
    "equilateral triangle) and h_angle/v_angle its look direction. The K114s array geometry has not been",
    "determined: neither the Apple device tree nor any public source gives it. A wrong geometry steers the",
    "beam wrongly and can make the voice thinner than the plain mix in share/mic.json. Use it only to compare",
    "by ear against the plain mix, and keep the plain mix unless this one is clearly better.",
    "Which of the three raw channels is mic 1, 2 and 3 is also assumed to follow the J314's order (the order",
    "the AOP card presents them in)."
  ],
  "node.description": "MacBook Microphone (Mono, beamformed)",
  "media.name": "MacBook Microphone (Mono, beamformed)",
  "filter.graph": {
    "nodes": [
      { "type": "builtin", "label": "mixer", "name": "mixL", "control": { "Gain 1": 3 } },
      { "type": "builtin", "label": "mixer", "name": "mixR", "control": { "Gain 1": 3 } },
      { "type": "builtin", "label": "mixer", "name": "mixO", "control": { "Gain 1": 2 } },
      {
        "type": "lv2",
        "plugin": "https://chadmed.au/triforce",
        "name": "bf",
        "control": {
          "h_angle": 230.0,
          "v_angle": 0.0,
          "opt_freq": 1100.0,
          "t_win": 500.0,
          "mic2_x": 0.02,
          "mic2_y": 0.00,
          "mic3_x": 0.01,
          "mic3_y": 0.0173
        }
      },
      { "type": "builtin", "label": "mixer", "name": "boostInter", "control": { "Gain 1": 7.6 } },
      { "type": "builtin", "label": "mixer", "name": "boostFinal", "control": { "Gain 1": 7.6 } },
      { "type": "builtin", "label": "bq_highpass", "name": "hpf", "control": { "Freq": 120, "Gain": 1, "Q": 0.707 } },
      {
        "type": "lv2",
        "plugin": "http://lsp-plug.in/plugins/lv2/limiter_mono",
        "name": "lim",
        "control": { "th": 0.891, "lk": 5.0, "at": 1.0, "rt": 50.0, "alr": 0, "boost": 0 }
      }
    ],
    "links": [
      { "output": "mixL:Out", "input": "bf:in_1" },
      { "output": "mixR:Out", "input": "bf:in_2" },
      { "output": "mixO:Out", "input": "bf:in_3" },
      { "output": "bf:out", "input": "boostInter:In 1" },
      { "output": "boostInter:Out", "input": "boostFinal:In 1" },
      { "output": "boostFinal:Out", "input": "hpf:In" },
      { "output": "hpf:Out", "input": "lim:in" }
    ],
    "inputs": [ "mixL:In 1", "mixR:In 1", "mixO:In 1" ],
    "outputs": [ "lim:out" ]
  },
  "capture.props": {
    "node.name": "audio_effect.k114-mic",
    "audio.channels": "3",
    "audio.position": [ "AUX0", "AUX1", "AUX2" ],
    "audio.allowed-rates": [ 48000 ],
    "node.virtual": "false",
    "state.default-volume": 1.0,
    "device.icon-name": "audio-microphone",
    "target.object": "alsa_input.platform-sound.RawMics",
    "node.dont-fallback": "true",
    "node.passive": "true"
  },
  "playback.props": {
    "node.name": "effect_output.k114-mic",
    "media.class": "Audio/Source",
    "priority.session": 2005,
    "node.passive": "true",
    "audio.channels": "1",
    "node.virtual": "false",
    "state.default-volume": 0.343,
    "audio.allowed-rates": [ 8000, 11025, 16000, 22050, 44100, 48000 ],
    "audio.position": [ "MONO" ]
  }
}
