new file mode 100644
index 00000000000..0dc30332746
--- /dev/null
+++ b/drivers/soc/apple/mcc-boot-dma.c
@@ -0,0 +1,304 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * A display controller can keep scanning out the boot loader's framebuffer
+ * after it binds, or with its node disabled. Its driver reserves a record
+ * while it tracks that boot scanout and marks it once a displayed swap of
+ * its own has retired it.
+ */
+#include <linux/bug.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/notifier.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/soc/apple/mcc.h>
+#include <linux/workqueue.h>
+
+struct apple_mcc_scanout {
+	struct list_head link;
+	struct device_node *supplier;
+	bool retired;
+};
+
+struct apple_mcc_scanout_waiter {
+	struct list_head link;
+	struct device_node *consumer;
+	struct device_node *supplier;
+};
+
+/*
+ * Retirement survives either driver's unbind and reprobe; records and
+ * waiters go when a node they name is detached.
+ */
+static DEFINE_MUTEX(boot_scanout_lock);
+static LIST_HEAD(boot_scanouts);
+static LIST_HEAD(waiting_consumers);
+static LIST_HEAD(retry_consumers);
+static LIST_HEAD(enabled_consumers);
+
+/* A node detached already: the notifier has dropped, or will drop, its entries. */
+static bool node_detached(struct device_node *np)
+{
+	return of_node_check_flag(np, OF_DETACHED);
+}
+
+static struct apple_mcc_scanout *find_scanout_locked(struct device_node *supplier)
+{
+	struct apple_mcc_scanout *scanout;
+
+	list_for_each_entry(scanout, &boot_scanouts, link) {
+		if (scanout->supplier == supplier)
+			return scanout;
+	}
+	return NULL;
+}
+
+int apple_mcc_boot_scanout_reserve(struct device_node *supplier)
+{
+	struct apple_mcc_scanout *scanout;
+	int ret = 0;
+
+	mutex_lock(&boot_scanout_lock);
+	if (node_detached(supplier)) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	/* A scanout retired before the supplier was rebound stays retired. */
+	if (find_scanout_locked(supplier))
+		goto out_unlock;
+	scanout = kzalloc_obj(*scanout);
+	if (!scanout) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
+	scanout->supplier = of_node_get(supplier);
+	list_add_tail(&scanout->link, &boot_scanouts);
+
+out_unlock:
+	mutex_unlock(&boot_scanout_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_mcc_boot_scanout_reserve);
+
+/*
+ * Held across a cache controller's final check of its nodes and its
+ * allocation enable, and by the detach notifier. OF flags a node detached
+ * before it calls the notifier, so probe cannot hold a detach off; but the
+ * notifier always runs after the flag is set. Either probe sees the flag,
+ * or it enabled allocation and registered first, and the notifier then
+ * turns allocation off (apple_mcc_boot_dma_lost()).
+ */
+void apple_mcc_boot_dma_lock(void)
+{
+	mutex_lock(&boot_scanout_lock);
+}
+EXPORT_SYMBOL_GPL(apple_mcc_boot_dma_lock);
+
+void apple_mcc_boot_dma_unlock(void)
+{
+	mutex_unlock(&boot_scanout_lock);
+}
+EXPORT_SYMBOL_GPL(apple_mcc_boot_dma_unlock);
+
+/* Under apple_mcc_boot_dma_lock(), once allocation is enabled. */
+void apple_mcc_boot_dma_register_locked(struct apple_mcc_boot_dma_consumer *consumer)
+{
+	list_add_tail(&consumer->link, &enabled_consumers);
+}
+EXPORT_SYMBOL_GPL(apple_mcc_boot_dma_register_locked);
+
+/* Before the consumer turns allocation off and goes. */
+void apple_mcc_boot_dma_unregister(struct apple_mcc_boot_dma_consumer *consumer)
+{
+	mutex_lock(&boot_scanout_lock);
+	list_del_init(&consumer->link);
+	mutex_unlock(&boot_scanout_lock);
+}
+EXPORT_SYMBOL_GPL(apple_mcc_boot_dma_unregister);
+
+/*
+ * Whether detaching @np leaves @consumer's boot DMA unconfirmed: its own
+ * node, or a boot DMA supplier whose boot scanout has not retired. The
+ * detached node no longer resolves, so match its phandle.
+ */
+static bool consumer_loses_boot_dma_locked(struct apple_mcc_boot_dma_consumer *consumer,
+					   struct device_node *np)
+{
+	struct device_node *node = consumer->dev->of_node;
+	struct apple_mcc_scanout *scanout;
+	u32 phandle;
+	int i, n;
+
+	if (node == np)
+		return true;
+	if (!np->phandle)
+		return false;
+	n = of_property_count_u32_elems(node, "apple,boot-dma-devices");
+	for (i = 0; i < n; i++) {
+		if (of_property_read_u32_index(node, "apple,boot-dma-devices", i, &phandle) ||
+		    phandle != np->phandle)
+			continue;
+		scanout = find_scanout_locked(np);
+		return !scanout || !scanout->retired;
+	}
+	return false;
+}
+
+static void waiter_free(struct apple_mcc_scanout_waiter *waiter)
+{
+	of_node_put(waiter->consumer);
+	of_node_put(waiter->supplier);
+	kfree(waiter);
+}
+
+int apple_mcc_boot_scanout_ready(struct device *dev, struct device_node *supplier)
+{
+	struct apple_mcc_scanout_waiter *waiter;
+	struct apple_mcc_scanout *scanout;
+	struct device_node *consumer = dev->of_node;
+	int ret = -EPROBE_DEFER;
+
+	mutex_lock(&boot_scanout_lock);
+	if (node_detached(consumer) || node_detached(supplier)) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	scanout = find_scanout_locked(supplier);
+	if (scanout && scanout->retired) {
+		ret = 0;
+		goto out_unlock;
+	}
+
+	list_for_each_entry(waiter, &waiting_consumers, link) {
+		if (waiter->consumer == consumer && waiter->supplier == supplier)
+			goto out_unlock;
+	}
+	waiter = kzalloc_obj(*waiter);
+	if (!waiter) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
+	waiter->consumer = of_node_get(consumer);
+	waiter->supplier = of_node_get(supplier);
+	list_add_tail(&waiter->link, &waiting_consumers);
+
+out_unlock:
+	mutex_unlock(&boot_scanout_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_mcc_boot_scanout_ready);
+
+static void apple_mcc_retry(struct work_struct *work)
+{
+	struct apple_mcc_scanout_waiter *waiter, *tmp;
+	LIST_HEAD(pending);
+
+	mutex_lock(&boot_scanout_lock);
+	list_splice_tail_init(&retry_consumers, &pending);
+	mutex_unlock(&boot_scanout_lock);
+
+	list_for_each_entry_safe(waiter, tmp, &pending, link) {
+		struct platform_device *pdev = NULL;
+
+		list_del(&waiter->link);
+		mutex_lock(&boot_scanout_lock);
+		if (!node_detached(waiter->consumer) && !node_detached(waiter->supplier))
+			pdev = of_find_device_by_node(waiter->consumer);
+		mutex_unlock(&boot_scanout_lock);
+		if (pdev) {
+			device_initial_probe(&pdev->dev);
+			put_device(&pdev->dev);
+		}
+		waiter_free(waiter);
+	}
+}
+
+static DECLARE_WORK(retry_work, apple_mcc_retry);
+
+void apple_mcc_boot_scanout_retired(struct device_node *supplier)
+{
+	struct apple_mcc_scanout_waiter *waiter, *tmp;
+	struct apple_mcc_scanout *scanout;
+	bool schedule = false;
+
+	mutex_lock(&boot_scanout_lock);
+	/* Reserved by apple_mcc_boot_scanout_reserve(): marking it cannot fail. */
+	scanout = find_scanout_locked(supplier);
+	if (scanout)
+		scanout->retired = true;
+	else
+		WARN_ON_ONCE(!node_detached(supplier));
+
+	list_for_each_entry_safe(waiter, tmp, &waiting_consumers, link) {
+		if (waiter->supplier == supplier) {
+			list_move_tail(&waiter->link, &retry_consumers);
+			schedule = true;
+		}
+	}
+	mutex_unlock(&boot_scanout_lock);
+
+	if (schedule)
+		schedule_work(&retry_work);
+}
+EXPORT_SYMBOL_GPL(apple_mcc_boot_scanout_retired);
+
+static void drop_waiters_locked(struct list_head *list, struct device_node *np)
+{
+	struct apple_mcc_scanout_waiter *waiter, *tmp;
+
+	list_for_each_entry_safe(waiter, tmp, list, link) {
+		if (waiter->consumer == np || waiter->supplier == np) {
+			list_del(&waiter->link);
+			waiter_free(waiter);
+		}
+	}
+}
+
+static int apple_mcc_of_notify(struct notifier_block *nb, unsigned long action, void *arg)
+{
+	struct apple_mcc_boot_dma_consumer *consumer, *next;
+	struct of_reconfig_data *rd = arg;
+	struct apple_mcc_scanout *scanout, *tmp;
+
+	if (action != OF_RECONFIG_DETACH_NODE)
+		return NOTIFY_DONE;
+
+	mutex_lock(&boot_scanout_lock);
+	/* Before the records go: a retired supplier may detach. */
+	list_for_each_entry_safe(consumer, next, &enabled_consumers, link) {
+		if (consumer_loses_boot_dma_locked(consumer, rd->dn)) {
+			list_del_init(&consumer->link);
+			consumer->lost(consumer);
+		}
+	}
+	list_for_each_entry_safe(scanout, tmp, &boot_scanouts, link) {
+		if (scanout->supplier == rd->dn) {
+			list_del(&scanout->link);
+			of_node_put(scanout->supplier);
+			kfree(scanout);
+		}
+	}
+	drop_waiters_locked(&waiting_consumers, rd->dn);
+	drop_waiters_locked(&retry_consumers, rd->dn);
+	mutex_unlock(&boot_scanout_lock);
+	return NOTIFY_OK;
+}
+
+static struct notifier_block apple_mcc_of_nb = {
+	.notifier_call = apple_mcc_of_notify,
+};
+
+static int __init apple_mcc_boot_dma_init(void)
+{
+	/* Without CONFIG_OF_DYNAMIC no node is ever detached. */
+	if (IS_ENABLED(CONFIG_OF_DYNAMIC))
+		return of_reconfig_notifier_register(&apple_mcc_of_nb);
+	return 0;
+}
+core_initcall(apple_mcc_boot_dma_init);
diff --git a/drivers/soc/apple/mcc.c b/drivers/soc/apple/mcc.c
index dcc36d303f6..8bcdfc740ee 100644
--- a/drivers/soc/apple/mcc.c
+++ b/drivers/soc/apple/mcc.c
@@ -18,6 +18,7 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/pm.h>
+#include <linux/soc/apple/mcc.h>
 #include <linux/suspend.h>
 
 #if IS_ENABLED(CONFIG_APPLE_MCC_KUNIT_TEST)
@@ -51,6 +52,7 @@ struct apple_mcc {
 	u32 ways;
 	/* Turned off for a deep sleep, to be turned back on after it. */
 	bool sleep_disabled;
+	struct apple_mcc_boot_dma_consumer boot_dma;
 };
 
 static void apple_mcc_writel(struct apple_mcc *mcc, unsigned int plane,
@@ -136,14 +138,72 @@ static int apple_mcc_enable_t8132(struct apple_mcc *mcc)
 	return 0;
 }
 
+/* An enabled boot framebuffer that names @supplier as its display hardware. */
+static bool apple_mcc_scans_boot_framebuffer(struct device_node *supplier)
+{
+	struct device_node *fb, *display;
+
+	for_each_compatible_node(fb, NULL, "simple-framebuffer") {
+		if (!of_device_is_available(fb))
+			continue;
+		display = of_parse_phandle(fb, "display", 0);
+		of_node_put(display);
+		if (display && display == supplier) {
+			of_node_put(fb);
+			return true;
+		}
+	}
+	return false;
+}
+
 static int apple_mcc_wait_boot_dma(struct device *dev)
 {
 	struct of_phandle_iterator it;
 	int ret;
 
+	/* A detached node's suppliers can no longer be confirmed. */
+	if (of_node_check_flag(dev->of_node, OF_DETACHED))
+		return -ENODEV;
+
 	of_for_each_phandle(&it, ret, dev->of_node, "apple,boot-dma-devices", NULL, 0) {
-		struct platform_device *pdev = of_find_device_by_node(it.node);
-		bool bound = pdev && device_is_bound(&pdev->dev);
+		struct platform_device *pdev;
+		bool bound;
+
+		/*
+		 * An empty entry names no device. A phandle that resolves to
+		 * no node is a device tree error that a retry cannot fix, and
+		 * leaves its boot DMA unconfirmed: keep allocation off.
+		 */
+		if (!it.node) {
+			if (!it.phandle)
+				continue;
+			return dev_err_probe(dev, -EINVAL,
+					     "boot DMA supplier phandle %#x does not resolve\n",
+					     it.phandle);
+		}
+		if (of_node_check_flag(it.node, OF_DETACHED)) {
+			of_node_put(it.node);
+			return -ENODEV;
+		}
+
+		/*
+		 * A display controller scanning out the boot framebuffer keeps
+		 * that DMA running whether or not its node is enabled or bound,
+		 * until its driver reports a displayed swap of its own.
+		 */
+		if (apple_mcc_scans_boot_framebuffer(it.node)) {
+			ret = apple_mcc_boot_scanout_ready(dev, it.node);
+			if (ret) {
+				ret = dev_err_probe(dev, ret,
+						    "waiting for %pOF to retire boot scanout\n",
+						    it.node);
+				of_node_put(it.node);
+				return ret;
+			}
+		}
+
+		pdev = of_find_device_by_node(it.node);
+		bound = pdev && device_is_bound(&pdev->dev);
 
 		if (pdev)
 			put_device(&pdev->dev);
@@ -159,6 +219,29 @@ static int apple_mcc_wait_boot_dma(struct device *dev)
 	return ret == -ENOENT ? 0 : ret;
 }
 
+/* Under apple_mcc_boot_dma_lock(): the last check before allocation is enabled. */
+static bool apple_mcc_boot_dma_detached(struct device *dev)
+{
+	struct of_phandle_iterator it;
+	int ret;
+
+	if (of_node_check_flag(dev->of_node, OF_DETACHED))
+		return true;
+	of_for_each_phandle(&it, ret, dev->of_node, "apple,boot-dma-devices", NULL, 0) {
+		/* The first walk resolved it: a node that went is detached. */
+		if (!it.node) {
+			if (it.phandle)
+				return true;
+			continue;
+		}
+		if (of_node_check_flag(it.node, OF_DETACHED)) {
+			of_node_put(it.node);
+			return true;
+		}
+	}
+	return false;
+}
+
 static bool apple_mcc_plane_ready(struct apple_mcc *mcc, unsigned int plane)
 {
 	void __iomem *regs = mcc->planes[plane];
@@ -254,6 +337,32 @@ static void apple_mcc_quiesce(struct apple_mcc *mcc)
 	mcc->enabled = false;
 }
 
+/* Turn allocation off for good: removal, or a boot DMA node detached. */
+static void apple_mcc_turn_off(struct apple_mcc *mcc)
+{
+	/* Without this driver nothing writes T8132's cache back before a deep sleep. */
+	if (mcc->retained) {
+		apple_mcc_disable_t8132(mcc);
+		mcc->enabled = false;
+		return;
+	}
+	apple_mcc_quiesce(mcc);
+}
+
+/*
+ * The detach notifier, under the boot DMA lock. Only the disable and its
+ * write-back: marked not enabled, nothing later writes this cache back.
+ */
+static void apple_mcc_boot_dma_lost(struct apple_mcc_boot_dma_consumer *consumer)
+{
+	struct apple_mcc *mcc = container_of(consumer, struct apple_mcc, boot_dma);
+
+	dev_warn(mcc->dev, "boot DMA node detached: system level cache allocation off\n");
+	apple_mcc_turn_off(mcc);
+	/* Nor does a wake turn it back on. */
+	mcc->sleep_disabled = false;
+}
+
 static int apple_mcc_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -265,6 +374,9 @@ static int apple_mcc_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	mcc->dev = dev;
+	INIT_LIST_HEAD(&mcc->boot_dma.link);
+	mcc->boot_dma.dev = dev;
+	mcc->boot_dma.lost = apple_mcc_boot_dma_lost;
 	mcc->retained = of_device_is_compatible(dev->of_node, "apple,t8132-mcc");
 	mcc->ways_off = of_device_is_compatible(dev->of_node, "apple,t8142-mcc");
 	while (platform_get_resource(pdev, IORESOURCE_MEM, mcc->nr_planes)) {
@@ -288,14 +400,30 @@ static int apple_mcc_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, mcc);
 
+	/*
+	 * A node detached after this check is flagged before, and notified
+	 * after, the enable below: the notifier finds this controller
+	 * registered and turns allocation off again. The lock is held across
+	 * the enable, including a failed enable's write-back of the planes it
+	 * reached (up to MCC_FLUSH_TIMEOUT_US each), which delays a detach.
+	 */
+	apple_mcc_boot_dma_lock();
+	if (apple_mcc_boot_dma_detached(dev)) {
+		apple_mcc_boot_dma_unlock();
+		return -ENODEV;
+	}
 	/* Allocation is only a performance setting: leave a cache that is not ready alone. */
 	ret = mcc->retained ? apple_mcc_enable_t8132(mcc) : apple_mcc_enable(mcc);
+	if (!ret) {
+		mcc->enabled = true;
+		apple_mcc_boot_dma_register_locked(&mcc->boot_dma);
+	}
+	apple_mcc_boot_dma_unlock();
 	if (ret == -EBUSY)
 		return 0;
 	if (ret)
 		return ret;
 
-	mcc->enabled = true;
 	if (mcc->ways_off)
 		mcc->ways = FIELD_GET(MCC_CACHE_WAYS_ENABLED,
 				      readl(mcc->planes[0] + MCC_CACHE_WAYS));
@@ -307,28 +435,27 @@ static void apple_mcc_remove(struct platform_device *pdev)
 {
 	struct apple_mcc *mcc = platform_get_drvdata(pdev);
 
-	/* Without this driver nothing writes T8132's cache back before a deep sleep. */
-	if (mcc->retained) {
-		apple_mcc_disable_t8132(mcc);
-		mcc->enabled = false;
-		return;
-	}
-	apple_mcc_quiesce(mcc);
+	/* After this, the detach notifier no longer reaches this controller. */
+	apple_mcc_boot_dma_unregister(&mcc->boot_dma);
