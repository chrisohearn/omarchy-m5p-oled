#!/bin/sh
# K114s: keep /boot/efi/m1n1/boot-ctxr.bin a K114s-only Aura Stage 2 that carries the pinned
# K114s device tree, instead of a copy of m1n1/boot.bin (the image's J714s hook copies boot.bin,
# whose packaged K114s tree lacks what the K114s needs, and Aura then refuses to start Linux).
#
# boot.bin is  <Aura Stage 2> <device trees...> <gzip U-Boot>  as update-m1n1 writes it.
# This writes   <Aura Stage 2> <pinned K114s device tree> <the same gzip U-Boot>.
# Any doubt leaves the existing boot-ctxr.bin untouched and exits non-zero.
#
# To go back to the packaged K114s device tree once upstream carries the fixes:
#   touch /usr/local/lib/omarchy-k114s/use-packaged-dtb
# (r3: "k114s-release stage2 --dtb packaged" does this as a recorded, reversible step.)
set -eu
root=${OMARCHY_ROOT:-}
esp=$root/boot/efi/m1n1
boot=$esp/boot.bin
lib=$root/usr/local/lib/omarchy-k114s
# The pinned tree: the copy on the ESP (kept in step with the Stage 2 by the macOS repair tool),
# else the copy linux-persist.sh installed.
pinned=$root/boot/efi/k114s-repair/k114s.dtb
[ -s "$pinned" ] || pinned=$lib/k114s.dtb
m1n1=$root/usr/lib/asahi-boot/m1n1.bin
[ -s "$root/usr/lib/asahi-boot/m1n1-ctxr.bin" ] && m1n1_out=$root/usr/lib/asahi-boot/m1n1-ctxr.bin || m1n1_out=$m1n1
fail() { echo "update-boot-ctxr-k114s: $*; boot-ctxr.bin left as it was" >&2; exit 1; }
be32() { od -An -tu1 -j "$2" -N 4 "$1" | awk '{print (($1*256+$2)*256+$3)*256+$4}'; }
magic() { od -An -tx1 -j "$2" -N 4 "$1" | tr -d ' \n'; }

# r3: k114s-release builds a CANDIDATE beside the configured file, for a one-boot trial (aura-try):
#   K114S_STAGE2_OUT=boot-ctxr-NAME.bin   write m1n1/<that name>; boot-ctxr.bin is not touched
#   K114S_STAGE2_DTB=packaged|pinned      which K114s tree, whatever the use-packaged-dtb marker says
out=boot-ctxr.bin
case ${K114S_STAGE2_OUT:-} in
  '') ;;
  */* | boot-ctxr.bin) fail "K114S_STAGE2_OUT must be a file name boot-ctxr-NAME.bin" ;;
  boot-ctxr-*.bin) out=$K114S_STAGE2_OUT ;;
  *) fail "K114S_STAGE2_OUT must be a file name boot-ctxr-NAME.bin" ;;
esac
packaged=0
[ -e "$lib/use-packaged-dtb" ] && packaged=1
case ${K114S_STAGE2_DTB:-} in
  '') ;;
  packaged) packaged=1 ;;
  pinned) packaged=0 ;;
  *) fail "K114S_STAGE2_DTB must be packaged or pinned" ;;
esac

# r3: once the update tooling is installed (stage2-managed), m1n1/boot-ctxr.bin is written by NOBODY
# but k114s-release, which switches it only after a candidate (K114S_STAGE2_OUT above) has booted
# under the loader's one-boot trial. The pacman hook (96-omarchy-j714s-boot-ctxr.hook) calls this
# with no K114S_STAGE2_OUT; it must not rewrite the one Stage 2 that every boot entry shares,
# whatever packages or use-packaged-dtb say.
managed=$root/etc/omarchy-k114s/stage2-managed
if [ "$out" = boot-ctxr.bin ] && [ -e "$managed" ] && [ -s "$esp/boot-ctxr.bin" ]; then
  echo "update-boot-ctxr-k114s: Stage 2 is managed by k114s-release ($managed exists); m1n1/boot-ctxr.bin left as it is"
  exit 0
fi

# r3: while a new kernel or loader package is on trial, the proven Stage 2 must stay byte for byte
# (it is shared by every boot entry). k114s-release writes this marker before the transaction
# and removes it when the Stage 2 switch has been made on purpose (k114s-release stage2).
frozen=$root/etc/omarchy-k114s/stage2-frozen
if [ "$out" = boot-ctxr.bin ] && [ -e "$frozen" ] && [ -s "$esp/boot-ctxr.bin" ]; then
  echo "update-boot-ctxr-k114s: Stage 2 is frozen ($frozen exists); m1n1/boot-ctxr.bin left as it is"
  exit 0
fi

[ -s "$boot" ] || fail "$boot is missing; is the ESP mounted?"
# Refuse to write to an ESP this boot did not come from (another Omarchy image on a visible disk
# carries the same filesystem IDs). Exit 3 is the only "no"; anything unknowable passes.
if [ -x "$lib/k114s-booted-esp" ]; then
  OMARCHY_ROOT=$root "$lib/k114s-booted-esp" >/dev/null || fail "/boot/efi is not the ESP this boot came from"
fi
[ -s "$m1n1" ] || fail "$m1n1 is missing"
size=$(stat -c %s "$m1n1")
total=$(stat -c %s "$boot")
[ "$total" -gt "$size" ] && cmp -s -n "$size" "$m1n1" "$boot" || fail "$boot does not start with $m1n1"
off=$size
count=0
found_off=
found_len=
while [ "$(magic "$boot" "$off")" = d00dfeed ]; do
  len=$(be32 "$boot" $((off + 4)))
  [ "$len" -ge 40 ] && [ $((off + len)) -le "$total" ] || fail "bad device tree length at $off"
  if dd if="$boot" bs=1M iflag=skip_bytes,count_bytes skip="$off" count="$len" 2>/dev/null | grep -aq 'apple,k114s'; then
    found_off=$off; found_len=$len
  fi
  off=$((off + len)); count=$((count + 1))
  [ "$count" -le 512 ] || fail "too many device trees"
done
[ "$count" -ge 1 ] || fail "no device trees after the Aura Stage 2"
[ "$(od -An -tx1 -j "$off" -N 3 "$boot" | tr -d ' \n')" = 1f8b08 ] || fail "no gzip next stage after the device trees"

tmp=$esp/.$out.k114s-new
trap 'rm -f "$tmp" "$tmp.dtb"' EXIT
if [ "$packaged" = 1 ]; then
  [ -n "$found_off" ] || fail "boot.bin has no apple,k114s device tree"
  dd if="$boot" of="$tmp.dtb" bs=1M iflag=skip_bytes,count_bytes skip="$found_off" count="$found_len" 2>/dev/null
  dtb=$tmp.dtb
else
  dtb=$pinned
fi
[ -s "$dtb" ] || fail "$dtb is missing"
[ "$(magic "$dtb" 0)" = d00dfeed ] && [ "$(be32 "$dtb" 4)" = "$(stat -c %s "$dtb")" ] || fail "$dtb is not one device tree blob"
grep -aq 'apple,k114s' "$dtb" || fail "$dtb is not an apple,k114s device tree"
{ cat "$m1n1_out"; cat "$dtb"; tail -c +"$((off + 1))" "$boot"; } >"$tmp"
out_size=$(stat -c %s "$tmp")
[ "$out_size" -le 16777216 ] || fail "Stage 2 would exceed Aura's 16 MiB slot"
[ "$out_size" -eq $(( $(stat -c %s "$m1n1_out") + $(stat -c %s "$dtb") + total - off )) ] || fail "assembled size is wrong"
sync "$tmp"
mv -f "$tmp" "$esp/$out"
trap - EXIT
rm -f "$tmp.dtb"
echo "update-boot-ctxr-k114s: wrote $esp/$out ($out_size bytes, K114s device tree $(sha256sum "$dtb" | cut -c1-16))"
