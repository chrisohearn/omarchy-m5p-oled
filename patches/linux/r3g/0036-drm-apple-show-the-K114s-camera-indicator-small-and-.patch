From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "K114s (omarchy-m5p-oled)" <k114s@users.noreply.github.com>
Date: Tue, 24 Nov 2026 14:38:30 -0700
Subject: [PATCH 36/37] drm/apple: show the K114s camera indicator small and
 under the notch

The K114s owner found the 48x48 bordered square in the top-right corner too
large and asked for it much smaller and near the camera. On apple,k114s the
indicator is now a solid 32x32 square (the smallest blended surface DCP
accepts), centred horizontally just below the 96-row notch that holds the
camera. The buffer stays 48x48 and only its top-left 32x32 is scanned out.
Every other board keeps the 48x48 corner square.
---
 drivers/gpu/drm/apple/dcp-indicator.c | 44 +++++++++++++++++++++------
 1 file changed, 34 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-indicator.c b/drivers/gpu/drm/apple/dcp-indicator.c
index 9fb3e6d5c959..ee9f1fed43da 100644
--- a/drivers/gpu/drm/apple/dcp-indicator.c
+++ b/drivers/gpu/drm/apple/dcp-indicator.c
@@ -36,6 +36,20 @@
 #define IND_EDGE		0xff000000
 #define IND_PRESENT_TIMEOUT	msecs_to_jiffies(1000)
 
+/*
+ * The K114s (14-inch MacBook Pro, M5 Pro) owner asked for a much smaller square near the camera: there it is a
+ * solid 32x32 (the smallest blended surface DCP takes), centred under the 96-row notch that holds the camera,
+ * instead of the 48x48 bordered square in the top-right corner. The buffer stays 48x48; only its top-left
+ * 32x32 is scanned out.
+ */
+#define IND_COMPACT_SIDE	32
+#define IND_COMPACT_TOP		104
+
+static bool dcp_indicator_compact(void)
+{
+	return of_machine_is_compatible("apple,k114s");
+}
+
 static void dcp_indicator_watch(struct work_struct *work);
 static void dcp_indicator_resume(struct work_struct *work);
 static void dcp_indicator_retry(struct work_struct *work);
@@ -106,15 +120,16 @@ const struct drm_framebuffer_funcs dcp_indicator_fb_funcs = {
 	.create_handle = drm_gem_fb_create_handle,
 };
 
-static void dcp_indicator_paint(u32 *px)
+static void dcp_indicator_paint(u32 *px, bool compact)
 {
 	unsigned int x, y;
 
 	for (y = 0; y < IND_SIDE; y++)
 		for (x = 0; x < IND_SIDE; x++)
 			px[y * IND_SIDE + x] =
-				(x < IND_BORDER || y < IND_BORDER ||
-				 x >= IND_SIDE - IND_BORDER || y >= IND_SIDE - IND_BORDER) ?
+				(!compact &&
+				 (x < IND_BORDER || y < IND_BORDER ||
+				  x >= IND_SIDE - IND_BORDER || y >= IND_SIDE - IND_BORDER)) ?
 				IND_EDGE : IND_FILL;
 }
 
@@ -144,7 +159,7 @@ int dcp_indicator_attach_plane(struct apple_dcp *dcp, struct drm_device *drm,
 	obj = drm_gem_dma_create(drm, PAGE_ALIGN(IND_SIDE * IND_SIDE * 4));
 	if (IS_ERR(obj))
 		return PTR_ERR(obj);
-	dcp_indicator_paint(obj->vaddr);
+	dcp_indicator_paint(obj->vaddr, dcp_indicator_compact());
 
 	fb = kzalloc(sizeof(*fb), GFP_KERNEL);
 	if (!fb) {
@@ -220,12 +235,21 @@ static int dcp_indicator_commit(struct apple_dcp *dcp, bool on, bool wait)
 		drm_atomic_set_fb_for_plane(ps, ci->fb);
 		ps->src_x = 0;
 		ps->src_y = 0;
-		ps->src_w = IND_SIDE << 16;
-		ps->src_h = IND_SIDE << 16;
-		ps->crtc_x = cs->mode.hdisplay - IND_SIDE - IND_MARGIN;
-		ps->crtc_y = IND_MARGIN;
-		ps->crtc_w = IND_SIDE;
-		ps->crtc_h = IND_SIDE;
+		if (dcp_indicator_compact()) {
+			ps->src_w = IND_COMPACT_SIDE << 16;
+			ps->src_h = IND_COMPACT_SIDE << 16;
+			ps->crtc_x = (cs->mode.hdisplay - IND_COMPACT_SIDE) / 2;
+			ps->crtc_y = IND_COMPACT_TOP;
+			ps->crtc_w = IND_COMPACT_SIDE;
+			ps->crtc_h = IND_COMPACT_SIDE;
+		} else {
+			ps->src_w = IND_SIDE << 16;
+			ps->src_h = IND_SIDE << 16;
+			ps->crtc_x = cs->mode.hdisplay - IND_SIDE - IND_MARGIN;
+			ps->crtc_y = IND_MARGIN;
+			ps->crtc_w = IND_SIDE;
+			ps->crtc_h = IND_SIDE;
+		}
 	} else {
 		ret = drm_atomic_set_crtc_for_plane(ps, NULL);
 		if (ret)
