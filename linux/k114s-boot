#!/bin/bash
# K114s (omarchy-m5p-oled): which kernel is Main and which is Backup, and what the next boot does. Read only.
#
#   k114s-boot status        (the default command; needs root to read the ESP, and re-runs itself with sudo -n)
#
# The Limine menu keeps the package names (linux-k114s, linux-k114s-r3b): the macOS repair tool and the boot checks
# find entries by them, and the built-in keyboard does not work in the menu on this Mac. So the roles are shown here:
#   Main    the entry default_entry names (a path, or an index counted as Limine counts it): every ordinary boot
#   Backup  the other kernel entry: the way back (a one-shot from Linux, or the macOS repair tool)
#   Test    the entry a pending Limine one-shot names: the next boot starts it once, then Main again
set -uo pipefail
ESP=${K114S_ESP:-/boot/efi}; CONF=$ESP/limine.conf; EFIVARS=${K114S_EFIVARS:-/sys/firmware/efi/efivars}
BLI=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f; UVAR=$ESP/ubootefi.var
cmd=${1:-status}
[ "$cmd" = status ] || { echo "usage: k114s-boot [status]" >&2; exit 2; }
if [ ! -r "$CONF" ] && [ "$(id -u)" != 0 ] && [ -z "${K114S_ESP:-}" ]; then exec sudo -n "$0" "$@"; fi
[ -r "$CONF" ] || { echo "k114s-boot: cannot read $CONF" >&2; exit 1; }
entry_id() { printf '%s' "$1" | sed 's#/#.#g; s#[^A-Za-z0-9+_.@-]#-#g'; }
efivar() { [ -r "$EFIVARS/$1-$BLI" ] && tail -c +5 "$EFIVARS/$1-$BLI" | iconv -f UTF-16LE -t UTF-8 2>/dev/null | tr -d '\0'; }
opt() { grep -i -m1 "^$1:" "$CONF" | sed 's/^[^:]*:[ \t]*//; s/[ \t]*$//'; }

# INDEX<TAB>PATH<TAB>KERNEL-VERSION in menu order. Hidden entries keep their paths but have a negative index;
# KERNEL-VERSION is empty for entries that boot no kernel (directories, other loaders)
entries=$(awk '
  function flush() { if (n) print idx "\t" p "\t" v; }
  { line = $0; sub(/^[ \t]+/, "", line) }
  line ~ /^\/+/ {
    flush(); match(line, /^\/+/); d = RLENGTH; name = substr(line, d + 1)
    if (collapsed && d <= collapsed) collapsed = 0
    n++; idx = collapsed ? -n : ++visible
    if (!collapsed && name !~ /^\+/) collapsed = d
    sub(/^\+/, "", name); sub(/^[ \t]+/, "", name)
    nm[d] = name; p = nm[1]; for (i = 2; i <= d; i++) p = p "/" nm[i]; v = ""; next
  }
  n && line ~ /^comment:[ \t]*Kernel version:/ { v = line; sub(/^comment:[ \t]*Kernel version:[ \t]*/, "", v); sub(/[ \t]+$/, "", v) }
  END { flush() }' "$CONF")
# default_entry as Limine reads it: the first line that starts with the option name (any case), the value after the
# colon and blanks, verbatim (trailing blanks are part of it)
def=$(awk 'tolower(substr($0, 1, 14)) == "default_entry:" { v = substr($0, 15); sub(/^[ \t]+/, "", v); print v; exit }' "$CONF")
row=
if [ -n "$def" ]; then
  case $def in
    *[!0-9]*) row=$(D=$def awk -F'\t' '($2 "") == (ENVIRON["D"] "") { print; exit }' <<<"$entries") ;;
    *) row=$(D=$def awk -F'\t' '$1 + 0 == ENVIRON["D"] + 0 { print; exit }' <<<"$entries") ;;
  esac
fi
IFS=$'\t' read -r _ defpath defver <<<"$row"
main=; [ -n "$defver" ] && main=$defpath        # Main exists only when default_entry names an entry that boots a kernel
IFS=$'\t' read -r _ e1path e1ver <<<"${entries%%$'\n'*}"

# the pending one-shot: efivarfs, else U-Boot's variable file (UTF-16 strings: the name, then its value)
shot=$(efivar LoaderEntryOneShot); undecoded=
if [ -z "$shot" ] && [ -r "$UVAR" ] && ub=$(strings -a -e l "$UVAR" 2>/dev/null | awk '$0 == "LoaderEntryOneShot" { f = 1; getline v; print v; exit } END { if (!f) exit 1 }'); then
  case $ub in ''|*[!A-Za-z0-9+_.@-]*) undecoded=1 ;; *) shot=$ub ;; esac     # an entry id only; anything else is not decoded
fi
# the booted entry: LoaderEntrySelected names its row; else the row whose kernel version is this kernel's
sel=$(efivar LoaderEntrySelected); run=$(uname -r); selpath=; selver=
if [ -n "$sel" ]; then
  while IFS=$'\t' read -r _ p v; do
    [ -n "$v" ] && [ "$sel" = "$(entry_id "$p")" ] && { selpath=$p; selver=$v; }
  done <<<"$entries"
fi

echo "K114s boot"
while IFS=$'\t' read -r i p v; do
  [ -n "$p" ] && [ -n "$v" ] || continue
  role=Kernel; [ -n "$main" ] && role=Backup
  [ -n "$main" ] && [ "$p" = "$main" ] && role=Main
  [ -n "$shot" ] && [ "$shot" = "$(entry_id "$p")" ] && [ "$role" != Main ] && role=Test   # a one-shot naming the default changes nothing: it stays Main
  now=
  if [ -n "$selpath" ]; then [ "$p" = "$selpath" ] && now="   <- running now"
  elif [ "$v" = "$run" ]; then now="   <- running now (by kernel version)"; fi
  printf '  %-7s %-28s %s%s\n' "$role" "$p" "$v" "$now"
done <<<"$entries"
[ -n "$selpath" ] && [ "$selver" != "$run" ] && echo "  note: Limine booted $selpath (kernel $selver), but this kernel is $run"

if [ -z "$def" ]; then echo "  WARNING: limine.conf has no default_entry"
elif [ -z "$main" ]; then echo "  WARNING: default_entry '$def' names no kernel entry"
else case $def in *[!0-9]*) ;; *) echo "  note: default_entry is index $def, which is $main" ;; esac
fi
case $(opt remember_last_entry | tr 'A-Z' 'a-z') in
  yes|true|1) echo "  note: remember_last_entry is on: Limine may start the entry it booted last, not Main" ;;
esac
# no Main: Limine takes entry 1 when it boots a kernel, else it stops at the menu (the built-in keyboard does not work there)
if [ -n "$main" ]; then fb=Main; idle="Main (no test boot pending)"
elif [ -n "$e1ver" ]; then fb="no Main: Limine boots entry 1 ($e1path)"; idle=$fb
else fb="no Main: Limine would stop at the menu (the built-in keyboard does not work there) unless entry 1 is a kernel entry"; idle=$fb; fi
if [ -n "$shot" ]; then echo "  Next boot: the Test entry once ($shot), then $fb"
elif [ -n "$undecoded" ]; then echo "  Next boot: a one-shot is present in U-Boot's variable file but undecoded (see k114s-boot-once status), then $fb"
else echo "  Next boot: $idle"; fi

if [ -r "$ESP/m1n1/boot-ctxr.bin" ]; then cs=$(sha256sum "$ESP/m1n1/boot-ctxr.bin" | cut -c1-8); else cs=missing; fi
a=; [ -r "$ESP/aura-try" ] && a=$(sed -n 1p "$ESP/aura-try")
case $a in
  armed*) echo "  Stage 2: test file $(sed -n 2p "$ESP/aura-try") armed for the next boot, then the configured m1n1/boot-ctxr.bin ($cs)" ;;
  *) echo "  Stage 2: the configured m1n1/boot-ctxr.bin ($cs)" ;;
esac
[ -e /proc/device-tree/chosen/aurora,trial ] && echo "  This boot is a Stage 2 test: $(tr -d '\0' < /proc/device-tree/chosen/aurora,trial)"
exit 0
