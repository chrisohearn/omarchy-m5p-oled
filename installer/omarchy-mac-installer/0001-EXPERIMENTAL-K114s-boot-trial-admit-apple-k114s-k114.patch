+    # EXPERIMENTAL K114s trial (MacBook Pro 14-inch OLED, M5 Pro, board 0x14).
+    K114S_POLICY = {"kind": "board-macho-ctxr-v1", "qualified_machines": {"k114sap": ["27.2"]}}
+
+    def _k114s_payload(self, stage2=b"aura ctxr stage2 k114s", drop=()):
+        raw = j700_stage1()
+        with zipfile.ZipFile(self.payload) as archive:
+            entries = {name: archive.read(name) for name in archive.namelist()}
+        entries["esp/aurora/stage1-k114s.bin"] = raw
+        entries["esp/aurora/stage1-k114s.macho"] = aura_macho(raw)
+        entries["esp/m1n1/boot-ctxr.bin"] = stage2
+        for name in drop:
+            entries.pop(name)
+        with zipfile.ZipFile(self.payload, "w") as archive:
+            for name, data in entries.items():
+                archive.writestr(name, data)
+        for name, data in entries.items():
+            if name.startswith("esp/"):
+                path = self.installed_esp / name[len("esp/"):]
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_bytes(data)
+        return raw
+
+    def _k114s_metadata(self, policy=None, allowed=("k114sap",)):
+        metadata = self._target_metadata()
+        metadata["allowed_device_classes"] = list(allowed)
+        metadata["aurora_stage1"] = self.K114S_POLICY if policy is None else policy
+        metadata["recovery_gui"] = "omarchy-native-v1"
+        self._write_metadata([metadata])
+
+    def _k114s_installer(self, ipsw="27.2", device_class="k114sap"):
+        installer = FakeInstaller(FakeDiskUtil([[self.free]]))
+        installer.sysinfo = SimpleNamespace(device_class=device_class, sys_firmware="mBoot-20457.60.65.0.1")
+        installer.ipsw.version = ipsw
+        return installer
+
+    def test_k114s_board_row_is_its_own_and_matches_the_j714s_mechanics(self):
+        board = BOARD_MACHO["k114sap"]
+        self.assertEqual(board.raw, "esp/aurora/stage1-k114s.bin")
+        self.assertEqual(board.macho, "esp/aurora/stage1-k114s.macho")
+        self.assertEqual(board.stage2, "esp/m1n1/boot-ctxr.bin")
+        self.assertEqual((board.window_ms, board.os_firmware, board.compress), (15000, "27.2", True))
+        self.assertIn("K114s", board.macs)
+
+    def test_k114s_installs_its_own_filled_mach_o_stage1(self):
+        raw = self._k114s_payload()
+        self._k114s_metadata()
+        installer = self._k114s_installer()
+        adapter = self._adapter(installer)
+        with patch("omarchy_asahi.omarchy_recovery.validate_payload"):
+            adapter.preflight(self.plan)
+        self.assertTrue(adapter.preflight_complete)
+        adapter.prepare_target(self.plan)
+        partition_disk = adapter.osins.partition_disk
+        def with_a_real_esp_uuid(name, size):
+            partition_disk(name, size)
+            adapter.osins.efi_part.uuid = self.J714S_ESP.upper()
+        adapter.osins.partition_disk = with_a_real_esp_uuid
+        with patch("omarchy_asahi.omarchy_recovery.stage") as stage:
+            adapter.install_stub_and_esp(self.plan)
+        boot_object = Path(installer.ins.boot_obj_path).read_bytes()
+        expected_raw = fill_aurora_stage1(raw, self.J714S_ESP, "m1n1/boot-ctxr.bin", 15000)
+        self.assertEqual(boot_object, aura_macho(expected_raw))
+        self.assertIs(stage.call_args.kwargs["macho_compress"], True)
+        self.assertEqual((self.installed_esp / "m1n1/boot-ctxr.bin").read_bytes(), b"aura ctxr stage2 k114s")
+
+    def test_k114s_and_j714s_images_are_never_crossed(self):
+        # A K114s image on a J714s, and a J714s image on a K114s, are refused before any disk write.
+        self._k114s_payload()
+        self._k114s_metadata()
+        installer = self._k114s_installer(device_class="j714sap")
+        adapter = self._adapter(installer)
+        with self.assertRaises(AsahiAdapterError), patch("omarchy_asahi.omarchy_recovery.validate_payload"):
+            adapter.preflight(self.plan)
+        self.assertEqual(installer.dutil.add_calls, [])
+        self._j714s_payload()
+        self._j714s_metadata()
+        installer = self._k114s_installer()
+        adapter = self._adapter(installer)
+        with self.assertRaisesRegex(AsahiAdapterError, "not qualified for this Mac"), patch(
+                "omarchy_asahi.omarchy_recovery.validate_payload"):
+            adapter.preflight(self.plan)
+        self.assertEqual(installer.dutil.add_calls, [])
+
+    def test_k114s_refuses_wrong_firmware_mixed_metadata_and_missing_objects(self):
+        cases = (
+            ("27.3", {}, None, "qualified only on 27.2"),
+            ("27.2", {"drop": ("esp/aurora/stage1-k114s.macho",)}, None, "no Mach-O Stage 1"),
+            ("27.2", {"drop": ("esp/m1n1/boot-ctxr.bin",)}, None, "no esp/m1n1/boot-ctxr.bin"),
+            ("27.2", {"stage2": b""}, None, "empty esp/m1n1/boot-ctxr.bin"),
+            ("27.2", {}, ("k114sap", "j714sap"), "Mach-O Stage 1"),
+        )
+        for ipsw, case, allowed, message in cases:
+            with self.subTest(ipsw=ipsw, case=sorted(case), message=message):
+                self._k114s_payload(**case)
+                if allowed:
+                    self._k114s_metadata(allowed=allowed)
+                else:
+                    self._k114s_metadata()
+                installer = self._k114s_installer(ipsw)
+                adapter = self._adapter(installer)
+                with self.assertRaisesRegex(AsahiAdapterError, message), patch(
+                        "omarchy_asahi.omarchy_recovery.validate_payload"):
+                    adapter.preflight(self.plan)
+                self.assertEqual(installer.dutil.add_calls, [])
+
+    def test_oled_multitouch_machines_also_collects_k_directories(self):
+        from omarchy_asahi import _oled_multitouch_machines
+        seen = []
+
+        class Collection:
+            # asahi_firmware v0.9.2 MultitouchFWCollection.load: "j" machines only
+            def __init__(self, source_path):
+                self.load(source_path)
+
+            def load(self, source_path):
+                for fname in sorted(os.listdir(source_path)):
+                    if fname.startswith("j"):
+                        self.do_machine(fname, os.path.join(source_path, fname))
+
+            def do_machine(self, machine, path):
+                seen.append(machine)
+
+        multitouch = SimpleNamespace(MultitouchFWCollection=Collection)
+        original = Collection.load
+        with tempfile.TemporaryDirectory() as root, patch(
+                "omarchy_asahi.asahi_firmware", SimpleNamespace(multitouch=multitouch)):
+            for machine in ("j714s", "k114s", "x999"):
+                os.mkdir(os.path.join(root, machine))
+            Collection(root)
+            self.assertEqual(seen, ["j714s"])
+            seen.clear()
+            with _oled_multitouch_machines():
+                Collection(root)
+            self.assertEqual(seen, ["j714s", "k114s"])
+            self.assertIs(Collection.load, original)
+
