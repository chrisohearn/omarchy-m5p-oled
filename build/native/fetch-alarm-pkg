#!/bin/bash
# usage: fetch-alarm-pkg PREFIX PKG...   Download Arch Linux ARM packages (extra, then core) from the
# mirror this machine uses, verify the sha256 the repository database records, extract into PREFIX.
# User-local only: nothing is installed system-wide and pacman is not involved.
set -euo pipefail
B=${B:-$HOME/k114s-build}; MIRROR=${MIRROR:-https://arm-mirror.omarchy.org/aarch64}
prefix=$1; shift; mkdir -p "$prefix" "$B/pkgcache/db" "$B/pkgcache/pkg"

check_db() { bsdtar -tf "$1" >/dev/null; }
check_package() { printf '%s  %s\n' "$1" "$2" | sha256sum -c --quiet -; }

fetch_cached() (
  local destination=$1 url=$2 retries=$3 staged
  shift 3
  if [[ -s $destination ]] && "$@" "$destination" 2>/dev/null; then
    return
  fi

  # Keep partial or invalid downloads away from the cache path used by other invocations.
  staged=$(mktemp "$destination.XXXXXX")
  trap 'rm -f -- "$staged" </dev/null' EXIT
  curl -fsSL --retry "$retries" -o "$staged" "$url"
  [[ -s $staged ]] || { echo "fetch-alarm-pkg: empty download from $url" >&2; exit 1; }
  "$@" "$staged"
  mv -fT -- "$staged" "$destination"
)

for repo in extra core; do
  db=$B/pkgcache/db/$repo.db
  fetch_cached "$db" "$MIRROR/$repo/$repo.db" 0 check_db
done
for pkg in "$@"; do
  found=
  for repo in extra core; do
    db=$B/pkgcache/db/$repo.db
    desc=$(bsdtar -tf "$db" | grep -E "^${pkg//+/\\+}-[^-/]+-[^-/]+/desc$" | head -1) || true
    [[ -n $desc ]] || continue
    file=$(bsdtar -xOf "$db" "$desc" | awk '/^%FILENAME%$/{getline; print}')
    sum=$(bsdtar -xOf "$db" "$desc" | awk '/^%SHA256SUM%$/{getline; print}')
    out=$B/pkgcache/pkg/$file
    fetch_cached "$out" "$MIRROR/$repo/${file//:/%3A}" 3 check_package "$sum"
    bsdtar -xf "$out" -C "$prefix" --exclude .PKGINFO --exclude .MTREE --exclude .BUILDINFO --exclude .INSTALL
    echo "$pkg: $file ($repo) -> $prefix"
    found=1; break
  done
  [[ -n $found ]] || { echo "$pkg: not found in extra or core" >&2; exit 1; }
done
