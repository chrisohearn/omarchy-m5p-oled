From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Axboe <axboe@kernel.dk>
Date: Wed, 18 Nov 2026 06:39:40 -0700
Subject: drm/apple: V27 sleep: the DCP's secure port (firmware 27.2)

On T6050 firmware 27.2 the internal display coprocessor has a secure
mailbox port (ADT /arm-io/dcp-exclave-mailbox,
iop,secure-rtbuddy-proxy), as on T8140. With it unanswered the firmware
acknowledges the AP idle and never the IOP idle: the sleep's late stop
fails, and so does the stop and restart in the wake.

- The port may be named by apple,secure-mbox where mboxes must stay the
  one ASC mailbox: the boot loader refuses the display handoff
  otherwise. The driver takes the port's mailbox from that property.
- A coprocessor with the port is no longer refused the V27 sleep. Its
  poller stops at .prepare.
- Late stop: the port's AP idle between the main mailbox's AP idle and
  its IOP idle, polled, interrupts off. Not acknowledged in 5 ms, it
  fails the stop.
- Wake: the stop and restart cycle idles the port the same way and
  stops its poller, which otherwise reads the mailbox with the display's
  domain off (SError). The port is restarted before RUN and turned on
  after the boot.

All of it follows the port's presence, not the board. Tested on a
K116s: with this the IOP idle is acknowledged within 2 ms.

Signed-off-by: Jens Axboe <axboe@kernel.dk>

[re-cut onto the K114s r3d tree]
---
 drivers/gpu/drm/apple/dcp-v27-sleep.inc | 81 +++++++++++++++++++++----
 drivers/gpu/drm/apple/dcp.c             | 27 +++++++--
 2 files changed, 91 insertions(+), 17 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-v27-sleep.inc b/drivers/gpu/drm/apple/dcp-v27-sleep.inc
index 027927a4ec0..acd8358d7f8 100644
--- a/drivers/gpu/drm/apple/dcp-v27-sleep.inc
+++ b/drivers/gpu/drm/apple/dcp-v27-sleep.inc
@@ -250,6 +250,41 @@ static int dcp_v27_ext_cycle_ready(struct apple_dcp *dcp)
 	return dcp->s2r_dcp_dart ? 0 : -ENODEV;
 }
 
+/*
+ * A restart with the secure port (firmware 27.2), as dcp_s2r_warm_restart() does it: the
+ * port restarted before RUN, mapped between the main mailbox's IOP report and its AP on, then on.
+ */
+static int dcp_v27_warm_restart(struct apple_dcp *dcp, bool strict)
+{
+	int ret;
+
+	if (dcp->secure_rtk && dcp->secure_answered) {
+		dcp_secure_poll_stop(dcp);
+		ret = apple_rtkit_port_restart(dcp->secure_rtk);
+		if (ret)
+			dev_warn(dcp->dev, "V27 wake: secure port restart: %d\n", ret);
+	}
+	return strict ? apple_rtkit_warm_restart_strict(dcp->rtk) :
+			apple_rtkit_warm_restart_stopped(dcp->rtk);
+}
+
+static int dcp_v27_boot(struct apple_dcp *dcp)
+{
+	bool secure = dcp->secure_rtk && dcp->secure_answered;
+	int ret;
+
+	ret = apple_rtkit_boot_with(dcp->rtk, secure ? dcp_secure_port_map : NULL, dcp);
+	if (ret || !secure)
+		return ret;
+	ret = dcp->secure_map_ret ?: apple_rtkit_port_on(dcp->secure_rtk, DCP_SECURE_TIMEOUT_MS);
+	if (ret)
+		dev_warn(dcp->dev, "V27 wake: secure port map %d (%lld us), on %d\n",
+			 dcp->secure_map_ret, dcp->secure_map_us, ret);
+	else
+		dcp_secure_poll_start(dcp);
+	return 0;
+}
+
 /*
  * macOS's DCP stop/restart between its wake steps: sessions closed, AP and IOP
  * idle, IDLE_DONE, receive off, CPU_CONTROL RUN off; dart-dcp stopped, the display's domain off and,
@@ -273,7 +308,11 @@ static int dcp_v27_rtkit_cycle(struct apple_dcp *dcp, unsigned int pause_ms)
 	if (s && s->cycle_failed)
 		return -ECANCELED;
 	dcp_v27_sessions(dcp, false);
-	ret = apple_rtkit_idle_strict(dcp->rtk);
+	/* With a secure port: the IOP idle is taken only after the port's AP idle */
+	if (dcp->secure_rtk && dcp->secure_answered)
+		ret = apple_rtkit_idle_strict_with(dcp->rtk, dcp_secure_port_idle_strict, dcp);
+	else
+		ret = apple_rtkit_idle_strict(dcp->rtk);
 	if (ret) {
 		dev_warn(dcp->dev, "V27 wake: RTKit cycle: idle %d\n", ret);
 		dcp_v27_sessions(dcp, true);
@@ -349,12 +388,12 @@ static int dcp_v27_rtkit_cycle(struct apple_dcp *dcp, unsigned int pause_ms)
 				dev_warn(dcp->dev, "V27 wake: RTKit cycle: display DART rewrite %d\n", ret);
 		}
 	}
-	ret = apple_rtkit_warm_restart_strict(dcp->rtk);
+	ret = dcp_v27_warm_restart(dcp, true);
 	if (!ret) {
 		writel(readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL) |
 		       APPLE_DCP_COPROC_CPU_CONTROL_RUN, dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
 		run_status = readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_STATUS);
-		ret = apple_rtkit_boot(dcp->rtk);
+		ret = dcp_v27_boot(dcp);
 	}
 	/*
 	 * An external processor that did not start is not left down: its DART, power words and
@@ -373,13 +412,13 @@ static int dcp_v27_rtkit_cycle(struct apple_dcp *dcp, unsigned int pause_ms)
 			ret = apple_dart_m5_display_cycle(dcp->s2r_dcp_dart, true);
 		}
 		if (!ret)
-			ret = apple_rtkit_warm_restart_stopped(dcp->rtk);
+			ret = dcp_v27_warm_restart(dcp, false);
 		if (!ret) {
 			writel(readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL) |
 			       APPLE_DCP_COPROC_CPU_CONTROL_RUN,
 			       dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
 			run_status = readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_STATUS);
-			ret = apple_rtkit_boot(dcp->rtk);
+			ret = dcp_v27_boot(dcp);
 		}
 	}
 	if (ret) {
@@ -1258,6 +1297,8 @@ static int dcp_v27_reopen_live(struct apple_dcp *dcp)
 	return 0;
 }
 
+static int dcp_v27_secure_idle_atomic(void *data);
+
 static int dcp_v27_late_arm(void *data)
 {
 	struct dcp_v27_sleep *s = data;
@@ -1287,6 +1328,8 @@ static int dcp_v27_late_arm(void *data)
 		ret = apple_rtkit_v27_arm(dcp->rtk, &s->rx);
 		if (ret)
 			dev_info(dcp->dev, "V27 arm: RTKit %d\n", ret);
+		else
+			apple_rtkit_v27_set_after_ap(s->rx, dcp_v27_secure_idle_atomic, dcp);
 	}
 	if (ret) {
 		if (s->display && !s->display_early) {
@@ -1305,6 +1348,20 @@ static int dcp_v27_late_arm(void *data)
 	return 0;
 }
 
+/*
+ * With a secure port (firmware 27.2): its AP idle between the main mailbox's AP idle and
+ * its IOP idle, polled, as this runs with interrupts off. Not acknowledged, it fails the stop:
+ * the firmware would not take the IOP idle.
+ */
+static int dcp_v27_secure_idle_atomic(void *data)
+{
+	struct apple_dcp *dcp = data;
+
+	if (!dcp->secure_rtk || !dcp->secure_answered)
+		return 0;
+	return apple_rtkit_v27_port_ap_idle_atomic(dcp->secure_rtk, 5000);
+}
+
 static int dcp_v27_late_check(void *data)
 {
 	struct dcp_v27_sleep *s = data;
@@ -1439,9 +1496,11 @@ static int dcp_v27_sleep_prepare(struct apple_dcp *dcp)
 		dev_warn(dcp->dev, "V27 sleep: no sleep RPC arguments in the DT\n");
 		return -EOPNOTSUPP;
 	}
-	if (!dcp->retain_dma || IS_ERR_OR_NULL(dcp->rtk) || !dcp->active || dcp->crashed || dcp->quiescing ||
-	    dcp->secure_rtk)
-		return dcp_v27_refuse(dcp, "coprocessor not live (dma, rtkit, active, crashed, quiescing, secure)");
+	if (!dcp->retain_dma || IS_ERR_OR_NULL(dcp->rtk) || !dcp->active || dcp->crashed || dcp->quiescing)
+		return dcp_v27_refuse(dcp, "coprocessor not live (dma, rtkit, active, crashed, quiescing)");
+	/* The secure port is idled from the late stop, with nothing else reading it. */
+	if (dcp->secure_rtk && dcp->secure_answered)
+		dcp_secure_poll_stop(dcp);
 	/* Mode-config suspend is the actual DRM scanout-owner boundary. No HPD
 	 * shortcut: external firmware still executes A484/A500/AFK and late IDLE.
 	 */
@@ -1694,7 +1753,7 @@ static int dcp_v27_sleep_restart(struct apple_dcp *dcp)
 	if (s->phase == V27_STOPPED) {
 		ret = apple_sleep_display_v27_power_ready(dcp->dev);
 		if (!ret)
-			ret = apple_rtkit_warm_restart_strict(dcp->rtk);
+			ret = dcp_v27_warm_restart(dcp, true);
 		/*
 		 * The final step stopped this CPU and it is still stopped: the firmware boots
 		 * from its reset vector next, so the state tracked before the stop does not
@@ -1703,12 +1762,12 @@ static int dcp_v27_sleep_restart(struct apple_dcp *dcp)
 		if (ret == -EUCLEAN && READ_ONCE(dcp->s2r_fw_down) &&
 		    !(readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL) &
 		      APPLE_DCP_COPROC_CPU_CONTROL_RUN))
-			ret = apple_rtkit_warm_restart_stopped(dcp->rtk);
+			ret = dcp_v27_warm_restart(dcp, false);
 		if (ret)
 			return dcp_v27_fail(s, ret);
 		writel(readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL) |
 			APPLE_DCP_COPROC_CPU_CONTROL_RUN, dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
-		ret = apple_rtkit_boot(dcp->rtk);
+		ret = dcp_v27_boot(dcp);
 		if (ret)
 			return dcp_v27_fail(s, ret);
 	}
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index fab0d16d274..e395bbb5b82 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -258,18 +258,24 @@ static void dcp_secure_port_start(struct apple_dcp *dcp)
 }
 
 /* Between the main mailbox's AP idle and its IOP idle. */
-static void dcp_secure_port_idle(void *data)
+static int dcp_secure_port_idle_strict(void *data)
 {
 	struct apple_dcp *dcp = data;
 	int ret;
 
 	if (!dcp->secure_rtk || !dcp->secure_answered)
-		return;
+		return 0;
 
 	dcp_secure_poll_stop(dcp);
 	ret = apple_rtkit_port_idle(dcp->secure_rtk, DCP_SECURE_TIMEOUT_MS);
 	if (ret)
 		dev_warn(dcp->dev, "secure port AP idle not acknowledged: %d\n", ret);
+	return ret;
+}
+
+static void dcp_secure_port_idle(void *data)
+{
+	dcp_secure_port_idle_strict(data);
 }
 
 static void dcp_release_secure_rtkit(void *data)
@@ -286,10 +292,18 @@ static int dcp_secure_port_init(struct apple_dcp *dcp)
 {
 	struct device *dev = dcp->dev;
 
-	if (of_property_match_string(dev->of_node, "mbox-names", "secure") < 0)
+	/*
+	 * The secure mailbox is the second of mboxes, or named by apple,secure-mbox where the
+	 * boot loader wants mboxes to hold the one ASC mailbox (it refuses the display handoff
+	 * otherwise).
+	 */
+	if (of_property_match_string(dev->of_node, "mbox-names", "secure") >= 0)
+		dcp->secure_rtk = apple_rtkit_init(dev, dcp, "secure", 0, &dcp_secure_rtkit_ops);
+	else if (of_property_present(dev->of_node, "apple,secure-mbox"))
+		dcp->secure_rtk = apple_rtkit_init_mbox_prop(dev, dcp, "apple,secure-mbox",
+							     &dcp_secure_rtkit_ops);
+	else
 		return 0;
-
-	dcp->secure_rtk = apple_rtkit_init(dev, dcp, "secure", 0, &dcp_secure_rtkit_ops);
 	if (IS_ERR(dcp->secure_rtk)) {
 		int ret = PTR_ERR(dcp->secure_rtk);
 
@@ -315,7 +329,8 @@ static void dcp_s2r_check_dt(struct apple_dcp *dcp)
 	struct device_node *np = dcp->dev->of_node;
 	bool power = of_property_present(np, "apple,display-power");
 	bool secure = dcp->hw.s2r_no_secure_port ||
-		      of_property_match_string(np, "mbox-names", "secure") >= 0;
+		      of_property_match_string(np, "mbox-names", "secure") >= 0 ||
+		      of_property_present(np, "apple,secure-mbox");
 
 	if (dcp->hw.s2r && (!power || !secure)) {
 		dev_info(dcp->dev, "no %s in the device tree, the firmware keeps running\n",
