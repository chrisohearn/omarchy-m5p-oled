From 650986a045a3a49bd9c6a4da09cdab38355d048d Mon Sep 17 00:00:00 2001
From: k114s-integration <integration@localhost>
Date: Mon, 16 Nov 2026 09:49:31 -0700
Subject: [PATCH 16/34] drm/apple: describe an internal panel without a known
 gamut as Display P3

The EDID built for an internal panel takes its primaries from the
firmware or, without a complete set, from the colour target the ADT's
/product artwork-display-gamut names. A gamut string the driver does
not know leaves no target, and the EDID then carries zero red, green
and blue primaries with only the D65 white.

The K114s (MacBook Pro 14-inch OLED, M5 Pro, firmware 27.2) is such a
panel: its ADT says "Rec2020", with a valid version-1
primary-calibration-matrix. Compositors take the zero primaries at
face value. Hyprland's colour management builds its conversion matrix
from them, the matrix is singular, and every frame comes out black
while the firmware completes each swap.

Every untagged RGB surface on an internal panel is already tagged
P3-D65 (iomfb_template.c: "the panel's own primaries (P3-D65, as its
EDID reports)"). Describe a panel whose ADT names no known space in
that same space, so the EDID and the surface tag agree, and log it.
The Rec2020 string is not mapped to BT.2020 primaries: the firmware is
handed P3-tagged surfaces, so BT.2020 primaries in the EDID would make
compositors encode for a wider space than the one the pixels are
shown in. dcp_panel_edid() keeps its contract (no target, white only)
for its other callers and tests.

KUnit: parser_panel_adt_color_target covers a "Rec2020" ADT (no target
of its own, Display P3 primaries, D65 and gamma 2.2 in the EDID) and a
known gamut keeping its own space.

K114s (MacBook Pro 14-inch OLED, M5 Pro) integration patch, offered
upstream for aurora-silicon/linux#2060. Hardware-untested: compiled,
not booted on any machine.

Co-Authored-By: Claude Opus 5.5 <address-in-upstream-commit@localhost>
---
 drivers/gpu/drm/apple/dcp-display-metadata.c | 13 +++++++++++
 drivers/gpu/drm/apple/dcp-display-metadata.h |  1 +
 drivers/gpu/drm/apple/dcp.c                  |  5 +++-
 drivers/gpu/drm/apple/parser-test.c          | 24 +++++++++++++++++++-
 4 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-display-metadata.c b/drivers/gpu/drm/apple/dcp-display-metadata.c
index bcc3f70d8db7..1e393c2ea9d2 100644
--- a/drivers/gpu/drm/apple/dcp-display-metadata.c
+++ b/drivers/gpu/drm/apple/dcp-display-metadata.c
@@ -198,6 +198,19 @@ const struct dcp_color_space *dcp_panel_gamut_color_space(enum dcp_panel_gamut g
 	}
 }
 
+/*
+ * An internal panel's colour target: the standard space its ADT names, or
+ * else Display P3. Every untagged RGB surface on an internal panel is tagged
+ * P3-D65 (see iomfb_template.c), so a panel whose ADT names no space known
+ * here (the K114s says "Rec2020") is described in the space it is driven in.
+ * Zero primaries are no description: compositors build a singular
+ * conversion matrix from them.
+ */
+const struct dcp_color_space *dcp_panel_color_target(enum dcp_panel_gamut gamut)
+{
+	return dcp_panel_gamut_color_space(gamut) ?: dcp_color_space_lookup("display-p3");
+}
+
 /*
  * Firmware chromaticities win. Without a complete, valid set, use the panel's
  * named target. Without either the block keeps its nominal white only.
diff --git a/drivers/gpu/drm/apple/dcp-display-metadata.h b/drivers/gpu/drm/apple/dcp-display-metadata.h
index 20ba07d691fe..9a12bebaacbf 100644
--- a/drivers/gpu/drm/apple/dcp-display-metadata.h
+++ b/drivers/gpu/drm/apple/dcp-display-metadata.h
@@ -50,6 +50,7 @@ struct dcp_color_space {
 
 const struct dcp_color_space *dcp_color_space_lookup(const char *name);
 const struct dcp_color_space *dcp_panel_gamut_color_space(enum dcp_panel_gamut gamut);
+const struct dcp_color_space *dcp_panel_color_target(enum dcp_panel_gamut gamut);
 
 struct drm_edid;
 struct drm_display_mode;
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 521cf23bfc0d..1b1d46921b5e 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1500,7 +1500,10 @@ static void dcp_panel_read_adt(struct apple_dcp *dcp)
 		dcp->panel.height_mm = panel.height_mm;
 	if (dcp->panel_identity)
 		dcp->panel_identity->adt = panel.identity;
-	dcp->panel.color_target = ret ? NULL : dcp_panel_gamut_color_space(panel.gamut);
+	if (ret || !dcp_panel_gamut_color_space(panel.gamut))
+		dev_info(dcp->dev, "panel ADT: no known colour gamut, EDID primaries default to Display P3\n");
+	dcp->panel.color_target =
+		dcp_panel_color_target(ret ? DCP_PANEL_GAMUT_UNSPECIFIED : panel.gamut);
 	/*
 	 * Whether the panel has EDR headroom at all is the machine's to say: an
 	 * XDR panel's backlight node carries EDRPotentialHeadroom above 1.0, an
diff --git a/drivers/gpu/drm/apple/parser-test.c b/drivers/gpu/drm/apple/parser-test.c
index ee6465678083..1829f63047df 100644
--- a/drivers/gpu/drm/apple/parser-test.c
+++ b/drivers/gpu/drm/apple/parser-test.c
@@ -1655,6 +1655,28 @@ static void parser_panel_adt_color_target(struct kunit *test)
 	for (unsigned int i = 0; i < ARRAY_SIZE(srgb); i++)
 		KUNIT_EXPECT_EQ(test, panel_color_coord(raw, i), srgb[i]);
 
+	/*
+	 * A gamut not known here (the K114s ADT says "Rec2020") gives no
+	 * target of its own: the panel is described as Display P3, the space
+	 * its surfaces are tagged with, never with zero primaries.
+	 */
+	parser_adt_synthetic_matrix(matrix, 1 << 20);
+	size = parser_adt_color_fixture(adt, sizeof(adt), "Rec2020", sizeof("Rec2020"),
+					matrix, sizeof(matrix));
+	panel = (struct dcp_panel_adt) {};
+	KUNIT_ASSERT_EQ(test, dcp_panel_adt_parse(adt, size, &panel), 0);
+	KUNIT_EXPECT_EQ(test, panel.gamut, DCP_PANEL_GAMUT_UNSPECIFIED);
+	KUNIT_EXPECT_NULL(test, dcp_panel_gamut_color_space(panel.gamut));
+	target = dcp_panel_color_target(panel.gamut);
+	KUNIT_EXPECT_PTR_EQ(test, target, dcp_color_space_lookup("display-p3"));
+	raw = panel_color_edid(test, &metadata, target);
+	for (unsigned int i = 0; i < ARRAY_SIZE(p3); i++)
+		KUNIT_EXPECT_EQ(test, panel_color_coord(raw, i), p3[i]);
+	KUNIT_EXPECT_EQ(test, raw->gamma, 120);
+	/* A known gamut keeps its own space. */
+	KUNIT_EXPECT_PTR_EQ(test, dcp_panel_color_target(DCP_PANEL_GAMUT_SRGB),
+			    dcp_color_space_lookup("srgb"));
+
 	/* Unknown, malformed, short, wrong-version, unbounded, non-neutral or singular. */
 	for (unsigned int fault = 0; fault < 7; fault++) {
 		const char *name = fault == 0 ? "AdobeRGB" : "P3";
@@ -1846,7 +1868,7 @@ static void parser_panel_publication(struct kunit *test,
 	dcp->fw_compat = fw_compat;
 	dcp->panel.width_mm = panel.width_mm;
 	dcp->panel.height_mm = panel.height_mm;
-	dcp->panel.color_target = dcp_panel_gamut_color_space(panel.gamut);
+	dcp->panel.color_target = dcp_panel_color_target(panel.gamut);
 	id->adt = panel.identity;
 	dcp->connector = connector;
 	dcp->modes = &mode;
