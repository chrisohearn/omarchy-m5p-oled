From 7352c36eaacef27197c2965d21383889ca7a7ed7 Mon Sep 17 00:00:00 2001
From: Joshua Warren <address-in-upstream-commit@localhost>
Date: Thu, 12 Nov 2026 22:57:34 +0000
Subject: [PATCH 13/34] HID: dockchannel-hid: pad short reports to the clamped
 report size

hid-core refuses a report buffer smaller than the size its parsed layout
implies. After the Report Size clamp that size is 2048 bytes, while the
T6050 multi-touch firmware sends reports of about 437 bytes, so every
report logged "Event data for report 0 was too short" and was dropped.

Copy short reports into a zero-padded per-interface buffer and pass the
true length to hid_safe_input_report(). The buffer exists only on
interfaces that were clamped, and only that interface's ordered workqueue
uses it, so it needs no locking.

If the buffer cannot be allocated, the descriptor is dropped, the same state a failed copy of it leaves, and the
failure is logged.
---
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 38 +++++++++++++++++--
 1 file changed, 34 insertions(+), 4 deletions(-)

diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index b0fc954dc0d3..78d2ae078b91 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -178,6 +178,7 @@ struct dchid_iface {
 
 	void *hid_desc;
 	size_t hid_desc_len;
+	u8 *pad;	/* full-size report buffer, set when Report Size is clamped */
 
 	struct gpio_desc *gpio;
 	char gpio_name[MAX_GPIO_NAME];
@@ -1110,7 +1111,7 @@ static int dchid_create_interface(struct dchid_iface *iface)
  * never looks at the field layout, so clamp every Report Size item to what
  * hid-core accepts instead of failing the whole interface.
  */
-static void dchid_clamp_report_sizes(struct dchid_iface *iface, u8 *desc, size_t len)
+static int dchid_clamp_report_sizes(struct dchid_iface *iface, u8 *desc, size_t len)
 {
 	size_t i = 0;
 
@@ -1122,14 +1123,14 @@ static void dchid_clamp_report_sizes(struct dchid_iface *iface, u8 *desc, size_t
 
 		if (prefix == 0xfe) {
 			if (i + 1 >= len)
-				return;
+				return 0;
 			i += 3 + desc[i + 1];
 			continue;
 		}
 		if (n == 3)
 			n = 4;
 		if (i + 1 + n > len)
-			return;
+			return 0;
 
 		if ((prefix & 0xfc) == 0x74 && n >= 2) {
 			for (j = 0; j < n; j++)
@@ -1138,12 +1139,21 @@ static void dchid_clamp_report_sizes(struct dchid_iface *iface, u8 *desc, size_t
 				dev_info(iface->dchid->dev,
 					 "%s: clamping Report Size %u to %u\n",
 					 iface->name, val, DCHID_MAX_REPORT_SIZE);
+				if (!iface->pad) {
+					iface->pad = devm_kzalloc(iface->dchid->dev,
+								  DCHID_MAX_REPORT_SIZE / 8,
+								  GFP_KERNEL);
+					if (!iface->pad)
+						return -ENOMEM;
+				}
 				for (j = 0; j < n; j++)
 					desc[i + 1 + j] = (DCHID_MAX_REPORT_SIZE >> (8 * j)) & 0xff;
 			}
 		}
 		i += 1 + n;
 	}
+
+	return 0;
 }
 
 static void dchid_handle_descriptor(struct dchid_iface *iface, void *hid_desc, size_t desc_len)
@@ -1169,7 +1179,12 @@ static void dchid_handle_descriptor(struct dchid_iface *iface, void *hid_desc, s
 		devm_kfree(iface->dchid->dev, iface->hid_desc);
 	iface->hid_desc = desc;
 	iface->hid_desc_len = desc_len;
-	dchid_clamp_report_sizes(iface, iface->hid_desc, desc_len);
+	if (dchid_clamp_report_sizes(iface, iface->hid_desc, desc_len)) {
+		/* No padded-report buffer: leave no descriptor, as when its copy fails. */
+		dev_err(iface->dchid->dev, "%s: no memory for the report buffer\n", iface->name);
+		iface->hid_desc = NULL;
+		iface->hid_desc_len = 0;
+	}
 }
 
 static void dchid_handle_ready(struct dockchannel_hid *dchid, void *data, size_t length)
@@ -1411,6 +1426,21 @@ static void dchid_handle_report(struct dchid_iface *iface, void *data, size_t le
 	if (!smp_load_acquire(&iface->open))
 		return;
 
+	/*
+	 * A clamped Report Size makes hid-core expect reports of the clamped
+	 * size. Real reports are shorter, and hid-core refuses a buffer smaller
+	 * than the expected size. Pad into the interface buffer, which only
+	 * this interface's ordered workqueue uses. raw_event() sees the true
+	 * length.
+	 */
+	if (iface->pad && length < DCHID_MAX_REPORT_SIZE / 8) {
+		memcpy(iface->pad, data, length);
+		memset(iface->pad + length, 0, DCHID_MAX_REPORT_SIZE / 8 - length);
+		hid_safe_input_report(iface->hid, HID_INPUT_REPORT, iface->pad,
+				      DCHID_MAX_REPORT_SIZE / 8, length, 1);
+		return;
+	}
+
 	hid_input_report(iface->hid, HID_INPUT_REPORT, data, length, 1);
 }
 
