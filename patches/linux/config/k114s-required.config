# K114s baseline: what the kernel must keep, whatever base or fragment it is built from.
#
# This file is a requirement list for build/validate-config.py, not a change. Every line
# is already true of the running kernel 7.3.0-17.v272-4-ARCH (K114S-R1); the check was run
# against its /proc/config.gz on 2026-11-14. Merging this file into that configuration
# changes nothing. Its purpose is to stop a rebase, a new base config or a later fragment
# from silently dropping something this machine boots with or its K116s-parity work needs.
#
# "=m" means "module or built in". "=y" means the option must be built in: that is kept
# for what has to work before the root file system is open (storage, and the keyboard
# that types the disk passphrase), because this recipe's initramfs is not relied on to
# carry those drivers. Everything else is "=m" even where the running kernel has it
# built in, so the list also holds for a base that builds more as modules.
# Evidence labels: [boot] the machine boots from it (owner-observed 2026-11-14);
# [works] seen working on this K114s with this kernel; [parity] the driver the K116s work
# needs, present as a module here but not bound yet because the K114s device tree does
# not describe the hardware; [recipe] carried over from betizzel/omarchy-m5's
# j714s-required.config.

# --- Kernel identity and module compatibility -------------------------------------------
# [boot] The release must end in -ARCH: the boot bundle finds device trees by that name.
CONFIG_LOCALVERSION="-ARCH"
# [boot] No automatic suffix, or the release string and the module directory change.
# CONFIG_LOCALVERSION_AUTO is not set
# [boot] Modules of the running kernel were built without symbol versions.
# CONFIG_MODVERSIONS is not set
# [boot] Apple Silicon platform, 16K pages (the DART and the GPU driver require them).
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_16K_PAGES=y
# [boot] The GPU, AOP, SEP and RTKit drivers are Rust; without it they vanish.
CONFIG_RUST=y
# [recipe] macOS 27.2 Mach-O Stage 1: Linux runs inside Aura's CTXR execute window.
CONFIG_ARM64_CTXR_EXECMEM=y
# [boot] Per-thread ACTLR state, part of the shared Apple defaults (asahi.config).
CONFIG_ARM64_ACTLR_STATE=y
# [boot] The configuration stays readable at /proc/config.gz; the validator reads it.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Boot path: UKI, initramfs, NVMe, encrypted btrfs root --------------------------------
# [boot] Limine starts the kernel as an EFI application.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# [boot] Modules and the zstd-compressed initramfs.
CONFIG_MODULES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# [boot] Interrupt controller, IOMMU, mailbox, coprocessor runtime.
CONFIG_APPLE_AIC=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
# [boot] Internal NVMe and its SART.
CONFIG_APPLE_SART=y
CONFIG_NVME_APPLE=y
# [boot] Pin control, SPMI, power domains and reset glue.
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_SPMI_APPLE=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_PMGR_MISC=y
# [boot] CPU frequency and idle states.
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_ARM_APPLE_CPUIDLE=y
# [boot] /boot is ext4, the EFI partition is FAT, the root is btrfs on dm-crypt (XTS).
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_BTRFS_FS=m
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=m
# [recipe] dm-integrity, kept from the J714s list.
CONFIG_DM_INTEGRITY=m
# [boot] The boot framebuffer: the only display path until the display coprocessor is on.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- System management controller: sensors, battery, power button, clock ------------------
# [works] SMC core and its GPIOs (the trackpad's reset line is an SMC GPIO).
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=m
# [works] Temperatures and fans (hwmon), battery and charger.
CONFIG_SENSORS_MACSMC_HWMON=m
CONFIG_MACSMC_POWER=m
# [works] Reboot and power off through the SMC.
CONFIG_POWER_RESET_MACSMC=m
# [works] Real-time clock; also the wake alarm for timed sleep tests.
CONFIG_RTC_DRV_MACSMC=m
# [parity] Power button and lid switch events from the SMC (lid close to suspend).
CONFIG_INPUT_MACSMC_INPUT=m
CONFIG_APPLE_WATCHDOG=y

# --- Keyboard, trackpad, keyboard backlight ----------------------------------------------
# [boot] Keyboard and trackpad arrive over DockChannel (MTP). Built in: the keyboard
# has to work at the disk passphrase prompt.
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=m
# [works] Trackpad frames (r1: pull request 1568; r1a: 1830 plus product 0x0361).
CONFIG_HID_MAGICMOUSE=m
# [works] Trackpad haptics.
CONFIG_HID_APPLE_MTP_HAPTIC=m
# [parity] Keyboard backlight PWM (fpwm0), enabled in the tree, not yet observed.
CONFIG_PWM_APPLE=m
CONFIG_LEDS_PWM=y

# --- N1 radio: Wi-Fi and Bluetooth ---------------------------------------------------------
# [works] PCIe host; the loader trains the N1 link.
CONFIG_PCIE_APPLE=y
# [works] N1 control, Wi-Fi (wlan0) and the cfg80211 interface.
CONFIG_APPLE_CENTAURI=m
CONFIG_APPLE_CENTAURI_T6050=m
CONFIG_APPLE_CENTAURI_T6050_WIFI=y
CONFIG_CFG80211=m
# [works] N1 Bluetooth transport (hci0). It has no SCO or ISO; see docs/r3-config.md.
CONFIG_BT_HCICENTAURI=m
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
# [works] Bluetooth keyboards and mice: classic HID (HIDP) and LE HID (through uhid).
CONFIG_BT_HIDP=m
CONFIG_UHID=m

# --- USB-C ----------------------------------------------------------------------------------
# [parity] These drivers load on this machine today (dwc3_apple, phy_apple_atc, sn201202x,
# tps6598x_core in lsmod) but no host controller registers. That is not a configuration gap.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=m
CONFIG_USB_DWC3=m
# [parity] dwc3 must keep host mode. Dual role includes it; "gadget only" would not.
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_DWC3_APPLE=m
# [parity] Type-C port controllers on SPMI (SN201202x) and the ATC PHY.
CONFIG_TYPEC=m
CONFIG_TYPEC_TPS6598X=m
CONFIG_TYPEC_SN201202X=m
CONFIG_PHY_APPLE_ATC=m
# [parity] USB4 and Thunderbolt (linux 1841 for K114c, 1791 for J714s).
CONFIG_USB4=m
CONFIG_USB4_APPLE_SOC=m
# [parity] Storage and input classes for the first device plugged in.
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=m

# --- Display coprocessor (native mode, 120 Hz) and GPU (G17S) -----------------------------
# [parity] apple-drm. T8132 is the method-table family the T6050 display coprocessor uses.
CONFIG_DRM_APPLE=m
CONFIG_DRM_APPLE_DCP_T8132=y
CONFIG_DRM_APPLE_AUDIO=y
CONFIG_APPLE_DART_J713_DCP=y
CONFIG_APPLE_DISPLAY_GATE=y
# [parity] DisplayPort PHYs and the crossbar for the internal panel and USB-C displays.
CONFIG_PHY_APPLE_DPTX=m
CONFIG_PHY_APPLE_T6050_DP=m
CONFIG_MUX_APPLE_DPXBAR=m
# [parity] Panel backlight class (OLED brightness has no working report yet).
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# [parity] The GPU driver. The T6050 path (compatible "apple,agx-g17s") is always part of
# it; CONFIG_DRM_ASAHI_M5 is the T8142 MacBook Air backend and is not needed here.
CONFIG_DRM_ASAHI=m
CONFIG_RUST_APPLE_RTKIT=y
# [parity] The GPU waits for the PMP coprocessor.
CONFIG_APPLE_PMP=m
CONFIG_APPLE_PMP_REPORT=y
CONFIG_APPLE_CLPC=y

# --- Sound ----------------------------------------------------------------------------------
# [parity] No sound card exists today because the K114s tree has no sound nodes; every
# driver below is already installed as a module. Speaker amplifier outputs stay disabled
# in the device tree until this model has protection data: the configuration is not the
# safety control, the device tree is.
CONFIG_SND_SOC_APPLE_MCA=m
CONFIG_SND_SOC_APPLE_MACAUDIO=m
CONFIG_APPLE_ADMAC=m
CONFIG_COMMON_CLK_APPLE_NCO=m
CONFIG_I2C_APPLE=m
# [parity] Headphone jack codec (cs42l84; cs42l83 on older boards).
CONFIG_SND_SOC_CS42L84=m
CONFIG_SND_SOC_CS42L83=m
# [parity] Amplifier driver (tas2764 also drives the sn012776). Present, never bound here.
CONFIG_SND_SOC_TAS2764=m
# [parity] Microphones arrive through the always-on processor (AOP).
CONFIG_APPLE_AOP=m
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
# [recipe] DisplayPort audio and the J714s list's AOP audio variant.
CONFIG_SND_SOC_APPLE_T8152_AOP_AUDIO=m

# --- Camera, video, Neural Engine, Secure Enclave ------------------------------------------
# [parity] Camera (ISP). Needs the K114s sensor row in the loader first.
CONFIG_VIDEO_APPLE_ISP=m
# [parity] Video decoder and encoder.
CONFIG_VIDEO_APPLE_AVD=m
CONFIG_VIDEO_APPLE_AVE=m
CONFIG_DRM_ACCEL_ANE=m
# [parity] Secure Enclave driver (research only on this machine).
CONFIG_APPLE_SEP=m

# --- Sleep, lid, ambient light ---------------------------------------------------------------
# [parity] Suspend-to-idle is the only system sleep on 27.2.
CONFIG_SUSPEND=y
# [parity] Suspend debugging switches (pm_debug_messages, pm_print_times) for bring-up.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# [recipe] Lid angle and ambient light sensors on the AOP.
CONFIG_IIO_AOP_SENSOR_LAS=m
CONFIG_IIO_AOP_SENSOR_ALS=m

# --- Things the installed system already relies on ------------------------------------------
# [recipe] Lets kernel.sched_util_clamp_min_rt_default=0 stop realtime threads (PipeWire)
# from holding the performance cores at top speed.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
# [works] Swap is a zstd zram device (zram-generator).
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
# [works] FUSE, overlay (Docker, AppImage), TUN (Tailscale), virtual Ethernet and bridge.
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
# [works] nftables with the iptables compatibility layer: /usr/bin/iptables here is
# iptables-nft, so ufw, Tailscale and Docker all reach the kernel through nft_compat.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m
# [parity] KVM (reported up on the K116s).
CONFIG_KVM=y
