# Maintainer: none (K114s r3a/r3b candidates; built from a finished kernel tree, see docs/r3-integration.md, docs/r3b-kernel.md)
#
# linux-k114s: the K114s r3a or r3b kernel as its own package, beside linux-aurora and not replacing it.
#
# Everything lands in /usr/lib/modules/<release>/ and the release string (7.3.0-17.v272-4-k114s-r3a-ARCH, or
# 7.3.0-17.v272-11-k114s-r3b-ARCH) differs from linux-aurora's (7.3.0-17.v272-4-ARCH today), so no file is shared and the
# running kernel's module directory stays package-owned (linux-modules-cleanup.service leaves it alone).
# The layout is Arch's: vmlinuz (the raw arm64 Image), pkgbase, modules.*, kernel/, dtbs/ (flat).
# The system's hooks do the rest: pkgbase names the mkinitcpio preset, and the Limine hook builds
# omarchy_<pkgname>.efi.
#
# Package names: r3a is linux-k114s (the installed default). r3b is linux-k114s-r3b, so pacman installs it
# beside r3a instead of replacing it: its own pkgbase file (preset, UKI omarchy_linux-k114s-r3b.efi, Limine
# entry Omarchy/linux-k114s-r3b) and its config under /usr/share/linux-k114s-r3b/ (docs/r3-display-plan.md
# section 3.1). The two share no file.
#
# r3b-b1 (docs/r3-display-plan.md, D5a) is r3b plus the brightness series (patches/linux/r3b-b1.series): the same
# package name and kernel release as r3b, version 7.3.0.r3b.b1-1, so pacman upgrades the D1 package in place and the
# hook rebuilds omarchy_linux-k114s-r3b.efi in place. It adds no package, preset, entry or UKI: the ESP holds the r3a
# and r3b images in the display window and has no room for a third kernel image (section 3.1, G2).
#
# r3b-c1 (docs/r3-hdr.md, issue #92) is r3b-b1 plus the HDR series (patches/linux/r3b-c1.series): the same package name
# and release again, version 7.3.0.r3b.c1-1, so it upgrades r3b.b1 in place the same way.
#
# r3b-c2 (docs/r3b-kernel.md "r3b.c2", aurora-silicon/linux#1615) is r3b-c1 plus sleep-lid/0007, the battery
# manufacture-date fix (patches/linux/r3b-c2.series): version 7.3.0.r3b.c2-1, upgrading r3b.c1 in place.
#
# r3b-c3 (docs/r3-vrr.md) is r3b-c2 plus hdr/0004 (the EDR cap as offered upstream) and vrr/0001 (fw27_panel_vrr_min,
# default 24) (patches/linux/r3b-c3.series): version 7.3.0.r3b.c3-1, upgrading r3b.c2 in place.
#
# r3b-c4 (docs/r3-touchid.md) is r3b-c3 plus sep/0001, which admits the K114s to apple_sep's T6050 profile
# (patches/linux/r3b-c4.series): version 7.3.0.r3b.c4-1, upgrading r3b.c3 in place.
#
# r3b-t1 (docs/r3-touchscreen.md) is the opt-in touchscreen trial. Its separate pkgbase and
# -k114s-r3b-t1-ARCH release keep its boot names and module directory separate from r3b.
#
# This file does not compile anything. It packages a finished build:
#   K114S_CAND  the candidate, r3a, r3b, r3b-b1, r3b-c1 to r3b-c4, r3b-t1, r3c, r3d, r3e   (default r3a, the one the runbook docs/r3-integration.md names;
#               r3b: docs/r3b-kernel.md, K114S_CAND=r3b makepkg ...; r3b-b1: D5a, K114S_CAND=r3b-b1 makepkg ...;
#               r3b-c1: docs/r3-hdr.md, K114S_CAND=r3b-c1 makepkg ...; r3b-c2: docs/r3b-kernel.md,
#               K114S_CAND=r3b-c2 makepkg ...; r3b-c3: docs/r3-vrr.md, K114S_CAND=r3b-c3 makepkg ...;
#               r3b-c4: docs/r3-touchid.md, K114S_CAND=r3b-c4 makepkg ...; r3c: docs/r3c-kernel.md, K114S_CAND=r3c makepkg ...;
#               r3d: docs/r3d-kernel.md, K114S_CAND=r3d makepkg ...; r3e: docs/r3e-kernel.md, K114S_CAND=r3e makepkg ...)
#   K114S_SRC   the kernel source tree      (default $K114S_BUILD_ROOT/src/<candidate>)
#   K114S_OUT   its output directory        (default $K114S_BUILD_ROOT/build/<candidate>)
# with the toolchain of $K114S_BUILD_ROOT (default ~/k114s-build; env.sh and bin/kmake there).
#   source ~/k114s-build/env.sh; cd packaging/linux-k114s
#   BUILDDIR=... PKGDEST=... makepkg -f --nodeps --skipinteg      (no root; takes about a minute)

_cand=${K114S_CAND:-r3a}
# _kcand: the candidate named in the kernel release (...-k114s-<_kcand>-ARCH); _ver: the version after 7.3.0.
case $_cand in
  r3a) pkgname=linux-k114s; _kcand=r3a; _ver=r3a; _rel=2 ;;
  r3b) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b; _rel=1 ;;
  r3b-b1) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b.b1; _rel=1 ;;   # vercmp: 7.3.0.r3b.b1-1 is newer than 7.3.0.r3b-1
  r3b-c1) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b.c1; _rel=1 ;;   # vercmp: 7.3.0.r3b.c1-1 is newer than 7.3.0.r3b.b1-1
  r3b-c2) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b.c2; _rel=1 ;;   # vercmp: 7.3.0.r3b.c2-1 is newer than 7.3.0.r3b.c1-1
  r3b-c3) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b.c3; _rel=1 ;;   # vercmp: 7.3.0.r3b.c3-1 is newer than 7.3.0.r3b.c2-1
  r3b-c4) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b.c4; _rel=1 ;;   # vercmp: 7.3.0.r3b.c4-1 is newer than 7.3.0.r3b.c3-1
  r3b-t1) pkgname=linux-k114s-r3b-t1; _kcand=r3b-t1; _ver=r3b.t1; _rel=1 ;;
  # r3c takes the r3a slot (docs/r3c-kernel.md): linux-k114s 7.3.0.r3a-2 -> 7.3.0.r3c-1 (vercmp: newer), so the ESP keeps
  # two kernel images (r3c and the proven r3b) and the macOS repair tool still finds omarchy_linux-k114s.efi
  r3c) pkgname=linux-k114s; _kcand=r3c; _ver=r3c; _rel=1 ;;
  # r3d (docs/r3d-kernel.md) replaces r3c in the same slot: 7.3.0.r3c-1 -> 7.3.0.r3d-1 (vercmp: newer)
  r3d) pkgname=linux-k114s; _kcand=r3d; _ver=r3d; _rel=1 ;;
  # r3e (docs/r3e-kernel.md) takes the r3b slot, the Backup since r3d became Main (it holds r3c-upstream,
  # 7.3.0.r3c.upstream-1 -> 7.3.0.r3e-1, vercmp: newer). r3d stays in the linux-k114s slot as the way back while r3e
  # is tried by a one-shot; promotion points default_entry at Omarchy/linux-k114s-r3b
  r3e) pkgname=linux-k114s-r3b; _kcand=r3e; _ver=r3e; _rel=1 ;;
  *) echo "K114S_CAND must be r3a, r3b, r3b-b1, r3b-c1 to r3b-c4, r3b-t1, r3c, r3d or r3e" >&2; exit 1 ;;
esac
pkgbase=$pkgname
pkgver=7.3.0.$_ver
pkgrel=$_rel
pkgdesc="K114s (MacBook Pro 14-inch, M5 Pro) kernel candidate $_ver and its modules; installs beside linux-aurora and the other K114s kernel"
arch=('aarch64')
url='https://github.com/chrisohearn/omarchy-m5p-oled'
license=('GPL-2.0-only')
depends=('coreutils' 'kmod' 'initramfs')
options=('!strip' '!debug' '!lto' '!emptydirs')
# no source=(): the kernel tree and its output directory are named by the environment
_root=${K114S_BUILD_ROOT:-$HOME/k114s-build}
_src=${K114S_SRC:-$_root/src/$_cand}
_out=${K114S_OUT:-$_root/build/$_cand}

package() {
  local kernel_release modpath
  kernel_release=$(<"$_out/include/config/kernel.release")
  case $kernel_release in
    *-ARCH) ;;
    *) echo "release '$kernel_release' does not end in -ARCH (boot bundle discovery needs it)" >&2; return 1 ;;
  esac
  [[ $kernel_release != 7.3.0-17.v272-4-ARCH ]] || { echo "release equals linux-aurora's" >&2; return 1; }
  [[ $_kcand != r3b || $kernel_release != 7.3.0-17.v272-4-k114s-r3a-ARCH ]] || { echo "r3b release equals r3a's" >&2; return 1; }
  [[ $kernel_release == *-k114s-${_kcand}-ARCH ]] || { echo "release '$kernel_release' is not a $_kcand release (missing the k114s release suffix?)" >&2; return 1; }
  # r3b-b1 must be built from a tree with the brightness floor (patches/linux/brightness 0006), never from plain r3b
  if [[ $_cand == r3b-b1 || $_cand == r3b-c[1-4] ]]; then
    grep -q 'dcp_bl_set_minimum' "$_src/drivers/gpu/drm/apple/dcp_backlight.h" ||
      { echo "$_src has no brightness series (patches/linux/r3b-b1.series)" >&2; return 1; }
  fi
  # r3b-c1 to r3b-c4 must carry the HDR series (patches/linux/r3b-c1.series) with the K114s 500-nit EDR cap
  if [[ $_cand == r3b-c[1-4] ]]; then
    grep -q 'fw27_panel_edr_max_nits = 500;' "$_src/drivers/gpu/drm/apple/dcp.c" &&
      grep -q 'dcp_panel_color_target' "$_src/drivers/gpu/drm/apple/dcp-display-metadata.c" ||
      { echo "$_src has no HDR series with the 500-nit cap (patches/linux/r3b-c1.series)" >&2; return 1; }
  fi
  # r3c (patches/linux/r3c.series) must carry the series r3b.c4 had, less vrr/0001, plus the light sensor and NVRAM patches
  if [[ $_cand == r3c ]]; then
    grep -q 'dcp_bl_set_minimum' "$_src/drivers/gpu/drm/apple/dcp_backlight.h" &&
      grep -q 'fw27_panel_edr_max_nits = 500;' "$_src/drivers/gpu/drm/apple/dcp.c" &&
      grep -q 'dcp_panel_color_target' "$_src/drivers/gpu/drm/apple/dcp-display-metadata.c" &&
      grep -q 'panel EDR off: cap %u nits set and the SDR maximum is unknown' "$_src/drivers/gpu/drm/apple/dcp.c" &&
      grep -A3 '^static int macsmc_battery_get_date' "$_src/drivers/power/supply/macsmc-power.c" | grep -q 'return -ENODATA;' &&
      grep -q 'apple,k114s' "$_src/drivers/soc/apple/profile.rs" &&
      grep -q 'ALS_SENSOR_BLOB_LEN: usize = 193;' "$_src/drivers/soc/apple/aop.rs" &&
      grep -q '"apple,t6050-qspi", "apple,k114s"' "$_src/drivers/spi/spi-apple-qspi.c" &&
      grep -q 'of_machine_is_compatible("apple,k114s")' "$_src/drivers/pci/controller/pcie-apple.c" ||
      { echo "$_src is not the r3c series (patches/linux/r3c.series)" >&2; return 1; }
  fi
  # r3d (patches/linux/r3d.series) must carry what r3c had, on the new base, plus the speaker-off K114 card, the 27.2
  # GPU firmware entry and the adopted-link s2idle rework (#2488) that replaces r3c 0001's board line
  if [[ $_cand == r3d ]]; then
    grep -q 'dcp_bl_set_minimum' "$_src/drivers/gpu/drm/apple/dcp_backlight.h" &&
      grep -q 'fw27_panel_edr_max_nits = 500;' "$_src/drivers/gpu/drm/apple/dcp.c" &&
      grep -q 'dcp_panel_color_target' "$_src/drivers/gpu/drm/apple/dcp-display-metadata.c" &&
      grep -q 'panel EDR off: cap %u nits set and the SDR maximum is unknown' "$_src/drivers/gpu/drm/apple/dcp.c" &&
      grep -A3 '^static int macsmc_battery_get_date' "$_src/drivers/power/supply/macsmc-power.c" | grep -q 'return -ENODATA;' &&
      grep -q 'apple,k114s' "$_src/drivers/soc/apple/profile.rs" &&
      grep -q 'ALS_SENSOR_BLOB_LEN: usize = 193;' "$_src/drivers/soc/apple/aop.rs" &&
      grep -q '"apple,t6050-qspi", "apple,k114s"' "$_src/drivers/spi/spi-apple-qspi.c" &&
      grep -q 'pm_suspend_no_platform()' "$_src/drivers/pci/controller/pcie-apple.c" &&
      grep -q 'apple,k114-macaudio' "$_src/sound/soc/apple/macaudio.c" &&
      grep -q 'name: "27.2 (26B8125), G17S",' "$_src/drivers/gpu/drm/asahi/hw/t6050.rs" ||
      { echo "$_src is not the r3d series (patches/linux/r3d.series)" >&2; return 1; }
  fi
  # r3e (patches/linux/r3e.series, docs/r3e-kernel.md) must carry what r3d had, on aurora-silicon/linux main. Where main now
  # carries a guarded item itself, the guard checks main's form: the adopted-link s2idle test is #2488's predicate (the
  # K114s qualifies through t6050_hw.adopt_link) and the NVRAM write path is #2817's (a DT nvram partition and a known
  # flash part, so the K114s, which has neither, stays read-only)
  if [[ $_cand == r3e ]]; then
    grep -q 'dcp_bl_set_minimum' "$_src/drivers/gpu/drm/apple/dcp_backlight.h" &&
      grep -q 'fw27_panel_edr_max_nits = 500;' "$_src/drivers/gpu/drm/apple/dcp.c" &&
      grep -q 'dcp_panel_color_target' "$_src/drivers/gpu/drm/apple/dcp-display-metadata.c" &&
      grep -q 'panel EDR off: cap %u nits set and the SDR maximum is unknown' "$_src/drivers/gpu/drm/apple/dcp.c" &&
      grep -A3 '^static int macsmc_battery_get_date' "$_src/drivers/power/supply/macsmc-power.c" | grep -q 'return -ENODATA;' &&
      grep -q 'ALS_SENSOR_BLOB_LEN: usize = 193;' "$_src/drivers/soc/apple/aop.rs" &&
      grep -q 'apple_pcie_adopted_links_ready' "$_src/drivers/pci/controller/pcie-apple.c" &&
      sed -n '/^static const struct hw_info t6050_hw = {/,/^};/p' "$_src/drivers/pci/controller/pcie-apple.c" | grep -q 'adopt_link[[:space:]]*= true' &&
      grep -q 'apple_qspi_find_part' "$_src/drivers/spi/spi-apple-qspi.c" &&
      ! grep -q '0xc8, 0x83, 0x17' "$_src/drivers/spi/spi-apple-qspi-policy.h" &&
      ! grep -q 'apple,k114s' "$_src/drivers/spi/spi-apple-qspi.c" &&
      grep -q 'static bool read_only = true;' "$_src/drivers/spi/spi-apple-qspi.c" &&
      ! grep -rq 'label = "nvram"' "$_src"/arch/arm64/boot/dts/apple/t6050-k114s.dts "$_src"/arch/arm64/boot/dts/apple/t6050-k114-k116.dtsi &&
      grep -q 'apple,k114-macaudio' "$_src/sound/soc/apple/macaudio.c" &&
      grep -q 'name: "27.2 (26B8125), G17S",' "$_src/drivers/gpu/drm/asahi/hw/t6050.rs" ||
      { echo "$_src is not the r3e series (patches/linux/r3e.series)" >&2; return 1; }
    [[ $(grep -c 'name: "27.2 (26B8125), G17S",' "$_src/drivers/gpu/drm/asahi/hw/t6050.rs") == 1 ]] ||
      { echo "$_src has the 26B8125 G17S firmware entry more than once" >&2; return 1; }
  fi
  # r3b-c2 must carry sleep-lid/0007: an unreadable manufacture date is -ENODATA, not -EOPNOTSUPP (aurora-silicon/linux#1615)
  if [[ $_cand == r3b-c[2-4] ]]; then
    grep -A3 '^static int macsmc_battery_get_date' "$_src/drivers/power/supply/macsmc-power.c" | grep -q 'return -ENODATA;' ||
      { echo "$_src has no battery manufacture-date fix (patches/linux/r3b-c2.series, sleep-lid/0007)" >&2; return 1; }
  fi
  # r3b-c3 must carry vrr/0001 (fw27_panel_vrr_min) and hdr/0004 (no EDR with a cap and an unknown SDR maximum)
  if [[ $_cand == r3b-c[34] ]]; then
    grep -q '^module_param(fw27_panel_vrr_min, uint, 0444);' "$_src/drivers/gpu/drm/apple/iomfb.c" &&
      grep -q 'max_nits && !sdr_max' "$_src/drivers/gpu/drm/apple/dcp-edr.h" ||
      { echo "$_src lacks vrr/0001 or hdr/0004 (patches/linux/r3b-c3.series)" >&2; return 1; }
  fi
  # r3b-c4 must carry sep/0001: apple_sep's T6050 profile admits apple,k114s (Touch ID, docs/r3-touchid.md)
  if [[ $_cand == r3b-c4 ]]; then
    grep -q 'has(b"apple,k114s")' "$_src/drivers/soc/apple/profile.rs" ||
      { echo "$_src lacks sep/0001, the K114s in the T6050 SEP profile (patches/linux/r3b-c4.series)" >&2; return 1; }
  fi
  if [[ $_cand == r3b-t1 ]]; then
    # The loadable driver needs the built-in Kiwi transport and receive ring,
    # the T6050 pinctrl implementation, and both MTP DART streams.
    local dchid="$_src/drivers/hid/dockchannel-hid/dockchannel-hid.c"
    local mtp_dts="$_src/arch/arm64/boot/dts/apple/t6050-k114-k116.dtsi"
    local dart_streams='^[[:space:]]*iommus[[:space:]]*=[[:space:]]*<&mtp_dart 0>, <&mtp_dart 1>;[[:space:]]*$'
    grep -Fq 'KIWI_START_TIMEOUT_MS' "$dchid" &&
      grep -Fq 'dchid->use_rx_ring' "$dchid" &&
      grep -Fq 'dchid_drain_ring_rechecked' "$dchid" &&
      grep -Fq 'apple_gpio_t6050_hw' "$_src/drivers/pinctrl/pinctrl-apple-gpio.c" &&
      grep -Fq 'apple,t6050-dockchannel-hid' "$mtp_dts" &&
      sed -n '/^&mtp[[:space:]]*{/,/^};/p' "$mtp_dts" | grep -Eq "$dart_streams" &&
      sed -n '/^[[:space:]]*mtp_hid:/,/^[[:space:]]*};/p' "$mtp_dts" | grep -Eq "$dart_streams" ||
      { echo "$_src lacks the touchscreen transport, pinctrl or DART changes (patches/linux/r3b-t1.series)" >&2; return 1; }
    [[ -s "$_out/drivers/hid/hid-apple-mtp-kiwi.ko" ]] &&
      grep -Fxq 'drivers/hid/hid-apple-mtp-kiwi.o' "$_out/modules.order" ||
      { echo "$_out lacks the built Kiwi module (CONFIG_HID_APPLE_MTP_KIWI=m)" >&2; return 1; }
  fi
  modpath="$pkgdir/usr/lib/modules/$kernel_release"

  # vmlinuz: the uncompressed Image, as linux-aurora ships it
  install -Dm644 "$_out/arch/arm64/boot/Image" "$modpath/vmlinuz"

  # modules, stripped of debug info; kbuild runs depmod for the new tree
  ( cd "$_src" && "$_root/bin/kmake" O="$_out" INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
      DEPMOD=/usr/bin/depmod modules_install )
  # the build and source links point into the build area
  rm -f "$modpath/build" "$modpath/source"

  # device trees, flat, and exactly the 46 that linux-aurora ships (dtbs.list): update-m1n1 puts every
  # dtbs/*.dtb of the newest -ARCH directory into m1n1/boot.bin, so the set must not grow.
  # t6050-k114s.dtb here is the kernel tree's own; the Stage 2 (boot-ctxr.bin) carries the pinned
  # tree built from dts/, not this file.
  install -dm755 "$modpath/dtbs"
  while read -r dtb; do
    install -m644 "$_out/arch/arm64/boot/dts/apple/$dtb" "$modpath/dtbs/$dtb"
  done < "$startdir/dtbs.list"

  # names the mkinitcpio preset; Limine uses the matching package name
  echo "$pkgbase" | install -Dm644 /dev/stdin "$modpath/pkgbase"

  # the file the kernel and modules were built from, for the record
  install -Dm644 "$_out/.config" "$pkgdir/usr/share/$pkgname/config-$kernel_release"
}
