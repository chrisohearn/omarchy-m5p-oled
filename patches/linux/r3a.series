display-gpu/0006-drm-apple-scope-the-120-Hz-mode-gate-to-the-T6050-in.patch
display-gpu/0009-dt-bindings-display-apple-dcp-accept-K-board-panel-c.patch
display-gpu/0010-dt-bindings-gpu-apple-agx-Tell-the-two-G17S-layouts-.patch
