+{
+	int i = 0;
+
+	if (from) {
+		while (nodes[i] != from)
+			i++;
+		of_node_put(from);
+		i++;
+	}
+	for (; i < nnodes; i++)
+		if (nodes[i]->fb)
+			return get(nodes[i]);
+	return NULL;
+}
