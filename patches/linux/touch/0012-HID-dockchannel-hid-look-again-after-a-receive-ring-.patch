From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Sun, 15 Nov 2026 19:25:26 +0000
Subject: [PATCH 12/12] HID: dockchannel-hid: look again after a receive ring
 doorbell

The ring is read only when a zero-length notify arrives on the FIFO, and two paths
could leave a frame in the ring until the next one. dchid_dispatch() accepted the
doorbell from the comm interface only, and dchid_handle_packet() drained once and
re-armed the interrupt without looking again, although the drain also stops at an
empty ring or an incomplete frame.

Accept the doorbell from any interface. After a drain that found nothing, look
once more at once; after a drain that stopped on a partial frame, look again up
to two more times, 100 us apart. Only the partial-frame case sleeps: the
doorbell is the only wake source and an empty ring is the common case after a
doorbell that the previous drain already served, so a timer wakeup for each of
those would add to the IRQ thread's load. The rechecks stop when the device is
stopping, so a frame that arrives in that window of up to about 200 us is
dropped at teardown. The decisions are helpers in dockchannel-hid-protocol.h
with three KUnit cases, and each doorbell and drain logs its ring indices at
debug level.

Signed-off-by: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
(cherry picked from commit 867f5174d65a1402c8630b227600fc2ef4cfea57)
---
 .../dockchannel-hid-parser-test.c             | 12 +++-
 .../dockchannel-hid-protocol-test.c           | 35 ++++++++++
 .../dockchannel-hid-protocol.h                | 35 ++++++++++
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 65 ++++++++++++++-----
 4 files changed, 130 insertions(+), 17 deletions(-)

diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid-parser-test.c b/drivers/hid/dockchannel-hid/dockchannel-hid-parser-test.c
index 1ad95d4f03..95e150372a 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid-parser-test.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid-parser-test.c
@@ -223,6 +223,14 @@ static void dchid_unaligned_checksum_test(struct kunit *test)
 	}
 }
 
+/* dchid_drain_ring() also reports whether it stopped on a partial frame; these tests do not look at that. */
+static int dchid_test_drain(struct dockchannel_hid *dchid)
+{
+	bool partial;
+
+	return dchid_drain_ring(dchid, &partial);
+}
+
 /* A ring whose next frame straddles the end of the data area. */
 static void *dchid_test_ring(struct kunit *test, u32 consumer, u32 producer)
 {
@@ -267,7 +275,7 @@ static void dchid_ring_wrap_test(struct kunit *test)
 	memcpy(data + consumer, &frame, 12);
 	memcpy(data, (u8 *)&frame + 12, sizeof(frame) - 12);
 
-	KUNIT_EXPECT_EQ(test, dchid_drain_ring(iface->dchid), 0);
+	KUNIT_EXPECT_EQ(test, dchid_test_drain(iface->dchid), 1);
 	/* The frame arrived whole: its acknowledgment matched the pending command. */
 	KUNIT_EXPECT_TRUE(test, completion_done(&iface->out_complete));
 	KUNIT_EXPECT_EQ(test, iface->dchid->ring_read, sizeof(frame) - 12);
@@ -281,7 +289,7 @@ static void dchid_ring_bad_header_test(struct kunit *test)
 	u8 *data = dchid_test_ring(test, 0, 16);
 
 	memcpy(data, &hdr, sizeof(hdr));
-	KUNIT_EXPECT_EQ(test, dchid_drain_ring(iface->dchid), -EPROTO);
+	KUNIT_EXPECT_EQ(test, dchid_test_drain(iface->dchid), -EPROTO);
 	KUNIT_EXPECT_EQ(test, iface->dchid->ring_read, 0U);
 }
 
diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid-protocol-test.c b/drivers/hid/dockchannel-hid/dockchannel-hid-protocol-test.c
index 8af84b43d5..7e438c6ee2 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid-protocol-test.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid-protocol-test.c
@@ -79,6 +79,38 @@ static void dchid_ring_success_is_not_a_refusal_test(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, dchid_ring_refused(0, true));
 }
 
+static void dchid_ring_doorbell_any_iface_test(struct kunit *test)
+{
+	/* The firmware may address the doorbell to the interface whose frame is queued. */
+	KUNIT_EXPECT_TRUE(test, dchid_notify_wants_drain(true, 0, 0));
+	KUNIT_EXPECT_TRUE(test, dchid_notify_wants_drain(true, 2, 0));
+	KUNIT_EXPECT_TRUE(test, dchid_notify_wants_drain(true, 7, 0));
+	/* A frame with a payload is not a doorbell, and ring frames never are. */
+	KUNIT_EXPECT_FALSE(test, dchid_notify_wants_drain(true, 2, 4));
+	KUNIT_EXPECT_FALSE(test, dchid_notify_wants_drain(false, 0, 0));
+}
+
+static void dchid_ring_empty_doorbell_rechecked_test(struct kunit *test)
+{
+	/* A doorbell that finds nothing is looked at once more, without sleeping. */
+	KUNIT_EXPECT_TRUE(test, dchid_ring_retry_needed(0, false, 0));
+	KUNIT_EXPECT_FALSE(test, dchid_ring_retry_needed(0, false, 1));
+	KUNIT_EXPECT_EQ(test, dchid_ring_recheck_delay_us(false), 0);
+}
+
+static void dchid_ring_partial_frame_rechecked_test(struct kunit *test)
+{
+	int tries;
+
+	/* Frames drained but the next one is still being written: wait and look again. */
+	for (tries = 0; tries < DCHID_RING_RECHECKS; tries++)
+		KUNIT_EXPECT_TRUE(test, dchid_ring_retry_needed(3, true, tries));
+	KUNIT_EXPECT_FALSE(test, dchid_ring_retry_needed(3, true, DCHID_RING_RECHECKS));
+	KUNIT_EXPECT_EQ(test, dchid_ring_recheck_delay_us(true), DCHID_RING_RECHECK_US);
+	/* A clean full drain needs no retry. */
+	KUNIT_EXPECT_FALSE(test, dchid_ring_retry_needed(3, false, 0));
+}
+
 static struct kunit_case dchid_protocol_test_cases[] = {
 	KUNIT_CASE(dchid_pm1_command_test),
 	KUNIT_CASE(dchid_pm2_will_change_test),
@@ -87,6 +119,9 @@ static struct kunit_case dchid_protocol_test_cases[] = {
 	KUNIT_CASE(dchid_ring_refusal_keeps_fifo_test),
 	KUNIT_CASE(dchid_ring_refusal_fails_start_without_fallback_test),
 	KUNIT_CASE(dchid_ring_success_is_not_a_refusal_test),
+	KUNIT_CASE(dchid_ring_doorbell_any_iface_test),
+	KUNIT_CASE(dchid_ring_empty_doorbell_rechecked_test),
+	KUNIT_CASE(dchid_ring_partial_frame_rechecked_test),
 	{}
 };
 
diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid-protocol.h b/drivers/hid/dockchannel-hid/dockchannel-hid-protocol.h
index 612cf4bf70..12d58dedc1 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid-protocol.h
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid-protocol.h
@@ -63,4 +63,39 @@ static inline bool dchid_ring_refused(int ret, bool fifo_fallback)
 	return ret < 0 && fifo_fallback;
 }
 
+#define DCHID_IFACE_COMM		0
+
+/*
+ * Whether a received frame is the FIFO doorbell for the receive ring: a
+ * zero-length NOTIFY frame on the FIFO. The firmware may address it to the
+ * interface whose frame was queued, so the interface is not part of the test.
+ */
+static inline bool dchid_notify_wants_drain(bool fifo, u8 iface, u32 length)
+{
+	return fifo && !length;
+}
+
+/*
+ * A doorbell that finds the ring empty is looked at once more at once. One
+ * that stops on a frame still being written is looked at again up to
+ * DCHID_RING_RECHECKS times, DCHID_RING_RECHECK_US apart, before the frame is
+ * left for the next doorbell. Only the second case sleeps: an empty ring is
+ * the common case after a doorbell that the previous drain already served, and
+ * a timer wakeup for each of those would add to the IRQ thread's load.
+ */
+#define DCHID_RING_RECHECKS		2
+#define DCHID_RING_RECHECK_US		100
+
+static inline bool dchid_ring_retry_needed(int frames, bool partial, int tries)
+{
+	if (partial)
+		return tries < DCHID_RING_RECHECKS;
+	return frames == 0 && tries < 1;
+}
+
+static inline unsigned int dchid_ring_recheck_delay_us(bool partial)
+{
+	return partial ? DCHID_RING_RECHECK_US : 0;
+}
+
 #endif /* _DOCKCHANNEL_HID_PROTOCOL_H */
diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index 86c5c44379..46b186aadb 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -54,7 +54,7 @@ struct dchid_hdr {
 	u16 pad;
 } __packed;
 
-#define IFACE_COMM 0
+#define IFACE_COMM DCHID_IFACE_COMM
 
 #define FLAGS_GROUP GENMASK(7, 6)
 #define FLAGS_REQ GENMASK(5, 0)
@@ -1630,7 +1630,9 @@ static int dchid_dispatch(struct dockchannel_hid *dchid, struct dchid_hdr *hdr,
 
 	if (dchid->use_rx_ring && hdr->channel == DCHID_CHANNEL_NOTIFY) {
 		/* A FIFO notification has no application subheader or report ID. */
-		return fifo && !hdr->length && hdr->iface == IFACE_COMM;
+		dev_dbg(dchid->dev, "notify fifo=%d iface=%u length=%u\n",
+			fifo, hdr->iface, hdr->length);
+		return dchid_notify_wants_drain(fifo, hdr->iface, hdr->length);
 	}
 
 	if (hdr->iface >= MAX_INTERFACES || hdr->length < sizeof(struct dchid_subhdr))
@@ -1681,13 +1683,14 @@ static void dchid_ring_copy(struct dockchannel_hid *dchid, void *dst,
 	memcpy(dst + first, data, length - first);
 }
 
-static int dchid_drain_ring(struct dockchannel_hid *dchid)
+static int dchid_drain_ring(struct dockchannel_hid *dchid, bool *partial)
 {
 	const u32 capacity = dchid->ring_size - DCHID_RING_HEADER_SIZE;
 	u32 *indices = dchid->ring;
 	u32 producer, consumer, available;
-	int size;
+	int size, frames = 0;
 
+	*partial = false;
 	if (!READ_ONCE(dchid->ring_registered)) {
 		/* The firmware can notify before it has the ring address: nothing to read. */
 		dev_dbg(dchid->dev, "Ring notification before registration\n");
@@ -1704,15 +1707,19 @@ static int dchid_drain_ring(struct dockchannel_hid *dchid)
 		dma_rmb();
 		available = producer >= consumer ? producer - consumer :
 			    capacity - consumer + producer;
-		if (available < sizeof(struct dchid_hdr))
-			return 0;
+		if (available < sizeof(struct dchid_hdr)) {
+			*partial = !!available;
+			return frames;
+		}
 		dchid_ring_copy(dchid, dchid->pkt_buf, consumer,
 				sizeof(struct dchid_hdr));
 		size = dchid_frame_size((void *)dchid->pkt_buf);
 		if (size < 0)
 			return size;
-		if (available < size)
-			return 0;
+		if (available < size) {
+			*partial = true;
+			return frames;
+		}
 		dchid_ring_copy(dchid, dchid->pkt_buf, consumer, size);
 		dchid_dispatch(dchid, (void *)dchid->pkt_buf,
 			       dchid->pkt_buf + sizeof(struct dchid_hdr), false);
@@ -1720,19 +1727,50 @@ static int dchid_drain_ring(struct dockchannel_hid *dchid)
 		if (consumer >= capacity)
 			consumer -= capacity;
 		dchid->ring_read = consumer;
+		frames++;
 		/* All frame reads must complete before the producer can reuse it. */
 		mb();
 		WRITE_ONCE(indices[1], consumer);
 		cond_resched();
 	}
-	return 0;
+	return frames;
+}
+
+/*
+ * Drain after a doorbell. The firmware can ring the doorbell before the
+ * producer index (or the whole frame) is visible, and the doorbell is not
+ * repeated: the frame would then wait for the next one. Look again a bounded
+ * number of times while the ring looks empty or the last frame is incomplete.
+ */
+static void dchid_drain_ring_rechecked(struct dockchannel_hid *dchid)
+{
+	int tries = 0;
+	bool partial = false;
+	unsigned int delay;
+	int frames;
+
+	do {
+		frames = dchid_drain_ring(dchid, &partial);
+		if (frames < 0) {
+			dev_err(dchid->dev, "Receive ring failed: %d\n", frames);
+			return;
+		}
+		dev_dbg(dchid->dev, "drain: try %d frames %d partial %d producer %u consumer %u\n",
+			tries, frames, partial,
+			READ_ONCE(((u32 *)dchid->ring)[0]),
+			READ_ONCE(((u32 *)dchid->ring)[1]));
+		if (!dchid_ring_retry_needed(frames, partial, tries++))
+			return;
+		delay = dchid_ring_recheck_delay_us(partial);
+		if (delay)
+			fsleep(delay);
+	} while (!READ_ONCE(dchid->stopping));
 }
 
 static void dchid_handle_packet(void *cookie, size_t avail)
 {
 	struct dockchannel_hid *dchid = cookie;
 	struct dchid_hdr hdr;
-	int ret;
 
 	if (READ_ONCE(dchid->stopping))
 		return;
@@ -1750,11 +1788,8 @@ static void dchid_handle_packet(void *cookie, size_t avail)
 		goto done;
 	}
 
-	if (dchid_dispatch(dchid, &hdr, dchid->pkt_buf, true)) {
-		ret = dchid_drain_ring(dchid);
-		if (ret < 0)
-			dev_err(dchid->dev, "Receive ring failed: %d\n", ret);
-	}
+	if (dchid_dispatch(dchid, &hdr, dchid->pkt_buf, true))
+		dchid_drain_ring_rechecked(dchid);
 
 done:
 	if (!READ_ONCE(dchid->stopping))
-- 
