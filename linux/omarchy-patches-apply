#!/bin/bash
# K114s (omarchy-m5p-oled): put this machine's fixes to Omarchy's own scripts back after an update.
# The Omarchy package (omarchy, or omarchy-dev on Edge; omarchy-mac for the platform data) owns /usr/bin/omarchy-*, and every update
# replaces those files, which drops a local fix. 03-k114s-omarchy-patches.hook runs this after each
# transaction that installs or upgrades that package; omarchy-patches-install runs it once.
#
# Each patch in the patch directory, in name order, is checked as a whole before anything is
# written, and without fuzz:
#   already in the files                   -> left alone (reported if Omarchy now ships it itself)
#   applies exactly                        -> applied
#   neither, but it has a base folder        -> a three-way merge carries its change into Omarchy's
#                                               new files; if that overlaps Omarchy's own change,
#                                               nothing is written
#   neither (Omarchy has changed those lines) -> nothing written; reported
# A patch that is not in place afterwards also raises a desktop notification, since Omarchy's own
# behaviour is back until the patch is refreshed. It never fails the package transaction and
# never leaves .orig or .rej files behind.
set -u
ROOT=${K114S_ROOT:-}
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DIR=${K114S_OMARCHY_PATCHES:-$ROOT/usr/local/lib/omarchy-k114s/omarchy-patches}
say() { echo "K114s Omarchy fixes: $*"; }
skipped=()

# One notification for the run, to each signed-in desktop user. Best effort: it never fails the
# hook. In a fake root only (K114S_ROOT set, as in the tests), K114S_NOTIFY_CMD is run with the
# summary and body instead; on the machine itself it is ignored, so the hook never runs it as root.
notify_skipped() {
  (( ${#skipped[@]} )) || return 0
  local summary body bus uid user
  summary="Omarchy update: ${#skipped[@]} K114s fix(es) not applied"
  body="$(printf '%s\n' "${skipped[@]}")Omarchy's own behaviour is back for these until the patch is refreshed (docs/omarchy-patches.md)."
  if [[ -n $ROOT ]]; then
    [[ -n ${K114S_NOTIFY_CMD:-} ]] && { timeout 10 "$K114S_NOTIFY_CMD" "$summary" "$body" >/dev/null 2>&1 || true; }
    return 0
  fi
  [[ -z $ROOT ]] && command -v notify-send >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1 || return 0
  for bus in /run/user/*/bus; do
    [[ -S $bus ]] || continue
    uid=$(basename "$(dirname "$bus")")
    (( uid >= 1000 )) || continue
    user=$(timeout 5 id -nu "$uid" 2>/dev/null) || continue
    timeout 5 runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
      notify-send -u critical -a "K114s Omarchy fixes" "$summary" "$body" >/dev/null 2>&1 || true
  done
  return 0
}

# shellcheck source=omarchy-patches-lib.sh
. "$HERE/omarchy-patches-lib.sh" 2>/dev/null || { say "omarchy-patches-lib.sh is missing beside $0; nothing checked or written"; exit 0; }
have_patch || { say "GNU patch is not installed (sudo pacman -S patch); nothing checked or written"; exit 0; }

shopt -s nullglob
patches=("$DIR"/*.patch)
if (( ${#patches[@]} == 0 )); then say "none installed in $DIR"; exit 0; fi

for p in "${patches[@]}"; do
  name=$(basename "$p" .patch)
  if is_in "$p"; then
    if applied_here "$p"; then
      say "$name: in place"
    else
      say "$name: Omarchy ships this change itself now; retire the patch (docs/omarchy-patches.md)"
    fi
  elif fits "$p"; then
    if run_patch "$p" -N; then
      record_applied "$p" || say "$name: applied, but its record could not be written; a later take-out will leave it in"
      say "$name: applied"
    else
      say "$name: FAILED while applying; reinstall the Omarchy package to restore its files"
      skipped+=("$name: failed while applying.")
    fi
  else
    case $(three_way "$p" fwd write) in
      noop)
        if applied_here "$p"; then
          say "$name: in place (merged with this Omarchy build's changes)"
        else
          say "$name: Omarchy ships this change itself now; retire the patch (docs/omarchy-patches.md)"
        fi ;;
      clean)
        record_applied "$p" || say "$name: applied, but its record could not be written; a later take-out will leave it in"
        say "$name: applied by a three-way merge with this Omarchy build's changes" ;;
      conflict)
        say "$name: does not fit this Omarchy build: Omarchy changed the same lines, and the three-way merge from its base conflicts. Nothing was written. Check whether Omarchy now has the fix, then refresh or retire the patch (docs/omarchy-patches.md)."
        skipped+=("$name: Omarchy changed the same lines.") ;;
      partial)
        say "$name: Omarchy ships part of this change itself now, and the rest does not fit as it stands. Nothing was written. Refresh or retire the patch (docs/omarchy-patches.md)."
        skipped+=("$name: Omarchy ships part of it now.") ;;
      failed)
        say "$name: could not write the three-way merge; the files written were put back as they were. Nothing changed."
        skipped+=("$name: failed while applying.") ;;
      badbase)
        say "$name: does not fit this Omarchy build, and its base folder does not match it. Nothing was written. Refresh the patch and its base (docs/omarchy-patches.md)."
        skipped+=("$name: does not fit, and its base folder is broken.") ;;
      *)
        say "$name: does not fit this Omarchy build (it changed those lines). Nothing was written. Check whether Omarchy now has the fix, then refresh or retire the patch (docs/omarchy-patches.md)."
        skipped+=("$name: Omarchy changed those lines.") ;;
    esac
  fi
done
notify_skipped
exit 0
