+    def _check_sense_params(self):
+        params = pcm_info(self.idx, self.sense, "c", "hw_params")
+        period = params.get("period_size", "")
+        if (params.get("format") != "S16_LE"
+                or params.get("channels") != str(self.sense_ch)
+                or params.get("rate", "").partition(" ")[0] != str(self.rate)
+                or not period.isdecimal() or int(period) == 0):
+            raise wiring.Refused(f"sense PCM hw_params do not match S16_LE, "
+                                 f"{self.sense_ch} channels at {self.rate} Hz and "
+                                 f"a positive period: {params}")
+        log(f"sense capture accepted S16_LE, {self.sense_ch} channels at "
+            f"{self.rate} Hz, period {period} frames")
+
     def start(self, idx):
