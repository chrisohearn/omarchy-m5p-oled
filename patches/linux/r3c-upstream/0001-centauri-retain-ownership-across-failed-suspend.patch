+int main(void)
+{
+    struct pci_dev fn={.refs=1,.leases=1}, bridge={0};
+    struct pci_bus bus={.fn=&fn}; bridge.subordinate=&bus;
+    struct centauri_t6050_rewake rw={.bridge=&bridge,.control=&fn,
