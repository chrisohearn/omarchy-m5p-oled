From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Axboe <axboe@kernel.dk>
Date: Fri, 13 Nov 2026 07:07:18 -0700
Subject: [PATCH] kboot: T6050: hand the K116s internal panel off on 27.2

The T6050 internal display handoff is refused on any OS firmware but
27.0 ("OS firmware 27.2 is not 27.0"), and pins the one DCP image that
27.0 loads. Everything else it publishes is read from the ADT.

Make the pinned image a table keyed by OS firmware and add the image
the K116s (16" M5 Pro, OLED) runs on the 27.2 stub (26B8125),
3D6C8857-E6F1-3D2E-9DFF-587028AE0C6E. The 27.0 entry is unchanged.

On 27.2 only the internal panel is handed off. The external engines
run the same image there and pass t6050_ext_one(), but with the K116s
device tree dcpext0 then waits for a dependency that never comes and
holds the display subsystem back by 16 s, so they stay with iBoot until
that is sorted out. A per-image flag keeps them on 27.0.

Signed-off-by: Jens Axboe <axboe@kernel.dk>

(cherry picked from commit 023eb3a01a61c4c6c906709c8436092f111d3108)

[K114s integration, chrisohearn/omarchy-m5p-oled: hand-merged onto aura
22b71758 plus betizzel/omarchy-m5's aura-j714s-27.2.patch. That series'
patch 0005 ("kboot: T6050: hand the internal display over on 27.2",
TripleU) changed the same gate: it admits 27.2 and 27.3 beta 1, takes the
image UUID from the ADT, publishes the firmware-compat of the running
firmware and pins C51FB0C8-C45D-39B0-85BC-520E600FC950, the J714s 27.2
(26B123) image. Both are kept: the pin table now has the 27.0 image, the
J714s 27.2 image (external engines handed off, as before) and this
commit's K116s 27.2 (26B8125) image (internal panel only). 27.3 beta 1
stays unpinned. An image that is on neither list is refused as before
and named in the log. Not booted in this merged form.]
---
 src/kboot_display_handoff.c         | 57 +++++++++++++++++++++--------
 tests/t8122_display_host/firmware.h |  1 +
 2 files changed, 43 insertions(+), 15 deletions(-)

diff --git a/src/kboot_display_handoff.c b/src/kboot_display_handoff.c
index 4e7cc77b..c413ec50 100644
--- a/src/kboot_display_handoff.c
+++ b/src/kboot_display_handoff.c
@@ -3241,15 +3241,31 @@ static bool dcp6_dt_describes(void *dt)
  * firmware-27 DCP driver chooses its 27.3 method table and swap layout by (aurora-silicon/linux
  * #1174). As TripleU613's m1n1 for the J714s does (betizzel's 27.3 handoff).
  *
- * 27.2 (26B123, mBoot-20457.41.3) is pinned to its image too, and published with its own
- * apple,firmware-compat <27 2 0>, the key Linux's 27.2 method table is chosen by. The UUID is the
- * IPSW's: in the J714s identity's Firmware/dcp/t605xdcp.im4p, the Mach-O that holds 27.0's pinned
- * UUID (at 0x10f8608, after the 0x10f8000 fileset) sits at 0x1114608 in 26B123, and its UUID
- * appears at the same five places in the payload as 27.0's does. A J714s whose 27.2 ADT names
- * another image keeps simpledrm, and Aura's log says which UUID it named.
+ * 27.2 is pinned to its images too, and published with its own apple,firmware-compat <27 2 0>,
+ * the key Linux's 27.2 method table is chosen by. 27.2 has two restore images with different DCP
+ * images, so the pins are a table keyed by OS firmware (aurora-silicon/aura #226):
+ *  - 26B123 (mBoot-20457.41.3), the J714s image: C51FB0C8-.... The UUID is the IPSW's: in the
+ *    J714s identity's Firmware/dcp/t605xdcp.im4p, the Mach-O that holds 27.0's pinned UUID (at
+ *    0x10f8608, after the 0x10f8000 fileset) sits at 0x1114608 in 26B123, and its UUID appears at
+ *    the same five places in the payload as 27.0's does.
+ *  - 26B8125, the K114/K116 image the K116s runs: 3D6C8857-.... There only the internal panel is
+ *    handed off: with the K116s device tree dcpext0 waits for a dependency that never comes and
+ *    holds the display subsystem back by 16 s (aura #226), so a per-image flag keeps the external
+ *    engines with iBoot.
+ * A machine whose ADT names another image keeps simpledrm, and Aura's log says which UUID it
+ * named.
  */
-#define T6050_DCP_UUID     "64863924-B56B-3E32-87FE-038677F52709"
-#define T6050_DCP_UUID_272 "C51FB0C8-C45D-39B0-85BC-520E600FC950"
+static const struct {
+    u32 os_fw;
+    char uuid[37];
+    bool ext; /* also hand off the external display engines running this image */
+} t6050_images[] = {
+    {V27_0, "64863924-B56B-3E32-87FE-038677F52709", true},
+    /* J714s (14" M5 Pro), 26B123 */
+    {V27_2, "C51FB0C8-C45D-39B0-85BC-520E600FC950", true},
+    /* K116s (16" M5 Pro, OLED), 26B8125: the internal panel only */
+    {V27_2, "3D6C8857-E6F1-3D2E-9DFF-587028AE0C6E", false},
+};
 #define T6050_NDISP     5       /* disp0 reg[0..4] are the dcp's disp-0..disp-4 */
 #define T6050_BW_BASE   0x20000 /* bandwidth agent 0's scratch in the PMC metadata */
 #define T6050_BW_STRIDE 0x4000
@@ -3273,6 +3289,7 @@ static struct {
     const char *gamut;
     char uuid[40];
     const struct fw_version_info *compat;
+    bool ext;
 } t6050;
 
 static const struct fw_version_info t6050_compat_27_3 = {V27_3B, "27.3", {27, 3, 0}, 3, "compat"};
@@ -3333,12 +3350,18 @@ static T6050_INIT int t6050_check_adt(void)
         os_firmware.version != V27_3B)
         bail("OS firmware %s is not 27.0, 27.2 or 27.3 beta 1\n", os_firmware.string);
     t6050.compat = os_firmware.version == V27_3B ? &t6050_compat_27_3 : &os_firmware;
-    const char *pin = os_firmware.version == V27_0   ? T6050_DCP_UUID
-                      : os_firmware.version == V27_2 ? T6050_DCP_UUID_272
-                                                     : NULL;
-    if (!dcp6_is_uuid(uuid, len) || len > sizeof(t6050.uuid) || (pin && strcmp(uuid, pin)))
-        bail("DCP image %s is not %s\n", dcp6_is_uuid(uuid, len) ? uuid : "(none)",
-             pin ? pin : "a UUID");
+    /* 27.3 beta 1 is not pinned: any well-formed UUID, external engines included */
+    bool pinned = os_firmware.version != V27_3B, known = !pinned;
+    t6050.ext = !pinned;
+    if (!dcp6_is_uuid(uuid, len) || len > sizeof(t6050.uuid))
+        bail("DCP image (none) is not a UUID\n");
+    for (size_t i = 0; pinned && i < ARRAY_SIZE(t6050_images); i++)
+        if (os_firmware.version == t6050_images[i].os_fw && !strcmp(uuid, t6050_images[i].uuid)) {
+            known = true;
+            t6050.ext = t6050_images[i].ext;
+        }
+    if (!known)
+        bail("DCP image %s is not one pinned for OS firmware %s\n", uuid, os_firmware.string);
     strcpy(t6050.uuid, uuid);
     dlog("DCP image %s, firmware-compat %s\n", t6050.uuid, t6050.compat->string);
     if (dcp6_adt_u32(nub, "running", &val) || val != 1 || disp0 < 0 ||
@@ -3737,7 +3760,11 @@ static T6050_TEXT void t6050_handoff(void *dt)
             dlog("internal display handed off: firmware %s, bw-scratch 0x%lx+0x%x, %u clock(s), "
                  "%u nits\n",
                  os_firmware.string, t6050.pmc, t6050.bw_offset, t6050.nclk, t6050.nits);
-            t6050_ext_handoff(dt);
+            if (t6050.ext)
+                t6050_ext_handoff(dt);
+            else
+                dlog("external display engines not handed off on firmware %s\n",
+                     os_firmware.string);
             return;
         }
     }
diff --git a/tests/t8122_display_host/firmware.h b/tests/t8122_display_host/firmware.h
index 3ae2cfe8..a8dd1517 100644
--- a/tests/t8122_display_host/firmware.h
+++ b/tests/t8122_display_host/firmware.h
@@ -12,6 +12,7 @@ enum fw_version {
     V26_6_2 = 102,
     V26_7 = 103,
     V27_0 = 104,
+    V27_2 = 105,
 };
 struct fw_version_info {
     enum fw_version version;
