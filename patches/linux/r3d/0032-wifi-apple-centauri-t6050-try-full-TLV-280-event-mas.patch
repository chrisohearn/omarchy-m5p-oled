From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <address-in-upstream-commit@localhost>
Date: Sun, 22 Nov 2026 19:41:31 -0500
Subject: [PATCH 32/93] wifi: apple: centauri: t6050: try full TLV 280 event
 mask on wake with legacy fallback

Command 6 TLV 280 currently hardcodes the 85-event legacy mask on wake
so older Alpha firmware (which rejects TLV 280 lengths >= 87 and event
counts >= 86) accepts the command, leaving newer firmware that supports
91 events without its upper event slots restored after sleep.

Keep the sleep command 6 TLV 280 at the existing 86-byte length
(1 + 85, carrying the 9 filtered sleep events) on every firmware. On
wake, try the 91-event full mask first and fall back to the 85-event
legacy mask on -EREMOTEIO while the Alpha transport remains healthy
(exec stage == 2). Log the refused firmware status once per Wi-Fi
registration via dev_info() when fallback succeeds, without permanently
latching the legacy count so a transient unrelated refusal does not pin
a registration to 85 events.

Extend tools/asahi/centauri-wifi-pm-tests.py to cover legacy fallback
with one-shot dev_info logging, transient wake refusal recovery back to
91 events, full-mask wake acceptance, and sleep-length/fallback-log
negative controls.

Signed-off-by: Diljit Singh <address-in-upstream-commit@localhost>
---
 .../apple/centauri/t6050/centauri_wifi.c      |  50 ++++++--
 tools/asahi/centauri-wifi-pm-tests.py         | 110 ++++++++++++++++--
 2 files changed, 144 insertions(+), 16 deletions(-)

diff --git a/drivers/net/wireless/apple/centauri/t6050/centauri_wifi.c b/drivers/net/wireless/apple/centauri/t6050/centauri_wifi.c
index 92f923c7f2f..2f830a7304c 100644
--- a/drivers/net/wireless/apple/centauri/t6050/centauri_wifi.c
+++ b/drivers/net/wireless/apple/centauri/t6050/centauri_wifi.c
@@ -89,6 +89,7 @@ struct centauri_t6050_wifi {
 	size_t reply_capacity, reply_size;
 	bool stopping, command_failed;
 	bool tx_paused, transport_paused, host_sleep_sent, transport_sleep_sent;
+	bool host_events_fallback_logged;
 	bool scan_abort, connect_abort;
 	u8 scan_sequence;
 	bool connecting, connected, connect_event, disconnect_event;
@@ -2223,14 +2224,21 @@ static int alpha_transport_state(struct centauri_t6050_wifi *wifi, bool asleep)
 	return ret;
 }
 
-static int alpha_host_power(struct centauri_t6050_wifi *wifi, bool asleep)
+#define CEN_HOST_EVENTS_LEGACY	85
+#define CEN_HOST_EVENTS_FULL	91
+
+static int alpha_host_power_send(struct centauri_t6050_wifi *wifi, bool asleep,
+				 u8 event_count)
 {
 	static const u8 sleep_events[] = { 24, 26, 27, 15, 51, 8, 9, 10, 84 };
-	u8 payload[98] = {}, events[86] = {}, sleep_option = 1;
+	u8 payload[3 + 5 + 4 + 1 + CEN_HOST_EVENTS_FULL] = {};
+	u8 events[1 + CEN_HOST_EVENTS_FULL] = {};
+	u8 sleep_option = 1;
 	u16 state = 0;
 	u8 hint = 0;
 	size_t size = 3;
-	int i, ret;
+	unsigned int i;
+	int ret;
 
 	lockdep_assert_held(&wifi->lock);
 	if (readl(wifi->a.bar + 8) != 2)
@@ -2244,16 +2252,40 @@ static int alpha_host_power(struct centauri_t6050_wifi *wifi, bool asleep)
 		events[0] = ARRAY_SIZE(sleep_events);
 		memcpy(events + 1, sleep_events, sizeof(sleep_events));
 	} else {
-		events[0] = sizeof(events) - 1;
-		for (i = 0; i < events[0]; i++)
+		events[0] = event_count;
+		for (i = 0; i < event_count; i++)
 			events[i + 1] = i;
 	}
-	append_tlv(payload, &size, 280, events, sizeof(events));
+	append_tlv(payload, &size, 280, events, 1 + event_count);
 	ret = command(wifi, 6, payload, size);
 	dev_dbg(&wifi->control->pdev->dev,
-		"Alpha firmware host %s (connected=%d state=%u): ret=%d status=%u exec=%u\n",
-		asleep ? "sleep" : "awake", wifi->connected, state, ret,
-		wifi->reply_status, readl(wifi->a.bar + 8));
+		"Alpha firmware host %s (connected=%d state=%u events=%u tlv280=%u): ret=%d status=%u exec=%u\n",
+		asleep ? "sleep" : "awake", wifi->connected, state,
+		events[0], 1 + event_count, ret, wifi->reply_status,
+		readl(wifi->a.bar + 8));
+	return ret;
+}
+
+static int alpha_host_power(struct centauri_t6050_wifi *wifi, bool asleep)
+{
+	u16 full_status;
+	int ret;
+
+	if (asleep)
+		return alpha_host_power_send(wifi, true, CEN_HOST_EVENTS_LEGACY);
+
+	ret = alpha_host_power_send(wifi, false, CEN_HOST_EVENTS_FULL);
+	if (ret == -EREMOTEIO && readl(wifi->a.bar + 8) == 2) {
+		full_status = wifi->reply_status;
+		ret = alpha_host_power_send(wifi, false, CEN_HOST_EVENTS_LEGACY);
+		if (!ret && !wifi->host_events_fallback_logged) {
+			wifi->host_events_fallback_logged = true;
+			dev_info(&wifi->control->pdev->dev,
+				 "Alpha host wake fell back from %u to %u events (status=%u)\n",
+				 CEN_HOST_EVENTS_FULL, CEN_HOST_EVENTS_LEGACY,
+				 full_status);
+		}
+	}
 	return ret;
 }
 
diff --git a/tools/asahi/centauri-wifi-pm-tests.py b/tools/asahi/centauri-wifi-pm-tests.py
