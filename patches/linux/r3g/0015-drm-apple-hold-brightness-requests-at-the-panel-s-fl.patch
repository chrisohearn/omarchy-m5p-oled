+						       dcp->brightness.minimum);
 		if (!ret && iomfb_is_m4(dcp)) {
 			/*
 			 * The J713 panel jumps to new levels, and its first
@@ -327,6 +332,9 @@ int dcp_backlight_configure(struct apple_dcp *dcp, u32 maximum,
 	}
 	spin_unlock_irqrestore(&dcp->backlight.lock, flags);
 	mutex_unlock(&dcp->bl_register_mutex);
+	if (floor_ret)
+		dev_warn(dcp->dev, "brightness floor %u ignored for a ceiling of %u\n",
+			 dcp->brightness.minimum, maximum);
 	if (!ret)
 		schedule_work(&dcp->bl_register_wq);
 	return ret;
@@ -908,6 +916,9 @@ static int dcp_set_brightness(struct backlight_device *bd)
 		old = state->target;
 		ret = dcp_bl_request(state, bd->props.brightness,
 				     backlight_is_blank(bd), suspended);
+		/* Read back the level the panel's floor made of the request. */
+		if (!ret)
+			bd->props.brightness = dcp_bl_floor(state, bd->props.brightness);
 		/* A new level restarts the fade from the level presented last. */
 		fade = !ret && state->fading && state->target != old;
 		if (fade)
diff --git a/drivers/gpu/drm/apple/dcp_backlight.h b/drivers/gpu/drm/apple/dcp_backlight.h
index bb200ace9025..d68ee8127e4e 100644
--- a/drivers/gpu/drm/apple/dcp_backlight.h
+++ b/drivers/gpu/drm/apple/dcp_backlight.h
@@ -17,6 +17,8 @@
  */
 struct dcp_backlight_state {
 	u32 maximum;
+	/* Lowest level a request can reach, 0 for none: dcp_bl_set_minimum(). */
+	u32 minimum;
 	u32 target;
 	u32 level;
 	u32 fade_from;
@@ -99,6 +101,29 @@ static inline int dcp_bl_init(struct dcp_backlight_state *state, u32 maximum,
 	return 0;
 }
 
+/*
+ * A panel node may name the lowest level a brightness request can reach
+ * (apple,min-brightness, in nits).  A request below it, zero included, is
+ * raised to it, so a brightness write alone cannot darken such a panel.
+ * Blanking, DPMS off and suspend are not requests and still present zero.
+ * A loader level below the floor stays until the first request.
+ */
+static inline int dcp_bl_set_minimum(struct dcp_backlight_state *state, u32 minimum)
+{
+	if (!state->ready)
+		return -ENODATA;
+	if (minimum >= state->maximum)
+		return -ERANGE;
+	state->minimum = minimum;
+	return 0;
+}
+
+/* The level a request for @nits reaches on this panel. */
+static inline u32 dcp_bl_floor(const struct dcp_backlight_state *state, u32 nits)
+{
+	return max(nits, state->minimum);
+}
+
 /*
  * A decoded powerlog sample can seed takeover only before Linux control.
  * It reports the level the panel shows, so the level is then known.
@@ -170,6 +195,7 @@ static inline int dcp_bl_request(struct dcp_backlight_state *state, u32 nits,
 		return -ENODATA;
 	if (nits > state->maximum)
 		return -ERANGE;
+	nits = dcp_bl_floor(state, nits);
 	/* Save/restore clients may echo the reporting default without a change. */
 	if (state->preserve_inherited && !state->controlled && !state->level_known &&
 	    state->target == nits) {
diff --git a/drivers/gpu/drm/apple/dcp_backlight_test.c b/drivers/gpu/drm/apple/dcp_backlight_test.c
index e31fa370b3b4..b9f888f44f46 100644
--- a/drivers/gpu/drm/apple/dcp_backlight_test.c
+++ b/drivers/gpu/drm/apple/dcp_backlight_test.c
@@ -84,6 +84,65 @@ static void backlight_range_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dcp_bl_effective(&state), 600U);
 }
 
+static void backlight_floor_test(struct kunit *test)
+{
+	struct dcp_backlight_state state = {};
+	struct dcp_backlight_present present;
+
+	KUNIT_EXPECT_EQ(test, dcp_bl_set_minimum(&state, 10), -ENODATA);
+	KUNIT_ASSERT_EQ(test, dcp_bl_init(&state, 1000, false, 0, true, 500), 0);
+	KUNIT_EXPECT_EQ(test, dcp_bl_set_minimum(&state, 1000), -ERANGE);
+	KUNIT_EXPECT_EQ(test, state.minimum, 0U);
+	/* Without a floor zero is a level like any other. */
+	state.controlled = true;
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 0, false, false), 0);
+	KUNIT_EXPECT_EQ(test, state.target, 0U);
+
+	/* With one, zero and every level below it become the floor. */
+	KUNIT_ASSERT_EQ(test, dcp_bl_init(&state, 1000, false, 0, true, 500), 0);
+	KUNIT_ASSERT_EQ(test, dcp_bl_set_minimum(&state, 10), 0);
+	state.controlled = true;
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 0, false, false), 0);
+	KUNIT_EXPECT_EQ(test, state.target, 10U);
+	KUNIT_ASSERT_EQ(test, dcp_bl_prepare(&state, true, &present), 0);
+	KUNIT_EXPECT_EQ(test, present.nits, 10U);
+	KUNIT_EXPECT_TRUE(test, dcp_bl_complete(&state, present.sequence, true));
+	KUNIT_EXPECT_EQ(test, state.actual, 10U);
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 9, false, false), 0);
+	KUNIT_EXPECT_EQ(test, state.target, 10U);
+	KUNIT_EXPECT_EQ(test, dcp_bl_prepare(&state, true, &present), -EALREADY);
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 11, false, false), 0);
+	KUNIT_EXPECT_EQ(test, state.target, 11U);
+	KUNIT_EXPECT_EQ(test, dcp_bl_request(&state, 1001, false, false), -ERANGE);
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 1000, false, false), 0);
+	KUNIT_EXPECT_EQ(test, state.target, 1000U);
+
+	/* Display off is not a request: it presents zero and wakes at the floor. */
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 0, false, false), 0);
+	KUNIT_ASSERT_EQ(test, dcp_bl_dpms(&state, false), 0);
+	KUNIT_ASSERT_EQ(test, dcp_bl_prepare(&state, true, &present), 0);
+	KUNIT_EXPECT_EQ(test, present.nits, 0U);
+	KUNIT_EXPECT_TRUE(test, dcp_bl_complete(&state, present.sequence, true));
+	KUNIT_ASSERT_EQ(test, dcp_bl_dpms(&state, true), 0);
+	KUNIT_ASSERT_EQ(test, dcp_bl_prepare(&state, true, &present), 0);
+	KUNIT_EXPECT_EQ(test, present.nits, 10U);
+	KUNIT_EXPECT_TRUE(test, dcp_bl_complete(&state, present.sequence, true));
+
+	/* So is a core blank, whatever level comes with it. */
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 0, true, false), 0);
+	KUNIT_EXPECT_EQ(test, dcp_bl_effective(&state), 0U);
+	KUNIT_EXPECT_EQ(test, state.target, 10U);
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 0, false, false), 0);
+	KUNIT_EXPECT_EQ(test, dcp_bl_effective(&state), 10U);
+
+	/* A loader level below the floor stays until the first request. */
+	KUNIT_ASSERT_EQ(test, dcp_bl_init(&state, 1000, true, 4, false, 0), 0);
+	KUNIT_ASSERT_EQ(test, dcp_bl_set_minimum(&state, 10), 0);
+	KUNIT_EXPECT_EQ(test, dcp_bl_effective(&state), 4U);
+	KUNIT_ASSERT_EQ(test, dcp_bl_request(&state, 4, false, false), 0);
+	KUNIT_EXPECT_EQ(test, state.target, 10U);
+}
+
 static void backlight_dpms_cycles_test(struct kunit *test)
 {
 	struct dcp_backlight_state state;
@@ -856,6 +915,7 @@ static struct kunit_case backlight_cases[] = {
 	KUNIT_CASE(backlight_millinits_takeover_test),
 	KUNIT_CASE(backlight_takeover_test),
 	KUNIT_CASE(backlight_range_test),
+	KUNIT_CASE(backlight_floor_test),
 	KUNIT_CASE(backlight_dpms_cycles_test),
 	KUNIT_CASE(backlight_blanked_target_test),
 	KUNIT_CASE(backlight_suspend_test),
