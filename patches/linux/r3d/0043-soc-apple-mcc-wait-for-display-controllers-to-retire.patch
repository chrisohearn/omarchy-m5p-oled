+{
+	of_node_put(it->node);
+	it->node = NULL;
+	if (it->i >= it->parent->nboot) {
+		*err = -ENOENT;
+		return false;
+	}
+	it->phandle = it->parent->boot[it->i++];
+	it->node = it->phandle ? by_phandle(it->phandle) : NULL;
+	return true;
