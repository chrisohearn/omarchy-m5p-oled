sound/0004-ASoC-apple-macaudio-Add-K114-with-the-speakers-off.patch
# r3b/0005, re-cut: the base now qualifies the K116s and the J714s; this adds only the K114s
r3c/0001-PCI-apple-qualify-the-K114s-for-suspend-to-idle-over.patch
brightness/0001-drm-apple-answer-the-PMU-temperature-for-every-panel.patch
# brightness/0002, re-cut: dcp.c gained link_report_rtkit_ops between rtkit_ops and the helper
r3c/0002-drm-apple-apply-the-syslog-debug-filter-to-the-inter.patch
brightness/0003-drm-apple-take-the-27.2-D590-notification-as-a-no-op.patch
brightness/0005-dt-bindings-display-apple-dcp-optional-panel-brightn.patch
# brightness/0006, re-cut: only the dcp_set_brightness() hunk moved (the base passes a local 'suspended')
r3c/0003-drm-apple-hold-brightness-requests-at-the-panel-s-fl.patch
hdr/0001-drm-apple-describe-an-internal-panel-without-a-known.patch
hdr/0002-drm-apple-cap-the-panel-peak-a-firmware-27-panel-s-E.patch
hdr/0003-drm-apple-K114s-no-panel-EDR-above-500-nits-by-defau.patch
sleep-lid/0007-power-supply-macsmc-skip-an-unreadable-manufacture-d.patch
hdr/0004-drm-apple-no-EDR-when-a-cap-is-set-and-the-SDR-maxim.patch
sep/0001-soc-apple-sep-Admit-the-K114s-to-the-T6050-profile.patch
# 2. new in r3c
#    the light sensor's 193-byte calibration: aurora-silicon/linux #1983 (Joshua Warren, open), cherry-picked from 242ce586c5
r3c/0004-soc-apple-aop-Send-the-14-inch-M5-Max-sensor-its-193.patch
#    NVRAM writes on T6050 (rolotrealanis98/m5pro-linux contrib/pending/nvram 0002 and 0003, Rolando Trevino; GPL-2.0-only)
r3c/0005-spi-apple-qspi-admit-verified-NVRAM-writes-on-the-J7.patch
r3c/0006-spi-apple-qspi-log-the-flash-ID-and-status-when-a-wr.patch
#    ours: the K114s row, fail-closed until its flash ID is confirmed
r3c/0007-spi-apple-qspi-admit-the-K114s-NVRAM-fail-closed-on-.patch
