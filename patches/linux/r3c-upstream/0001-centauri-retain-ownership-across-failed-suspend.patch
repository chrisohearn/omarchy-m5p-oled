+static bool centauri_t6050_ipc_fenced(struct centauri_t6050_ipc *ipc)
+{ assert(original->dev.locked); if(ipc) ipc->fenced=true; return true; }
+static void centauri_t6050_release_ipc(struct centauri_t6050_ipc *ipc)
