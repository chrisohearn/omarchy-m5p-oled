From ddf66b41341c53908cfdeda277875e5b00f152fc Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:07:13 -0600
Subject: [PATCH] Qualify K114c sense on the v2 path

Read the applied sense PCM geometry before taking the silent check grant, and confirm the v2 host clock follows the first callback rather than a requested period. Keep the own-Mac tuning and LSID qualification gates intact.

Proof: the mismatch test fails before the applied-params check, then passes. Packaging suites ran 254 tests with one skip; cargo fmt and git diff --check pass.
---
 crates/sgv2-lv2/tests/sense_bind.rs       | 15 +++++++----
 docs/NEW-PLATFORM.md                      | 10 +++++++
 packaging/session/speakerguardd-selfcheck | 25 ++++++++++++++---
 packaging/session/test_wiring.py          | 33 +++++++++++++++++++++++
 4 files changed, 74 insertions(+), 9 deletions(-)

diff --git a/crates/sgv2-lv2/tests/sense_bind.rs b/crates/sgv2-lv2/tests/sense_bind.rs
index 73531af9..0f681faf 100644
--- a/crates/sgv2-lv2/tests/sense_bind.rs
+++ b/crates/sgv2-lv2/tests/sense_bind.rs
@@ -196,10 +196,10 @@ fn run_follows_the_supervisor_word_through_the_c_abi() {
     std::env::set_var("SGV2_ENGINE_PAGE", &page_path);
     let index = VARIANTS.iter().position(|v| v.1 == 6 && v.2 == 12 && v.3 == Role::Protect).unwrap();
     let d = lv2_descriptor(index as u32);
-    const N: usize = 512;
-    let sense = resistive_sense(N);
-    let mut input = [[0.25f32; N]; 6];
-    let mut output = [[9.0f32; N]; 6];
+    const FIRST: usize = 2730;
+    let sense = resistive_sense(FIRST);
+    let mut input = [[0.25f32; FIRST]; 6];
+    let mut output = [[9.0f32; FIRST]; 6];
     let mut controls = [0.0f32; 3];
     let h = page.header();
     unsafe {
@@ -218,11 +218,16 @@ fn run_follows_the_supervisor_word_through_the_c_abi() {
         ((*d).activate.unwrap())(inst);
         let crc = h.params_crc.load(Ordering::Relaxed);
         assert_ne!(crc, 0);
+        // Count the first callback's actual frames, not the scratch capacity.
+        ((*d).run)(inst, FIRST as u32);
+        assert_eq!(h.frames.load(Ordering::Acquire), FIRST as u64);
+        assert_eq!(h.sense_bound.load(Ordering::Acquire), SENSE_UNBOUND);
         let run = || {
-            ((*d).run)(inst, N as u32);
+            ((*d).run)(inst, 512);
             h.sense_bound.load(Ordering::Acquire)
         };
         assert_eq!(run(), SENSE_UNBOUND, "no word, no binding");
+        assert_eq!(h.frames.load(Ordering::Acquire), (FIRST + 512) as u64);
         page.set_sense_bind(Some(crc ^ 1));
         assert_eq!(run(), SENSE_UNBOUND, "a word for another blob");
         page.set_sense_bind(Some(crc));
