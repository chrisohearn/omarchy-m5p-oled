+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Run apple-mcc's boot DMA supplier walk against mock device tree nodes."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
