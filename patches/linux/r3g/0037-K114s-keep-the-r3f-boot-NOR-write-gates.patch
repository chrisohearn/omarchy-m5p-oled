From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: verify <verify@localhost>
Date: Thu, 26 Nov 2026 14:19:44 -0700
Subject: [PATCH 37/37] K114s: keep the r3f boot NOR write gates

Leave the packaged K114s DT without the QSPI NVRAM partition added by 59c72f163caa. Reverse 0cb67690b3f5 in this candidate so the write policy still rejects the GD25UF64E even when the configured Stage 2 describes an NVRAM partition. The QSPI driver retains its read-only default.
---
 arch/arm64/boot/dts/apple/t6050-k114s.dts | 40 +----------------------
 drivers/spi/spi-apple-qspi-policy-test.c  | 15 +++------
 drivers/spi/spi-apple-qspi-policy.h       | 19 +++++------
 tools/asahi/qspi-nvram-tests.py           | 29 +++-------------
 4 files changed, 17 insertions(+), 86 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6050-k114s.dts b/arch/arm64/boot/dts/apple/t6050-k114s.dts
index 06bb125e2a9a..55ff915371ec 100644
--- a/arch/arm64/boot/dts/apple/t6050-k114s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-k114s.dts
@@ -4,8 +4,7 @@
  *
  * target-type: K114s (Mac17,13)
  *
- * Preliminary: described from the ADT. Only the NVRAM partition below has been run on a K114s,
- * from the boot loader's tree; this file as a whole has not been booted.
+ * Preliminary: described from the ADT only, not yet booted on the hardware.
  *
  * Copyright The Asahi Linux Contributors
  */
@@ -37,42 +36,5 @@ &mtp_multitouch {
 /* The camera. The loader sets the platform ID from the ADT isp0 sensor-type (0xba). */
 #include "t6050-isp.dtsi"
 
-/ {
-	aliases {
-		/* asahi-bless and the boot loader find the NVRAM partition by this alias */
-		nvram = &nvram;
-	};
-};
-
-/*
- * The boot NOR's NVRAM partition (ADT /arm-io/qspi/spinor/anvram: reg 0x700000, 0xc0000, 12
- * banks of 64 KiB). Only this partition is described, so the rest of the NOR has no device
- * node. Single-wire, as on the J775D: spi-nor then sends no quad-enable status write at probe.
- * The partition is read-only, as on the K114c.
- */
-&qspi {
-	status = "okay";
-
-	flash@0 {
-		compatible = "jedec,spi-nor";
-		reg = <0>;
-		spi-max-frequency = <25000000>;
-		spi-rx-bus-width = <1>;
-		spi-tx-bus-width = <1>;
-
-		partitions {
-			compatible = "fixed-partitions";
-			#address-cells = <1>;
-			#size-cells = <1>;
-
-			nvram: partition@700000 {
-				label = "nvram";
-				reg = <0x700000 0xc0000>;
-				read-only;
-			};
-		};
-	};
-};
-
 /* The GPU in the M5 Pro layout */
 #include "t6050-gpu-g17s.dtsi"
