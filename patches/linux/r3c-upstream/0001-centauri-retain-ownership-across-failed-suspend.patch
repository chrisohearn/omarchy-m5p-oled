+	int ret;
+
+	if (IS_ENABLED(CONFIG_ARCH_HAS_TEARDOWN_DMA_OPS))
+		return -EOPNOTSUPP;
+	if (PCI_FUNC(fn->devfn) != 2 || !ops || !ops->quiesce ||
+	    !ops->release || !ops->retained || !arena || !size)
+		return -EINVAL;
+	rw = centauri_t6050_owner_get(fn);
+	if (IS_ERR(rw))
