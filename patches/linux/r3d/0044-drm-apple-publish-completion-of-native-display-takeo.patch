 					      unsigned int engine, u32 id,
-					      u32 *watermark)
+					      bool shown_now, u32 *watermark,
+					      bool *shown)
 {
 	u32 done;
 
@@ -33,6 +38,10 @@ static inline bool dcp_peer_frame_complete_v27(struct dcp_peer_frames_v27 *s,
 		return false;
 	s->engine[engine] = id;
 	s->have[engine] = true;
+	if (shown_now) {
+		s->shown[engine] = id;
+		s->have_shown[engine] = true;
+	}
 	if (!s->have[0] || !s->have[1])
 		return false;
 	done = (s32)(s->engine[0] - s->engine[1]) < 0 ? s->engine[0] : s->engine[1];
@@ -40,6 +49,8 @@ static inline bool dcp_peer_frame_complete_v27(struct dcp_peer_frames_v27 *s,
 		return false;
 	s->retired = *watermark = done;
 	s->have_retired = true;
+	*shown = s->have_shown[0] && s->shown[0] == done &&
+		 s->have_shown[1] && s->shown[1] == done;
 	return true;
 }
 #endif
