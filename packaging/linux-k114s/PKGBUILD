# Maintainer: none (K114s r3a/r3b candidates; built from a finished kernel tree, see docs/r3-integration.md, docs/r3b-kernel.md)
#
# linux-k114s: the K114s r3a or r3b kernel as its own package, beside linux-aurora and not replacing it.
#
# Everything lands in /usr/lib/modules/<release>/ and the release string (7.3.0-17.v272-4-k114s-r3a-ARCH, or
# 7.3.0-17.v272-11-k114s-r3b-ARCH) differs from linux-aurora's (7.3.0-17.v272-4-ARCH today), so no file is shared and the
# running kernel's module directory stays package-owned (linux-modules-cleanup.service leaves it alone).
# The layout is Arch's: vmlinuz (the raw arm64 Image), pkgbase, modules.*, kernel/, dtbs/ (flat).
# The system's hooks do the rest: pkgbase names the mkinitcpio preset, and the Limine hook builds
# omarchy_<pkgbase>.efi for it.
#
# Package names: r3a is linux-k114s (the installed default). r3b is linux-k114s-r3b, so pacman installs it
# beside r3a instead of replacing it: its own pkgbase file (preset, UKI omarchy_linux-k114s-r3b.efi, Limine
# entry Omarchy/linux-k114s-r3b) and its config under /usr/share/linux-k114s-r3b/ (docs/r3-display-plan.md
# section 3.1). The two share no file.
#
# r3b-b1 (docs/r3-display-plan.md, D5a) is r3b plus the brightness series (patches/linux/r3b-b1.series): the same
# package name and kernel release as r3b, version 7.3.0.r3b.b1-1, so pacman upgrades the D1 package in place and the
# hook rebuilds omarchy_linux-k114s-r3b.efi in place. It adds no package, preset, entry or UKI: the ESP holds the r3a
# and r3b images in the display window and has no room for a third kernel image (section 3.1, G2).
#
# r3b-c1 (docs/r3-hdr.md, issue #92) is r3b-b1 plus the HDR series (patches/linux/r3b-c1.series): the same package name
# and release again, version 7.3.0.r3b.c1-1, so it upgrades r3b.b1 in place the same way.
#
# r3b-c2 (docs/r3b-kernel.md "r3b.c2", aurora-silicon/linux#1615) is r3b-c1 plus sleep-lid/0007, the battery
# manufacture-date fix (patches/linux/r3b-c2.series): version 7.3.0.r3b.c2-1, upgrading r3b.c1 in place.
#
# This file does not compile anything. It packages a finished build:
#   K114S_CAND  the candidate, r3a, r3b, r3b-b1, r3b-c1 or r3b-c2   (default r3a, the one the runbook docs/r3-integration.md names;
#               r3b: docs/r3b-kernel.md, K114S_CAND=r3b makepkg ...; r3b-b1: D5a, K114S_CAND=r3b-b1 makepkg ...;
#               r3b-c1: docs/r3-hdr.md, K114S_CAND=r3b-c1 makepkg ...; r3b-c2: docs/r3b-kernel.md,
#               K114S_CAND=r3b-c2 makepkg ...)
#   K114S_SRC   the kernel source tree      (default $K114S_BUILD_ROOT/src/<candidate>)
#   K114S_OUT   its output directory        (default $K114S_BUILD_ROOT/build/<candidate>)
# with the toolchain of $K114S_BUILD_ROOT (default ~/k114s-build; env.sh and bin/kmake there).
#   source ~/k114s-build/env.sh; cd packaging/linux-k114s
#   BUILDDIR=... PKGDEST=... makepkg -f --nodeps --skipinteg      (no root; takes about a minute)

_cand=${K114S_CAND:-r3a}
# _kcand: the candidate named in the kernel release (...-k114s-<_kcand>-ARCH); _ver: the version after 7.3.0.
case $_cand in
  r3a) pkgname=linux-k114s; _kcand=r3a; _ver=r3a; _rel=2 ;;
  r3b) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b; _rel=1 ;;
  r3b-b1) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b.b1; _rel=1 ;;   # vercmp: 7.3.0.r3b.b1-1 is newer than 7.3.0.r3b-1
  r3b-c1) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b.c1; _rel=1 ;;   # vercmp: 7.3.0.r3b.c1-1 is newer than 7.3.0.r3b.b1-1
  r3b-c2) pkgname=linux-k114s-r3b; _kcand=r3b; _ver=r3b.c2; _rel=1 ;;   # vercmp: 7.3.0.r3b.c2-1 is newer than 7.3.0.r3b.c1-1
  *) echo "K114S_CAND must be r3a, r3b, r3b-b1, r3b-c1 or r3b-c2" >&2; exit 1 ;;
esac
pkgbase=$pkgname
pkgver=7.3.0.$_ver
pkgrel=$_rel
pkgdesc="K114s (MacBook Pro 14-inch, M5 Pro) kernel candidate $_ver and its modules; installs beside linux-aurora and the other K114s kernel"
arch=('aarch64')
url='https://github.com/chrisohearn/omarchy-m5p-oled'
license=('GPL-2.0-only')
depends=('coreutils' 'kmod' 'initramfs')
options=('!strip' '!debug' '!lto' '!emptydirs')
# no source=(): the kernel tree and its output directory are named by the environment
_root=${K114S_BUILD_ROOT:-$HOME/k114s-build}
_src=${K114S_SRC:-$_root/src/$_cand}
_out=${K114S_OUT:-$_root/build/$_cand}

package() {
  local kernel_release modpath
  kernel_release=$(<"$_out/include/config/kernel.release")
  case $kernel_release in
    *-ARCH) ;;
    *) echo "release '$kernel_release' does not end in -ARCH (boot bundle discovery needs it)" >&2; return 1 ;;
  esac
  [[ $kernel_release != 7.3.0-17.v272-4-ARCH ]] || { echo "release equals linux-aurora's" >&2; return 1; }
  [[ $_kcand != r3b || $kernel_release != 7.3.0-17.v272-4-k114s-r3a-ARCH ]] || { echo "r3b release equals r3a's" >&2; return 1; }
  [[ $kernel_release == *-k114s-${_kcand}-ARCH ]] || { echo "release '$kernel_release' is not a $_kcand release (missing the k114s release suffix?)" >&2; return 1; }
  # r3b-b1 must be built from a tree with the brightness floor (patches/linux/brightness 0006), never from plain r3b
  if [[ $_cand == r3b-b1 || $_cand == r3b-c1 || $_cand == r3b-c2 ]]; then
    grep -q 'dcp_bl_set_minimum' "$_src/drivers/gpu/drm/apple/dcp_backlight.h" ||
      { echo "$_src has no brightness series (patches/linux/r3b-b1.series)" >&2; return 1; }
  fi
  # r3b-c1 and r3b-c2 must carry the HDR series (patches/linux/r3b-c1.series) with the K114s 500-nit EDR cap
  if [[ $_cand == r3b-c1 || $_cand == r3b-c2 ]]; then
    grep -q 'fw27_panel_edr_max_nits = 500;' "$_src/drivers/gpu/drm/apple/dcp.c" &&
      grep -q 'dcp_panel_color_target' "$_src/drivers/gpu/drm/apple/dcp-display-metadata.c" ||
      { echo "$_src has no HDR series with the 500-nit cap (patches/linux/r3b-c1.series)" >&2; return 1; }
  fi
  # r3b-c2 must carry sleep-lid/0007: an unreadable manufacture date is -ENODATA, not -EOPNOTSUPP (aurora-silicon/linux#1615)
  if [[ $_cand == r3b-c2 ]]; then
    grep -A3 '^static int macsmc_battery_get_date' "$_src/drivers/power/supply/macsmc-power.c" | grep -q 'return -ENODATA;' ||
      { echo "$_src has no battery manufacture-date fix (patches/linux/r3b-c2.series, sleep-lid/0007)" >&2; return 1; }
  fi
  modpath="$pkgdir/usr/lib/modules/$kernel_release"

  # vmlinuz: the uncompressed Image, as linux-aurora ships it
  install -Dm644 "$_out/arch/arm64/boot/Image" "$modpath/vmlinuz"

  # modules, stripped of debug info; kbuild runs depmod for the new tree
  ( cd "$_src" && "$_root/bin/kmake" O="$_out" INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
      DEPMOD=/usr/bin/depmod modules_install )
  # the build and source links point into the build area
  rm -f "$modpath/build" "$modpath/source"

  # device trees, flat, and exactly the 46 that linux-aurora ships (dtbs.list): update-m1n1 puts every
  # dtbs/*.dtb of the newest -ARCH directory into m1n1/boot.bin, so the set must not grow.
  # t6050-k114s.dtb here is the kernel tree's own; the Stage 2 (boot-ctxr.bin) carries the pinned
  # tree built from dts/, not this file.
  install -dm755 "$modpath/dtbs"
  while read -r dtb; do
    install -m644 "$_out/arch/arm64/boot/dts/apple/$dtb" "$modpath/dtbs/$dtb"
  done < "$startdir/dtbs.list"

  # names the mkinitcpio preset and the Limine entry (the UKI becomes omarchy_<pkgbase>.efi)
  echo "$pkgbase" | install -Dm644 /dev/stdin "$modpath/pkgbase"

  # the file the kernel and modules were built from, for the record
  install -Dm644 "$_out/.config" "$pkgdir/usr/share/$pkgname/config-$kernel_release"
}
