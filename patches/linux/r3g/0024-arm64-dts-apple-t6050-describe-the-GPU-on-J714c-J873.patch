index 2909e86fc426..7a72548b1b4e 100644
--- a/arch/arm64/boot/dts/apple/t6050-j714c.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j714c.dts
@@ -16,6 +16,8 @@
 
 #define T6050_J714C
 #include <dt-bindings/leds/common.h>
+/* The GPU in the M5 Max layout (t6050-gpu-g17c.dtsi), under its own bus */
+#define T6050_GPU_BUS
 #include "t6050-max.dtsi"
 
 / {
@@ -325,6 +327,7 @@ stm {
 };
 
 #include "t6050-peripherals.dtsi"
+#include "t6050-gpu-g17c.dtsi"
 
 /*
  * The PMP (ADT pmp0, /chosen, /arm-io/pmgr), as on the J714s. iBoot loads its firmware and the
@@ -373,7 +376,7 @@ &pmc {
 	apple,pmp = <&pmp0>;
 };
 
-&sgx {
+&gpu {
 	power-domains = <&pmp0_gfx>;
 };
 
