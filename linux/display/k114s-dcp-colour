#!/bin/bash
# Add (or remove) the DCP colour-management fix in the user's Hyprland monitors.lua. User session only: no sudo, no reload by this script.
#   usage: k114s-dcp-colour [--install | --undo | --check]       (default --install)
#   K114S_HYPR_DIR overrides ~/.config/hypr (the tests use it).
# The snippet (dcp-colour.lua beside this script) is appended between two marker lines. Install is idempotent, keeps the file as it
# was before the first install in monitors.lua.k114s-dcp-colour.bak, and replaces a changed block. The snippet does nothing unless
# ASAHI_M5_BRINGUP=1, which the generator sets only on a boot with the DCP card. Hyprland may reload the file by itself when it changes
# (misc:disable_autoreload is off by default); it is certain to apply at the next start. --undo removes only the marked block: lines
# written by hand in the same file (an earlier manual fix) stay, so replace those with --install rather than adding to them.
set -u
here=$(cd "$(dirname "$0")" && pwd); snip=$here/dcp-colour.lua
f=${K114S_HYPR_DIR:-$HOME/.config/hypr}/monitors.lua
# a dotfile manager may link monitors.lua: edit the file it points at, so the link stays a link (#158)
[ -L "$f" ] && { f=$(readlink -f -- "$f") || exit 1; }
bak=$f.k114s-dcp-colour.bak
B='-- k114s-dcp-colour begin'; E='-- k114s-dcp-colour end'
die() { echo "k114s-dcp-colour: $*" >&2; exit 1; }
[ -s "$snip" ] || die "no $snip"
[ -f "$f" ] || die "no $f (Omarchy's monitors.lua)"
block() { awk -v b="$B" -v e="$E" 'index($0, b) == 1 { p = 1 } p { print } p && index($0, e) == 1 { p = 0 }' "$1"; }
strip() { awk -v b="$B" -v e="$E" 'index($0, b) == 1 { p = 1 } !p { print } p && index($0, e) == 1 { p = 0 }' "$1"; }
installed() { [ -n "$(block "$f")" ] && [ "$(block "$f")" = "$(cat "$snip")" ]; }
# zero or one complete block, begin before end; anything else (a half-deleted block) is left alone (#158)
balanced() {
  awk -v b="$B" -v e="$E" 'index($0, b) == 1 { if (p) bad = 1; p = 1; n++ } index($0, e) == 1 { if (!p) bad = 1; p = 0 }
    END { exit (bad || p || n > 1) }' "$1"
}
put() { t=$(mktemp "$f.XXXXXX") || exit 1; cat > "$t" && chmod --reference="$f" "$t" && mv "$t" "$f" || { rm -f "$t"; die "cannot write $f"; }; }
case ${1:---install} in --check | --install | --undo) balanced "$f" ||
  die "$f has an unmatched or repeated '$B' / '$E' line: fix it by hand (nothing was changed)" ;; esac
case ${1:---install} in
  --check) installed && echo "k114s-dcp-colour: installed in $f" || die "not installed in $f" ;;
  --install)
    installed && { echo "k114s-dcp-colour: already installed"; exit 0; }
    [ -e "$bak" ] || cp -p "$f" "$bak" || die "cannot keep a backup"
    { strip "$f"; cat "$snip"; } | put; installed || die "the block is not in $f after the write"
    echo "k114s-dcp-colour: installed in $f (backup $bak); Hyprland may reload it by itself; it applies at its next start" ;;
  --undo)
    [ -n "$(block "$f")" ] || { echo "k114s-dcp-colour: not installed"; exit 0; }
    strip "$f" | put; [ -z "$(block "$f")" ] || die "the block is still in $f"
    echo "k114s-dcp-colour: removed from $f (the first-install backup $bak stays)" ;;
  *) die "usage: k114s-dcp-colour [--install | --undo | --check]" ;;
esac
