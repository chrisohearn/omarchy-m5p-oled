From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Axboe <axboe@kernel.dk>
Date: Thu, 19 Nov 2026 08:12:11 -0700
Subject: [PATCH 59/93] dt-bindings: mfd: apple,smc: add the wake reasons'
 numbering

The bits of the SMC's wake record are numbered per board: the ADT's
smc-pmu node gives each a name (event_name-bitN). Let the device tree
carry the bits and their names.

Signed-off-by: Jens Axboe <axboe@kernel.dk>

[re-cut onto the K114s r3d tree]
---
 .../devicetree/bindings/mfd/apple,smc.yaml       | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/Documentation/devicetree/bindings/mfd/apple,smc.yaml b/Documentation/devicetree/bindings/mfd/apple,smc.yaml
index c35e7d0e10f..34416179acf 100644
--- a/Documentation/devicetree/bindings/mfd/apple,smc.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,smc.yaml
@@ -68,6 +68,22 @@ properties:
   hwmon:
     $ref: /schemas/hwmon/apple,smc-hwmon.yaml
 
+  apple,wake-reasons:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 1
+    maxItems: 64
+    items:
+      maximum: 63
+    description: |
+      The bits of the SMC's wake record that have a name on this board, as the
+      ADT's smc-pmu node numbers them (event_name-bitN).
+
+  apple,wake-reason-names:
+    $ref: /schemas/types.yaml#/definitions/string-array
+    minItems: 1
+    maxItems: 64
+    description: The names of the bits in apple,wake-reasons, in the same order.
+
 additionalProperties: false
 
 required:
